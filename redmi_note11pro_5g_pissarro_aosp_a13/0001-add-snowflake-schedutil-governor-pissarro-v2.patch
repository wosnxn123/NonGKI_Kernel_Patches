diff --git a/kernel/sched/cpufreq_snowflake.c b/kernel/sched/cpufreq_snowflake.c
new file mode 100644
index 000000000000..111111111111
--- /dev/null
+++ b/kernel/sched/cpufreq_snowflake.c
@@ -0,0 +1,1080 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Snowflake CPUFreq governor for Android 4.14 / MTK non-GKI kernels.
+ *
+ * Snowflake is a schedutil-class governor: it is driven by the scheduler's
+ * cpufreq_update_util() hooks, keeps WALT/uclamp/iowait boost behaviour, and
+ * preserves the MTK SSPM frequency path used by this Pissarro/MT6877 tree.
+ *
+ * Default intent: quick ramp for frames, slower decay for stability, and small
+ * conservative boosts instead of forcing max clocks.
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/irq_work.h>
+#include <linux/kernel.h>
+#include <linux/kthread.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/sched/cpufreq.h>
+#include <uapi/linux/sched/types.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <trace/events/power.h>
+#include <trace/events/sched.h>
+
+#include "sched.h"
+#include "tune.h"
+#include "cpufreq_schedutil.h"
+
+#define SNOWFLAKE_KTHREAD_PRIORITY      50
+#define SNOWFLAKE_DEFAULT_UP_RATE_US    500
+#define SNOWFLAKE_DEFAULT_DOWN_RATE_US  16000
+#define SNOWFLAKE_DEFAULT_TARGET_LOAD   80
+#define SNOWFLAKE_DEFAULT_HISPEED_LOAD  90
+#define SNOWFLAKE_DEFAULT_HISPEED_FREQ  0
+#define SNOWFLAKE_DEFAULT_BOOST_PCT     2
+
+static struct cpufreq_governor snowflake_gov;
+
+/* Same scheduler-private provider used by schedutil in this tree. */
+unsigned long boosted_cpu_util(int cpu);
+
+struct snowflake_tunables {
+	struct gov_attr_set attr_set;
+	unsigned int up_rate_limit_us;
+	unsigned int down_rate_limit_us;
+	unsigned int target_load;
+	unsigned int hispeed_load;
+	unsigned int hispeed_freq;
+	unsigned int boost_pct;
+	unsigned int iowait_boost_enable;
+	unsigned int busy_hold_enable;
+	unsigned int rt_dl_boost_enable;
+};
+
+struct snowflake_policy {
+	struct cpufreq_policy *policy;
+	struct snowflake_tunables *tunables;
+	struct list_head tunables_hook;
+	raw_spinlock_t update_lock;
+
+	u64 last_freq_update_time;
+	s64 min_rate_limit_ns;
+	s64 up_rate_delay_ns;
+	s64 down_rate_delay_ns;
+	unsigned int next_freq;
+	unsigned int cached_raw_freq;
+
+	struct irq_work irq_work;
+	struct kthread_work work;
+	struct mutex work_lock;
+	struct kthread_worker worker;
+	struct task_struct *thread;
+	bool work_in_progress;
+	bool need_freq_update;
+};
+
+struct snowflake_cpu {
+	struct update_util_data update_util;
+	struct snowflake_policy *sf_policy;
+	unsigned int cpu;
+
+	bool iowait_boost_pending;
+	unsigned int iowait_boost;
+	unsigned int iowait_boost_max;
+	u64 last_update;
+
+	unsigned long util;
+	unsigned long max;
+	unsigned int flags;
+	unsigned long min_boost;
+
+#ifdef CONFIG_NO_HZ_COMMON
+	unsigned long saved_idle_calls;
+#endif
+};
+
+static DEFINE_PER_CPU(struct snowflake_cpu, snowflake_cpu);
+
+static struct snowflake_tunables *global_tunables;
+static DEFINE_MUTEX(global_tunables_lock);
+static DEFINE_MUTEX(min_rate_lock);
+
+static inline struct snowflake_tunables *
+to_snowflake_tunables(struct gov_attr_set *attr_set)
+{
+	return container_of(attr_set, struct snowflake_tunables, attr_set);
+}
+
+static unsigned int snowflake_clamp_pct(unsigned int val,
+					unsigned int min, unsigned int max)
+{
+	if (val < min)
+		return min;
+	if (val > max)
+		return max;
+	return val;
+}
+
+static void update_min_rate_limit_ns(struct snowflake_policy *sf_policy)
+{
+	mutex_lock(&min_rate_lock);
+	sf_policy->min_rate_limit_ns = min(sf_policy->up_rate_delay_ns,
+					     sf_policy->down_rate_delay_ns);
+	mutex_unlock(&min_rate_lock);
+}
+
+static void snowflake_sync_rate_limits(struct snowflake_policy *sf_policy)
+{
+	struct snowflake_tunables *tunables = sf_policy->tunables;
+
+	sf_policy->up_rate_delay_ns = (s64)tunables->up_rate_limit_us *
+					NSEC_PER_USEC;
+	sf_policy->down_rate_delay_ns = (s64)tunables->down_rate_limit_us *
+					  NSEC_PER_USEC;
+	update_min_rate_limit_ns(sf_policy);
+}
+
+static int snowflake_parse_uint(const char *buf, unsigned int min,
+				unsigned int max, unsigned int *out)
+{
+	unsigned int value;
+
+	if (kstrtouint(buf, 10, &value))
+		return -EINVAL;
+
+	*out = clamp_val(value, min, max);
+	return 0;
+}
+
+static void snowflake_mark_need_update(struct gov_attr_set *attr_set)
+{
+	struct snowflake_policy *sf_policy;
+
+	list_for_each_entry(sf_policy, &attr_set->policy_list, tunables_hook)
+		sf_policy->need_freq_update = true;
+}
+
+static void snowflake_update_rate_limits(struct gov_attr_set *attr_set)
+{
+	struct snowflake_policy *sf_policy;
+
+	list_for_each_entry(sf_policy, &attr_set->policy_list, tunables_hook) {
+		snowflake_sync_rate_limits(sf_policy);
+		sf_policy->need_freq_update = true;
+	}
+}
+
+static bool snowflake_should_update_freq(struct snowflake_policy *sf_policy,
+					 u64 time)
+{
+	s64 delta_ns;
+	struct cpufreq_policy *policy = sf_policy->policy;
+
+	if (policy->governor != &snowflake_gov || !policy->governor_data)
+		return false;
+
+	if (policy->fast_switch_enabled && !cpufreq_can_do_remote_dvfs(policy))
+		return false;
+
+	if (sf_policy->work_in_progress)
+		return false;
+
+	if (unlikely(sf_policy->need_freq_update)) {
+		sf_policy->need_freq_update = false;
+		sf_policy->next_freq = UINT_MAX;
+		return true;
+	}
+
+	delta_ns = time - sf_policy->last_freq_update_time;
+	return delta_ns >= sf_policy->min_rate_limit_ns;
+}
+
+static bool snowflake_up_down_rate_limit(struct snowflake_policy *sf_policy,
+					 u64 time, unsigned int next_freq)
+{
+	s64 delta_ns = time - sf_policy->last_freq_update_time;
+
+	if (next_freq > sf_policy->next_freq &&
+	    delta_ns < sf_policy->up_rate_delay_ns)
+		return true;
+
+	if (next_freq < sf_policy->next_freq &&
+	    delta_ns < sf_policy->down_rate_delay_ns)
+		return true;
+
+	return false;
+}
+
+static unsigned int snowflake_auto_hispeed(struct snowflake_policy *sf_policy)
+{
+	struct cpufreq_policy *policy = sf_policy->policy;
+	struct snowflake_tunables *tunables = sf_policy->tunables;
+	unsigned int freq;
+
+	if (tunables->hispeed_freq)
+		freq = tunables->hispeed_freq;
+	else
+		freq = policy->min + div_u64((u64)(policy->max - policy->min) * 55,
+					 100);
+
+	return clamp_val(freq, policy->min, policy->max);
+}
+
+static unsigned int snowflake_get_next_freq(struct snowflake_policy *sf_policy,
+					    unsigned long util, unsigned long max)
+{
+	struct cpufreq_policy *policy = sf_policy->policy;
+	struct snowflake_tunables *tunables = sf_policy->tunables;
+	unsigned int base_freq, target_load, hispeed_load, boost_pct;
+	u64 freq;
+
+	if (!max)
+		max = 1;
+
+	boost_pct = snowflake_clamp_pct(tunables->boost_pct, 0, 30);
+	if (boost_pct) {
+		util += div_u64((u64)max * boost_pct, 100);
+		util = min_t(unsigned long, util, max);
+	}
+
+	base_freq = arch_scale_freq_invariant() ? policy->cpuinfo.max_freq :
+					       policy->cur;
+	if (!base_freq)
+		base_freq = policy->cpuinfo.max_freq;
+
+	target_load = snowflake_clamp_pct(tunables->target_load, 50, 99);
+	freq = (u64)base_freq * util * 100;
+	freq = div_u64(freq, (unsigned int)max * target_load);
+
+	hispeed_load = snowflake_clamp_pct(tunables->hispeed_load, 1, 100);
+	if ((u64)util * 100 >= (u64)max * hispeed_load)
+		freq = max_t(u64, freq, snowflake_auto_hispeed(sf_policy));
+
+	freq = clamp_t(u64, freq, policy->min, policy->max);
+	sf_policy->cached_raw_freq = (unsigned int)freq;
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	return (unsigned int)freq;
+#else
+	return cpufreq_driver_resolve_freq(policy, (unsigned int)freq);
+#endif
+}
+
+static void snowflake_update_commit(struct snowflake_policy *sf_policy,
+				    u64 time, unsigned int next_freq)
+{
+	struct cpufreq_policy *policy = sf_policy->policy;
+
+	if (sf_policy->next_freq == next_freq)
+		return;
+
+	if (snowflake_up_down_rate_limit(sf_policy, time, next_freq))
+		return;
+
+	sf_policy->next_freq = next_freq;
+	sf_policy->last_freq_update_time = time;
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	{
+		int cid = arch_get_cluster_id(policy->cpu);
+		unsigned int resolved;
+
+		resolved = clamp_val(next_freq, policy->min, policy->max);
+		resolved = mt_cpufreq_find_close_freq(cid, resolved);
+		if (!resolved)
+			resolved = clamp_val(next_freq, policy->min, policy->max);
+
+		mt_cpufreq_set_by_wfi_load_cluster(cid, resolved);
+		policy->cur = resolved;
+		trace_sched_util(cid, resolved, time);
+	}
+#else
+	if (policy->fast_switch_enabled) {
+		next_freq = cpufreq_driver_fast_switch(policy, next_freq);
+		if (!next_freq)
+			return;
+
+		policy->cur = next_freq;
+		trace_cpu_frequency(next_freq, smp_processor_id());
+	} else {
+		sf_policy->work_in_progress = true;
+		irq_work_queue(&sf_policy->irq_work);
+	}
+#endif
+}
+
+static void snowflake_get_util(unsigned long *util, unsigned long *max, int cpu)
+{
+	unsigned long max_cap;
+
+	max_cap = arch_scale_cpu_capacity(NULL, cpu);
+	*util = boosted_cpu_util(cpu);
+	if (idle_cpu(cpu))
+		*util = 0;
+
+	*util = min(*util, max_cap);
+	*max = max_cap;
+}
+
+static void snowflake_set_iowait_boost(struct snowflake_cpu *sf_cpu,
+				       u64 time, unsigned int flags)
+{
+	struct snowflake_tunables *tunables = sf_cpu->sf_policy->tunables;
+	unsigned int max_boost;
+
+	if (!tunables->iowait_boost_enable) {
+		sf_cpu->iowait_boost = 0;
+		sf_cpu->iowait_boost_pending = false;
+		return;
+	}
+
+	if (flags & SCHED_CPUFREQ_IOWAIT) {
+		if (sf_cpu->iowait_boost_pending)
+			return;
+
+		sf_cpu->iowait_boost_pending = true;
+		max_boost = sf_cpu->iowait_boost_max;
+		max_boost = uclamp_util(cpu_rq(sf_cpu->cpu), max_boost);
+
+		if (sf_cpu->iowait_boost) {
+			sf_cpu->iowait_boost <<= 1;
+			if (sf_cpu->iowait_boost > max_boost)
+				sf_cpu->iowait_boost = max_boost;
+		} else {
+			sf_cpu->iowait_boost = sf_cpu->min_boost;
+		}
+	} else if (sf_cpu->iowait_boost) {
+		s64 delta_ns = time - sf_cpu->last_update;
+
+		if (delta_ns > TICK_NSEC) {
+			sf_cpu->iowait_boost = 0;
+			sf_cpu->iowait_boost_pending = false;
+		}
+	}
+}
+
+static void snowflake_iowait_boost(struct snowflake_cpu *sf_cpu,
+				   unsigned long *util, unsigned long *max)
+{
+	struct snowflake_tunables *tunables = sf_cpu->sf_policy->tunables;
+	unsigned int boost_util, boost_max;
+
+	if (!tunables->iowait_boost_enable || !sf_cpu->iowait_boost)
+		return;
+
+	if (sf_cpu->iowait_boost_pending) {
+		sf_cpu->iowait_boost_pending = false;
+	} else {
+		sf_cpu->iowait_boost >>= 1;
+		if (sf_cpu->iowait_boost < sf_cpu->min_boost) {
+			sf_cpu->iowait_boost = 0;
+			return;
+		}
+	}
+
+	boost_util = sf_cpu->iowait_boost;
+	boost_max = sf_cpu->iowait_boost_max;
+	if (*util * boost_max < *max * boost_util) {
+		*util = boost_util;
+		*max = boost_max;
+	}
+}
+
+#ifdef CONFIG_NO_HZ_COMMON
+static bool snowflake_cpu_is_busy(struct snowflake_cpu *sf_cpu)
+{
+	unsigned long idle_calls = tick_nohz_get_idle_calls_cpu(sf_cpu->cpu);
+	bool ret = idle_calls == sf_cpu->saved_idle_calls;
+
+	sf_cpu->saved_idle_calls = idle_calls;
+	return ret;
+}
+#else
+static inline bool snowflake_cpu_is_busy(struct snowflake_cpu *sf_cpu)
+{
+	return false;
+}
+#endif
+
+static void snowflake_update_single(struct update_util_data *hook,
+				    u64 time, unsigned int flags)
+{
+	struct snowflake_cpu *sf_cpu = container_of(hook, struct snowflake_cpu,
+						     update_util);
+	struct snowflake_policy *sf_policy = sf_cpu->sf_policy;
+	struct snowflake_tunables *tunables = sf_policy->tunables;
+	struct cpufreq_policy *policy = sf_policy->policy;
+	unsigned long util, max;
+	unsigned int next_f;
+	bool busy;
+
+	snowflake_set_iowait_boost(sf_cpu, time, flags);
+	sf_cpu->last_update = time;
+
+	if (!snowflake_should_update_freq(sf_policy, time))
+		return;
+
+	busy = snowflake_cpu_is_busy(sf_cpu);
+
+	if (tunables->rt_dl_boost_enable && (flags & SCHED_CPUFREQ_DL)) {
+		next_f = policy->cpuinfo.max_freq;
+	} else {
+		snowflake_get_util(&util, &max, sf_cpu->cpu);
+		util = uclamp_util(cpu_rq(sf_cpu->cpu), util);
+		snowflake_iowait_boost(sf_cpu, &util, &max);
+		next_f = snowflake_get_next_freq(sf_policy, util, max);
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+		{
+			int cid = arch_get_cluster_id(policy->cpu);
+
+			next_f = clamp_val(next_f, policy->min, policy->max);
+			next_f = mt_cpufreq_find_close_freq(cid, next_f);
+			if (!next_f)
+				next_f = policy->min;
+		}
+#endif
+
+		if (tunables->busy_hold_enable && busy &&
+		    next_f < sf_policy->next_freq &&
+		    sf_policy->next_freq != UINT_MAX) {
+			next_f = sf_policy->next_freq;
+			sf_policy->cached_raw_freq = 0;
+		}
+	}
+
+	snowflake_update_commit(sf_policy, time, next_f);
+}
+
+static unsigned int snowflake_next_freq_shared(struct snowflake_cpu *sf_cpu,
+					       u64 time)
+{
+	struct snowflake_policy *sf_policy = sf_cpu->sf_policy;
+	struct snowflake_tunables *tunables = sf_policy->tunables;
+	struct cpufreq_policy *policy = sf_policy->policy;
+	unsigned long util = 0, max = 1;
+	unsigned int j;
+	unsigned int next_f;
+
+	for_each_cpu(j, policy->cpus) {
+		struct snowflake_cpu *j_sf_cpu = &per_cpu(snowflake_cpu, j);
+		unsigned long j_util, j_max;
+		s64 delta_ns;
+
+		delta_ns = time - j_sf_cpu->last_update;
+		if (delta_ns > TICK_NSEC) {
+			j_sf_cpu->iowait_boost = 0;
+			j_sf_cpu->iowait_boost_pending = false;
+			if (idle_cpu(j))
+				continue;
+		}
+
+		if (tunables->rt_dl_boost_enable &&
+		    (j_sf_cpu->flags & SCHED_CPUFREQ_DL))
+			return policy->cpuinfo.max_freq;
+
+		j_util = j_sf_cpu->util;
+		j_max = j_sf_cpu->max;
+
+#ifdef CONFIG_UCLAMP_TASK
+		trace_schedutil_uclamp_util(j, j_util);
+#endif
+		j_util = uclamp_util(cpu_rq(j), j_util);
+
+		if (j_util * max > j_max * util) {
+			util = j_util;
+			max = j_max;
+		}
+
+		snowflake_iowait_boost(j_sf_cpu, &util, &max);
+	}
+
+	next_f = snowflake_get_next_freq(sf_policy, util, max);
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	{
+		int cid = arch_get_cluster_id(policy->cpu);
+
+		next_f = clamp_val(next_f, policy->min, policy->max);
+		next_f = mt_cpufreq_find_close_freq(cid, next_f);
+		if (!next_f)
+			next_f = policy->min;
+	}
+#endif
+
+	return next_f;
+}
+
+static void snowflake_update_shared(struct update_util_data *hook,
+				    u64 time, unsigned int flags)
+{
+	struct snowflake_cpu *sf_cpu = container_of(hook, struct snowflake_cpu,
+						     update_util);
+	struct snowflake_policy *sf_policy = sf_cpu->sf_policy;
+	struct snowflake_tunables *tunables = sf_policy->tunables;
+	unsigned long util, max;
+	unsigned int next_f;
+
+	snowflake_get_util(&util, &max, sf_cpu->cpu);
+
+	raw_spin_lock(&sf_policy->update_lock);
+
+	sf_cpu->util = util;
+	sf_cpu->max = max;
+	sf_cpu->flags = flags;
+	snowflake_set_iowait_boost(sf_cpu, time, flags);
+	sf_cpu->last_update = time;
+
+	if (snowflake_should_update_freq(sf_policy, time)) {
+		if (tunables->rt_dl_boost_enable && (flags & SCHED_CPUFREQ_DL))
+			next_f = sf_policy->policy->cpuinfo.max_freq;
+		else
+			next_f = snowflake_next_freq_shared(sf_cpu, time);
+
+		snowflake_update_commit(sf_policy, time, next_f);
+	}
+
+	raw_spin_unlock(&sf_policy->update_lock);
+}
+
+static void snowflake_work(struct kthread_work *work)
+{
+	struct snowflake_policy *sf_policy = container_of(work,
+					struct snowflake_policy, work);
+
+	mutex_lock(&sf_policy->work_lock);
+	__cpufreq_driver_target(sf_policy->policy, sf_policy->next_freq,
+				 CPUFREQ_RELATION_L);
+	mutex_unlock(&sf_policy->work_lock);
+
+	sf_policy->work_in_progress = false;
+}
+
+static void snowflake_irq_work(struct irq_work *irq_work)
+{
+	struct snowflake_policy *sf_policy;
+
+	sf_policy = container_of(irq_work, struct snowflake_policy, irq_work);
+	kthread_queue_work(&sf_policy->worker, &sf_policy->work);
+}
