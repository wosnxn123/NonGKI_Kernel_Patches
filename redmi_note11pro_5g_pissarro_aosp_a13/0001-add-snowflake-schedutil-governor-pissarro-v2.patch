+static int snowflake_kthread_create(struct snowflake_policy *sf_policy)
+{
+	struct task_struct *thread;
+	struct sched_param param = {
+		.sched_priority = SNOWFLAKE_KTHREAD_PRIORITY,
+	};
+	struct cpufreq_policy *policy = sf_policy->policy;
+	int ret;
+
+	if (policy->fast_switch_enabled)
+		return 0;
+
+	kthread_init_work(&sf_policy->work, snowflake_work);
+	kthread_init_worker(&sf_policy->worker);
+	thread = kthread_create(kthread_worker_fn, &sf_policy->worker,
+				"snowflake:%d", cpumask_first(policy->related_cpus));
+	if (IS_ERR(thread)) {
+		pr_err("failed to create snowflake thread: %ld\n", PTR_ERR(thread));
+		return PTR_ERR(thread);
+	}
+
+	ret = sched_setscheduler_nocheck(thread, SCHED_FIFO, &param);
+	if (ret) {
+		kthread_stop(thread);
+		pr_warn("%s: failed to set SCHED_FIFO\n", __func__);
+		return ret;
+	}
+
+	sf_policy->thread = thread;
+	if (!policy->dvfs_possible_from_any_cpu)
+		kthread_bind_mask(thread, policy->related_cpus);
+
+	init_irq_work(&sf_policy->irq_work, snowflake_irq_work);
+	mutex_init(&sf_policy->work_lock);
+	wake_up_process(thread);
+	return 0;
+}
+
+static void snowflake_kthread_stop(struct snowflake_policy *sf_policy)
+{
+	if (sf_policy->policy->fast_switch_enabled)
+		return;
+
+	kthread_flush_worker(&sf_policy->worker);
+	kthread_stop(sf_policy->thread);
+	mutex_destroy(&sf_policy->work_lock);
+}
+
+static struct snowflake_tunables *
+snowflake_tunables_alloc(struct snowflake_policy *sf_policy)
+{
+	struct snowflake_tunables *tunables;
+	unsigned int transition_delay;
+
+	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+	if (!tunables)
+		return NULL;
+
+	gov_attr_set_init(&tunables->attr_set, &sf_policy->tunables_hook);
+	if (!have_governor_per_policy())
+		global_tunables = tunables;
+
+	transition_delay = cpufreq_policy_transition_delay_us(sf_policy->policy);
+	tunables->up_rate_limit_us = max_t(unsigned int, transition_delay,
+					    SNOWFLAKE_DEFAULT_UP_RATE_US);
+	tunables->down_rate_limit_us = max_t(unsigned int, transition_delay,
+					      SNOWFLAKE_DEFAULT_DOWN_RATE_US);
+	tunables->target_load = SNOWFLAKE_DEFAULT_TARGET_LOAD;
+	tunables->hispeed_load = SNOWFLAKE_DEFAULT_HISPEED_LOAD;
+	tunables->hispeed_freq = SNOWFLAKE_DEFAULT_HISPEED_FREQ;
+	tunables->boost_pct = SNOWFLAKE_DEFAULT_BOOST_PCT;
+	tunables->iowait_boost_enable = 1;
+	tunables->busy_hold_enable = 1;
+	tunables->rt_dl_boost_enable = 1;
+
+	return tunables;
+}
+
+static void snowflake_clear_global_tunables(void)
+{
+	if (!have_governor_per_policy())
+		global_tunables = NULL;
+}
+
+static int snowflake_init(struct cpufreq_policy *policy)
+{
+	struct snowflake_policy *sf_policy;
+	struct snowflake_tunables *tunables;
+	int ret = 0;
+
+	if (policy->governor_data)
+		return -EBUSY;
+
+	cpufreq_enable_fast_switch(policy);
+
+	sf_policy = snowflake_policy_alloc(policy);
+	if (!sf_policy) {
+		ret = -ENOMEM;
+		goto disable_fast_switch;
+	}
+
+	ret = snowflake_kthread_create(sf_policy);
+	if (ret)
+		goto free_sf_policy;
+
+	mutex_lock(&global_tunables_lock);
+
+	if (global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+		policy->governor_data = sf_policy;
+		sf_policy->tunables = global_tunables;
+		gov_attr_set_get(&global_tunables->attr_set,
+				 &sf_policy->tunables_hook);
+		goto out;
+	}
+
+	tunables = snowflake_tunables_alloc(sf_policy);
+	if (!tunables) {
+		ret = -ENOMEM;
+		goto stop_kthread;
+	}
+
+	policy->governor_data = sf_policy;
+	sf_policy->tunables = tunables;
+
+	ret = kobject_init_and_add(&tunables->attr_set.kobj,
+				    &snowflake_tunables_ktype,
+				    get_governor_parent_kobj(policy), "%s",
+				    snowflake_gov.name);
+	if (ret)
+		goto fail;
+
+out:
+	mutex_unlock(&global_tunables_lock);
+	return 0;
+
+fail:
+	kobject_put(&tunables->attr_set.kobj);
+	policy->governor_data = NULL;
+	snowflake_clear_global_tunables();
+
+stop_kthread:
+	snowflake_kthread_stop(sf_policy);
+	mutex_unlock(&global_tunables_lock);
+
+free_sf_policy:
+	snowflake_policy_free(sf_policy);
+
+disable_fast_switch:
+	cpufreq_disable_fast_switch(policy);
+	pr_err("initialization failed (error %d)\n", ret);
+	return ret;
+}
+
+static void snowflake_exit(struct cpufreq_policy *policy)
+{
+	struct snowflake_policy *sf_policy = policy->governor_data;
+	struct snowflake_tunables *tunables = sf_policy->tunables;
+	unsigned int count;
+
+	mutex_lock(&global_tunables_lock);
+
+	count = gov_attr_set_put(&tunables->attr_set, &sf_policy->tunables_hook);
+	policy->governor_data = NULL;
+	if (!count)
+		snowflake_clear_global_tunables();
+
+	mutex_unlock(&global_tunables_lock);
+
+	snowflake_kthread_stop(sf_policy);
+	snowflake_policy_free(sf_policy);
+	cpufreq_disable_fast_switch(policy);
+}
+
+static int snowflake_start(struct cpufreq_policy *policy)
+{
+	struct snowflake_policy *sf_policy = policy->governor_data;
+	unsigned int cpu;
+
+	snowflake_sync_rate_limits(sf_policy);
+	sf_policy->last_freq_update_time = 0;
+	sf_policy->next_freq = UINT_MAX;
+	sf_policy->work_in_progress = false;
+	sf_policy->need_freq_update = false;
+	sf_policy->cached_raw_freq = 0;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct snowflake_cpu *sf_cpu = &per_cpu(snowflake_cpu, cpu);
+
+		memset(sf_cpu, 0, sizeof(*sf_cpu));
+		sf_cpu->cpu = cpu;
+		sf_cpu->sf_policy = sf_policy;
+		sf_cpu->flags = SCHED_CPUFREQ_DL;
+		sf_cpu->iowait_boost_max = capacity_orig_of(cpu);
+		sf_cpu->min_boost = (SCHED_CAPACITY_SCALE *
+				       policy->cpuinfo.min_freq) /
+				      policy->cpuinfo.max_freq;
+	}
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct snowflake_cpu *sf_cpu = &per_cpu(snowflake_cpu, cpu);
+
+		cpufreq_add_update_util_hook(cpu, &sf_cpu->update_util,
+			policy_is_shared(policy) ? snowflake_update_shared :
+						   snowflake_update_single);
+	}
+
+	return 0;
+}
+
+static void snowflake_stop(struct cpufreq_policy *policy)
+{
+	struct snowflake_policy *sf_policy = policy->governor_data;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, policy->cpus)
+		cpufreq_remove_update_util_hook(cpu);
+
+	synchronize_sched();
+
+	if (!policy->fast_switch_enabled) {
+		irq_work_sync(&sf_policy->irq_work);
+		kthread_cancel_work_sync(&sf_policy->work);
+	}
+}
+
+static void snowflake_limits(struct cpufreq_policy *policy)
+{
+	struct snowflake_policy *sf_policy = policy->governor_data;
+
+	if (!policy->fast_switch_enabled) {
+		mutex_lock(&sf_policy->work_lock);
+		cpufreq_policy_apply_limits(policy);
+		mutex_unlock(&sf_policy->work_lock);
+	}
+
+	sf_policy->need_freq_update = true;
+}
+
+static struct cpufreq_governor snowflake_gov = {
+	.name = "snowflake",
+	.owner = THIS_MODULE,
+	.dynamic_switching = true,
+	.init = snowflake_init,
+	.exit = snowflake_exit,
+	.start = snowflake_start,
+	.stop = snowflake_stop,
+	.limits = snowflake_limits,
+};
