From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ChatGPT <chatgpt@example.com>
Date: Sat, 25 Apr 2026 00:00:00 -0700
Subject: [PATCH] cpufreq: sched: add hydrogen governor

Add a schedutil-derived CPUFreq governor named "hydrogen" for Android
latency-sensitive workloads.  It keeps scheduler update-util hooks and
MTK schedutil-style frequency commits, while exposing tunables commonly
found in aggressive third-party governors:

  - target_load and util_boost for faster util-to-frequency mapping
  - hispeed_load / hispeed_freq floor
  - boost and boostpulse
  - separate up/down rate limits
  - min_sample_time for downshift hysteresis
  - I/O wait boost and RT/DL max boost paths
  - powersave_bias for optional thermal/battery trimming

The governor is built from kernel/sched so it can access scheduler
utilization, WALT/SchedTune boosted_cpu_util(), uclamp and MTK helper
paths used by schedutil.

Signed-off-by: ChatGPT <chatgpt@example.com>
---
 drivers/cpufreq/Kconfig          |   25 +
 kernel/sched/Makefile            |    1 +
 kernel/sched/cpufreq_hydrogen.c  | 1156 ++++++++++++++++++++++++++++++
 3 files changed, 1182 insertions(+)
 create mode 100644 kernel/sched/cpufreq_hydrogen.c

--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -120,6 +120,17 @@
 	  have a look at the help section of that governor. The fallback
 	  governor will be 'performance'.
 
+config CPU_FREQ_DEFAULT_GOV_HYDROGEN
+	bool "hydrogen"
+	depends on SMP
+	select CPU_FREQ_GOV_HYDROGEN
+	select CPU_FREQ_GOV_PERFORMANCE
+	help
+	  Use the 'hydrogen' CPUFreq governor by default. Hydrogen is a
+	  schedutil-derived governor tuned for Android latency-sensitive
+	  workloads, with hispeed, boostpulse and I/O wait boost tunables.
+	  The fallback governor will be 'performance'.
+
 endchoice
 
 config CPU_FREQ_GOV_PERFORMANCE
@@ -232,6 +243,20 @@
 
 	  If in doubt, say N.
 
+config CPU_FREQ_GOV_HYDROGEN
+	bool "'hydrogen' cpufreq policy governor"
+	depends on CPU_FREQ && SMP
+	select CPU_FREQ_GOV_ATTR_SET
+	select IRQ_WORK
+	help
+	  Hydrogen is a schedutil-derived Android governor.  It keeps the
+	  scheduler-driven utilization path but adds aggressive third-party
+	  governor features: target_load, hispeed_freq/hispeed_load,
+	  boost/boostpulse, separate up/down rate limits, min_sample_time,
+	  I/O wait boost, RT/DL fast boost, util_boost and powersave_bias.
+
+	  If in doubt, say N.
+
 comment "CPU frequency scaling drivers"
 
 config CPUFREQ_DT
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -17,5 +17,6 @@ obj-$(CONFIG_SCHED_DEBUG) += debug.o
 obj-$(CONFIG_SCHED_TUNE) += tune.o
 obj-$(CONFIG_CGROUP_CPUACCT) += cpuacct.o
 obj-$(CONFIG_CPU_FREQ) += cpufreq.o
 obj-$(CONFIG_CPU_FREQ_GOV_SCHEDUTIL) += cpufreq_schedutil.o
+obj-$(CONFIG_CPU_FREQ_GOV_HYDROGEN) += cpufreq_hydrogen.o
 obj-$(CONFIG_MEMBARRIER) += membarrier.o
 obj-$(CONFIG_PSI) += psi.o
--- /dev/null
+++ b/kernel/sched/cpufreq_hydrogen.c
@@ -0,0 +1,1156 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hydrogen CPUFreq governor for MT6877 / Android kernels.
+ *
+ * Schedutil-style scheduler driven governor with Android interactive-like
+ * fast ramping, pulse boost, hispeed floor, tunable target load, I/O wait
+ * boost and RT/DL boost paths.
+ */
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/irq_work.h>
+#include <linux/kernel.h>
+#include <linux/kthread.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/sched.h>
+#include <linux/sched/cpufreq.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/tick.h>
+#include <trace/events/power.h>
+#include <trace/events/sched.h>
+#include <uapi/linux/sched/types.h>
+
+#include "sched.h"
+#include "tune.h"
+#include "cpufreq_schedutil.h"
+
+#define HYDROGEN_DEFAULT_TARGET_LOAD          70U
+#define HYDROGEN_DEFAULT_HISPEED_LOAD         75U
+#define HYDROGEN_DEFAULT_UTIL_BOOST           12U
+#define HYDROGEN_DEFAULT_DOWN_RATE_LIMIT_US   8000U
+#define HYDROGEN_DEFAULT_MIN_SAMPLE_TIME_US   20000U
+#define HYDROGEN_DEFAULT_BOOSTPULSE_US        40000U
+#define HYDROGEN_IOWAIT_BOOST_MIN             (SCHED_CAPACITY_SCALE / 8)
+
+static struct cpufreq_governor hydrogen_gov;
+
+unsigned long boosted_cpu_util(int cpu);
+
+struct hx_tunables {
+	struct gov_attr_set attr_set;
+
+	unsigned int up_rate_limit_us;
+	unsigned int down_rate_limit_us;
+	unsigned int min_sample_time_us;
+
+	unsigned int target_load;
+	unsigned int hispeed_load;
+	unsigned int hispeed_freq;
+	unsigned int util_boost;
+	unsigned int powersave_bias;
+
+	unsigned int iowait_boost_enable;
+	unsigned int rt_boost;
+	unsigned int boost;
+	unsigned int boostpulse_duration_us;
+	u64 boostpulse_endtime;
+};
+
+struct hx_policy {
+	struct cpufreq_policy *policy;
+	struct hx_tunables *tunables;
+	struct list_head tunables_hook;
+
+	raw_spinlock_t update_lock; /* For shared policies. */
+	u64 last_freq_update_time;
+	u64 last_freq_increase_time;
+	s64 min_rate_limit_ns;
+	s64 up_rate_delay_ns;
+	s64 down_rate_delay_ns;
+	s64 min_sample_time_ns;
+	unsigned int next_freq;
+	unsigned int cached_raw_freq;
+
+	/* Slow-switch path. */
+	struct irq_work irq_work;
+	struct kthread_work work;
+	struct mutex work_lock;
+	struct kthread_worker worker;
+	struct task_struct *thread;
+	bool work_in_progress;
+	bool need_freq_update;
+};
+
+struct hx_cpu {
+	struct update_util_data update_util;
+	struct hx_policy *hx_policy;
+	unsigned int cpu;
+
+	bool iowait_boost_pending;
+	unsigned int iowait_boost;
+	unsigned int iowait_boost_max;
+	u64 last_update;
+
+	/* Shared-policy state. */
+	unsigned long util;
+	unsigned long max;
+	unsigned int flags;
+	unsigned long min_boost;
+
+#ifdef CONFIG_NO_HZ_COMMON
+	unsigned long saved_idle_calls;
+#endif
+};
+
+static DEFINE_PER_CPU(struct hx_cpu, hydrogen_cpu);
+
+/************************ Governor internals ************************/
+
+static bool hx_boost_active(struct hx_tunables *tunables)
+{
+	u64 end;
+	u64 now;
+
+	if (READ_ONCE(tunables->boost))
+		return true;
+
+	end = READ_ONCE(tunables->boostpulse_endtime);
+	if (!end)
+		return false;
+
+	now = ktime_to_us(ktime_get());
+	return (s64)(end - now) > 0;
+}
+
+static void hx_update_min_rate_limit_ns(struct hx_policy *hx_policy)
+{
+	hx_policy->min_rate_limit_ns = min(hx_policy->up_rate_delay_ns,
+					    hx_policy->down_rate_delay_ns);
+}
+
+static bool hx_should_update_freq(struct hx_policy *hx_policy, u64 time)
+{
+	s64 delta_ns;
+	struct cpufreq_policy *policy = hx_policy->policy;
+
+	if (policy->governor != &hydrogen_gov || !policy->governor_data)
+		return false;
+
+	if (policy->fast_switch_enabled && !cpufreq_can_do_remote_dvfs(policy))
+		return false;
+
+	if (hx_policy->work_in_progress)
+		return false;
+
+	if (unlikely(hx_policy->need_freq_update)) {
+		hx_policy->need_freq_update = false;
+		hx_policy->next_freq = UINT_MAX;
+		return true;
+	}
+
+	delta_ns = time - hx_policy->last_freq_update_time;
+	return delta_ns >= hx_policy->min_rate_limit_ns;
+}
+
+static bool hx_up_down_rate_limit(struct hx_policy *hx_policy, u64 time,
+					 unsigned int next_freq)
+{
+	s64 delta_ns;
+
+	if (hx_policy->next_freq == UINT_MAX)
+		return false;
+
+	delta_ns = time - hx_policy->last_freq_update_time;
+
+	if (next_freq > hx_policy->next_freq &&
+	    delta_ns < hx_policy->up_rate_delay_ns)
+		return true;
+
+	if (next_freq < hx_policy->next_freq) {
+		if (delta_ns < hx_policy->down_rate_delay_ns)
+			return true;
+
+		if (time - hx_policy->last_freq_increase_time <
+		    hx_policy->min_sample_time_ns)
+			return true;
+	}
+
+	return false;
+}
+
+static void hx_update_commit(struct hx_policy *hx_policy, u64 time,
+			     unsigned int next_freq)
+{
+	struct cpufreq_policy *policy = hx_policy->policy;
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	int cid = arch_get_cluster_id(policy->cpu);
+#endif
+
+	if (!next_freq || hx_policy->next_freq == next_freq)
+		return;
+
+	if (hx_up_down_rate_limit(hx_policy, time, next_freq))
+		return;
+
+	if (hx_policy->next_freq == UINT_MAX || next_freq > hx_policy->next_freq)
+		hx_policy->last_freq_increase_time = time;
+
+	hx_policy->next_freq = next_freq;
+	hx_policy->last_freq_update_time = time;
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	mt_cpufreq_set_by_wfi_load_cluster(cid, next_freq);
+	policy->cur = next_freq;
+	trace_sched_util(cid, next_freq, time);
+#else
+	if (policy->fast_switch_enabled) {
+		next_freq = cpufreq_driver_fast_switch(policy, next_freq);
+		if (!next_freq)
+			return;
+		policy->cur = next_freq;
+		trace_cpu_frequency(next_freq, smp_processor_id());
+	} else {
+		hx_policy->work_in_progress = true;
+		irq_work_queue(&hx_policy->irq_work);
+	}
+#endif
+}
+
+static unsigned long hx_apply_target_load(struct hx_tunables *tunables,
+					 unsigned long util, unsigned long max)
+{
+	unsigned int target_load;
+	unsigned int util_boost;
+	u64 boosted;
+
+	if (!max)
+		return util;
+
+	target_load = clamp_val(READ_ONCE(tunables->target_load), 1U, 100U);
+	util_boost = min(READ_ONCE(tunables->util_boost), 100U);
+
+	boosted = (u64)util * 100U;
+	boosted = (boosted + target_load - 1) / target_load;
+
+	if (util_boost)
+		boosted += (boosted * util_boost) / 100U;
+
+	if (boosted > max)
+		boosted = max;
+
+	return (unsigned long)boosted;
+}
+
+static unsigned int hx_get_next_freq(struct hx_policy *hx_policy,
+				    unsigned long util, unsigned long max)
+{
+	struct cpufreq_policy *policy = hx_policy->policy;
+	struct hx_tunables *tunables = hx_policy->tunables;
+	unsigned int base_freq;
+	unsigned int freq;
+	unsigned int load;
+	unsigned int hispeed_load;
+	unsigned int hispeed_freq;
+	unsigned int powersave_bias;
+	u64 next;
+
+	if (hx_boost_active(tunables))
+		return policy->max;
+
+	if (!max)
+		return policy->min;
+
+	load = min_t(unsigned int, 100U, (util * 100U) / max);
+	util = hx_apply_target_load(tunables, util, max);
+
+	base_freq = arch_scale_freq_invariant() ?
+		policy->cpuinfo.max_freq : policy->cur;
+	if (!base_freq)
+		base_freq = policy->cpuinfo.max_freq;
+
+	next = (u64)base_freq * util;
+	next = (next + max - 1) / max;
+	next = (next * capacity_margin + SCHED_CAPACITY_SCALE - 1) /
+	       SCHED_CAPACITY_SCALE;
+	freq = (unsigned int)next;
+
+	hispeed_load = READ_ONCE(tunables->hispeed_load);
+	if (hispeed_load && load >= hispeed_load) {
+		hispeed_freq = READ_ONCE(tunables->hispeed_freq);
+		if (!hispeed_freq)
+			hispeed_freq = policy->max;
+		hispeed_freq = clamp_val(hispeed_freq, policy->min, policy->max);
+		freq = max(freq, hispeed_freq);
+	}
+
+	powersave_bias = min(READ_ONCE(tunables->powersave_bias), 100U);
+	if (powersave_bias && freq > policy->min)
+		freq -= ((freq - policy->min) * powersave_bias) / 100U;
+
+	freq = clamp_val(freq, policy->min, policy->max);
+	hx_policy->cached_raw_freq = freq;
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	return freq;
+#else
+	return cpufreq_driver_resolve_freq(policy, freq);
+#endif
+}
+
+static void hx_get_util(unsigned long *util, unsigned long *max, int cpu)
+{
+	unsigned long max_cap;
+
+	max_cap = arch_scale_cpu_capacity(NULL, cpu);
+	*util = boosted_cpu_util(cpu);
+	if (idle_cpu(cpu))
+		*util = 0;
+	*util = min(*util, max_cap);
+	*max = max_cap;
+}
+
+static void hx_set_iowait_boost(struct hx_cpu *hx_cpu, u64 time,
+				unsigned int flags)
+{
+	struct hx_tunables *tunables = hx_cpu->hx_policy->tunables;
+	unsigned int max_boost;
+
+	if (!READ_ONCE(tunables->iowait_boost_enable)) {
+		hx_cpu->iowait_boost = 0;
+		hx_cpu->iowait_boost_pending = false;
+		return;
+	}
+
+	if (flags & SCHED_CPUFREQ_IOWAIT) {
+		if (hx_cpu->iowait_boost_pending)
+			return;
+
+		hx_cpu->iowait_boost_pending = true;
+		max_boost = hx_cpu->iowait_boost_max;
+		max_boost = uclamp_util(cpu_rq(hx_cpu->cpu), max_boost);
+
+		if (hx_cpu->iowait_boost) {
+			hx_cpu->iowait_boost <<= 1;
+			if (hx_cpu->iowait_boost > max_boost)
+				hx_cpu->iowait_boost = max_boost;
+		} else {
+			hx_cpu->iowait_boost = hx_cpu->min_boost;
+		}
+	} else if (hx_cpu->iowait_boost) {
+		s64 delta_ns = time - hx_cpu->last_update;
+
+		if (delta_ns > TICK_NSEC) {
+			hx_cpu->iowait_boost = 0;
+			hx_cpu->iowait_boost_pending = false;
+		}
+	}
+}
+
+static void hx_iowait_boost(struct hx_cpu *hx_cpu, unsigned long *util,
+			    unsigned long *max)
+{
+	unsigned int boost_util, boost_max;
+
+	if (!hx_cpu->iowait_boost)
+		return;
+
+	if (hx_cpu->iowait_boost_pending) {
+		hx_cpu->iowait_boost_pending = false;
+	} else {
+		hx_cpu->iowait_boost >>= 1;
+		if (hx_cpu->iowait_boost < hx_cpu->min_boost) {
+			hx_cpu->iowait_boost = 0;
+			return;
+		}
+	}
+
+	boost_util = hx_cpu->iowait_boost;
+	boost_max = hx_cpu->iowait_boost_max;
+	if (*util * boost_max < *max * boost_util) {
+		*util = boost_util;
+		*max = boost_max;
+	}
+}
+
+#ifdef CONFIG_NO_HZ_COMMON
+static bool hx_cpu_is_busy(struct hx_cpu *hx_cpu)
+{
+	unsigned long idle_calls = tick_nohz_get_idle_calls_cpu(hx_cpu->cpu);
+	bool ret = idle_calls == hx_cpu->saved_idle_calls;
+
+	hx_cpu->saved_idle_calls = idle_calls;
+	return ret;
+}
+#else
+static inline bool hx_cpu_is_busy(struct hx_cpu *hx_cpu)
+{
+	return false;
+}
+#endif
+
+static bool hx_forced_max(struct hx_policy *hx_policy, unsigned int flags)
+{
+	struct hx_tunables *tunables = hx_policy->tunables;
+
+	if (flags & SCHED_CPUFREQ_DL)
+		return true;
+
+	if ((flags & SCHED_CPUFREQ_RT) && READ_ONCE(tunables->rt_boost))
+		return true;
+
+	return hx_boost_active(tunables);
+}
+
+static void hx_update_single(struct update_util_data *hook, u64 time,
+			     unsigned int flags)
+{
+	struct hx_cpu *hx_cpu = container_of(hook, struct hx_cpu, update_util);
+	struct hx_policy *hx_policy = hx_cpu->hx_policy;
+	struct cpufreq_policy *policy = hx_policy->policy;
+	unsigned long util, max;
+	unsigned int next_f;
+	bool busy;
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	int cid;
+#endif
+
+	hx_set_iowait_boost(hx_cpu, time, flags);
+	hx_cpu->last_update = time;
+
+	if (!hx_should_update_freq(hx_policy, time))
+		return;
+
+	busy = hx_cpu_is_busy(hx_cpu);
+
+	if (hx_forced_max(hx_policy, flags)) {
+		next_f = policy->cpuinfo.max_freq;
+	} else {
+		hx_get_util(&util, &max, hx_cpu->cpu);
+		util = uclamp_util(cpu_rq(hx_cpu->cpu), util);
+		hx_iowait_boost(hx_cpu, &util, &max);
+		next_f = hx_get_next_freq(hx_policy, util, max);
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+		next_f = clamp_val(next_f, policy->min, policy->max);
+		cid = arch_get_cluster_id(policy->cpu);
+		next_f = mt_cpufreq_find_close_freq(cid, next_f);
+#endif
+
+		if (busy && next_f < hx_policy->next_freq &&
+		    hx_policy->next_freq != UINT_MAX) {
+			next_f = hx_policy->next_freq;
+			hx_policy->cached_raw_freq = 0;
+		}
+	}
+
+	hx_update_commit(hx_policy, time, next_f);
+}
+
+static unsigned int hx_next_freq_shared(struct hx_cpu *hx_cpu, u64 time)
+{
+	struct hx_policy *hx_policy = hx_cpu->hx_policy;
+	struct cpufreq_policy *policy = hx_policy->policy;
+	unsigned long util = 0, max = 1;
+	unsigned int j;
+	unsigned int next_f;
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	int cid;
+#endif
+
+	for_each_cpu(j, policy->cpus) {
+		struct hx_cpu *j_hx_cpu = &per_cpu(hydrogen_cpu, j);
+		unsigned long j_util, j_max;
+		s64 delta_ns;
+
+		delta_ns = time - j_hx_cpu->last_update;
+		if (delta_ns > TICK_NSEC) {
+			j_hx_cpu->iowait_boost = 0;
+			j_hx_cpu->iowait_boost_pending = false;
+			if (idle_cpu(j))
+				continue;
+		}
+
+		if (hx_forced_max(hx_policy, j_hx_cpu->flags))
+			return policy->cpuinfo.max_freq;
+
+		j_util = j_hx_cpu->util;
+		j_max = j_hx_cpu->max;
+#ifdef CONFIG_UCLAMP_TASK
+		trace_schedutil_uclamp_util(j, j_util);
+#endif
+		j_util = uclamp_util(cpu_rq(j), j_util);
+		hx_iowait_boost(j_hx_cpu, &j_util, &j_max);
+
+		if (j_util * max > j_max * util) {
+			util = j_util;
+			max = j_max;
+		}
+	}
+
+	next_f = hx_get_next_freq(hx_policy, util, max);
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	next_f = clamp_val(next_f, policy->min, policy->max);
+	cid = arch_get_cluster_id(policy->cpu);
+	next_f = mt_cpufreq_find_close_freq(cid, next_f);
+#endif
+	return next_f;
+}
+
+static void hx_update_shared(struct update_util_data *hook, u64 time,
+			     unsigned int flags)
+{
+	struct hx_cpu *hx_cpu = container_of(hook, struct hx_cpu, update_util);
+	struct hx_policy *hx_policy = hx_cpu->hx_policy;
+	unsigned long util, max;
+	unsigned int next_f;
+
+	hx_get_util(&util, &max, hx_cpu->cpu);
+
+	raw_spin_lock(&hx_policy->update_lock);
+	hx_cpu->util = util;
+	hx_cpu->max = max;
+	hx_cpu->flags = flags;
+	hx_set_iowait_boost(hx_cpu, time, flags);
+	hx_cpu->last_update = time;
+
+	if (hx_should_update_freq(hx_policy, time)) {
+		if (hx_forced_max(hx_policy, flags))
+			next_f = hx_policy->policy->cpuinfo.max_freq;
+		else
+			next_f = hx_next_freq_shared(hx_cpu, time);
+		hx_update_commit(hx_policy, time, next_f);
+	}
+	raw_spin_unlock(&hx_policy->update_lock);
+}
+
+static void hx_work(struct kthread_work *work)
+{
+	struct hx_policy *hx_policy = container_of(work, struct hx_policy, work);
+
+	mutex_lock(&hx_policy->work_lock);
+	__cpufreq_driver_target(hx_policy->policy, hx_policy->next_freq,
+				  CPUFREQ_RELATION_L);
+	mutex_unlock(&hx_policy->work_lock);
+	hx_policy->work_in_progress = false;
+}
+
+static void hx_irq_work(struct irq_work *irq_work)
+{
+	struct hx_policy *hx_policy;
+
+	hx_policy = container_of(irq_work, struct hx_policy, irq_work);
+	kthread_queue_work(&hx_policy->worker, &hx_policy->work);
+}
+
+/**************************** sysfs tunables ***************************/
+
+static struct hx_tunables *global_tunables;
+static DEFINE_MUTEX(global_tunables_lock);
+
+static inline struct hx_tunables *to_hx_tunables(struct gov_attr_set *attr_set)
+{
+	return container_of(attr_set, struct hx_tunables, attr_set);
+}
+
