+static struct pxgov_policy *pxgov_policy_alloc(struct cpufreq_policy *policy)
+{
+	struct pxgov_policy *px_policy;
+
+	px_policy = kzalloc(sizeof(*px_policy), GFP_KERNEL);
+	if (!px_policy)
+		return NULL;
+
+	px_policy->policy = policy;
+	raw_spin_lock_init(&px_policy->update_lock);
+	return px_policy;
+}
+
+static void pxgov_policy_free(struct pxgov_policy *px_policy)
+{
+	kfree(px_policy);
+}
+
+static int pxgov_kthread_create(struct pxgov_policy *px_policy)
+{
+	struct task_struct *thread;
+	struct sched_param param = { .sched_priority = PX_KTHREAD_PRIORITY };
+	struct cpufreq_policy *policy = px_policy->policy;
+	int ret;
+
+	if (policy->fast_switch_enabled)
+		return 0;
+
+	kthread_init_work(&px_policy->work, pxgov_work);
+	kthread_init_worker(&px_policy->worker);
+	thread = kthread_create(kthread_worker_fn, &px_policy->worker,
+				"pxgov:%d", cpumask_first(policy->related_cpus));
+	if (IS_ERR(thread)) {
+		pr_err("failed to create pxgov thread: %ld\n", PTR_ERR(thread));
+		return PTR_ERR(thread);
+	}
+
+	ret = sched_setscheduler_nocheck(thread, SCHED_FIFO, &param);
+	if (ret) {
+		kthread_stop(thread);
+		pr_warn("%s: failed to set SCHED_FIFO\n", __func__);
+		return ret;
+	}
+
+	px_policy->thread = thread;
+	if (!policy->dvfs_possible_from_any_cpu)
+		kthread_bind_mask(thread, policy->related_cpus);
+
+	init_irq_work(&px_policy->irq_work, pxgov_irq_work);
+	mutex_init(&px_policy->work_lock);
+	wake_up_process(thread);
+
+	return 0;
+}
+
+static void pxgov_kthread_stop(struct pxgov_policy *px_policy)
+{
+	if (px_policy->policy->fast_switch_enabled)
+		return;
+
+	kthread_flush_worker(&px_policy->worker);
+	kthread_stop(px_policy->thread);
+	mutex_destroy(&px_policy->work_lock);
+}
+
+static struct pxgov_tunables *pxgov_tunables_alloc(struct pxgov_policy *px_policy)
+{
+	struct pxgov_tunables *tunables;
+
+	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+	if (tunables) {
+		gov_attr_set_init(&tunables->attr_set, &px_policy->tunables_hook);
+		if (!have_governor_per_policy())
+			global_tunables = tunables;
+	}
+
+	return tunables;
+}
+
+static void pxgov_clear_global_tunables(void)
+{
+	if (!have_governor_per_policy())
+		global_tunables = NULL;
+}
+
+static void pxgov_init_tunables(struct pxgov_tunables *tunables,
+				struct cpufreq_policy *policy)
+{
+	unsigned int delay = cpufreq_policy_transition_delay_us(policy);
+
+	tunables->up_rate_limit_us = min(delay, PX_DEF_UP_RATE_US);
+	tunables->down_rate_limit_us = max(delay, PX_DEF_DOWN_RATE_US);
+	tunables->hispeed_load = PX_DEF_HISPEED_LOAD;
+	tunables->hispeed_freq = PX_DEF_HISPEED_FREQ;
+	tunables->target_load = PX_DEF_TARGET_LOAD;
+	tunables->boost_margin = PX_DEF_BOOST_MARGIN;
+	tunables->frame_hold_us = PX_DEF_FRAME_HOLD_US;
+	tunables->decay_shift = PX_DEF_DECAY_SHIFT;
+	tunables->down_step_pct = PX_DEF_DOWN_STEP_PCT;
+	tunables->iowait_boost_enable = PX_DEF_IOWAIT_BOOST;
+}
+
+static int pxgov_init(struct cpufreq_policy *policy)
+{
+	struct pxgov_policy *px_policy;
+	struct pxgov_tunables *tunables;
+	int ret = 0;
+
+	if (policy->governor_data)
+		return -EBUSY;
+
+	cpufreq_enable_fast_switch(policy);
+
+	px_policy = pxgov_policy_alloc(policy);
+	if (!px_policy) {
+		ret = -ENOMEM;
+		goto disable_fast_switch;
+	}
+
+	ret = pxgov_kthread_create(px_policy);
+	if (ret)
+		goto free_px_policy;
+
+	mutex_lock(&global_tunables_lock);
+	if (global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+
+		policy->governor_data = px_policy;
+		px_policy->tunables = global_tunables;
+		gov_attr_set_get(&global_tunables->attr_set,
+				 &px_policy->tunables_hook);
+		goto out;
+	}
+
+	tunables = pxgov_tunables_alloc(px_policy);
+	if (!tunables) {
+		ret = -ENOMEM;
+		goto stop_kthread;
+	}
+
+	pxgov_init_tunables(tunables, policy);
+
+	policy->governor_data = px_policy;
+	px_policy->tunables = tunables;
+
+	ret = kobject_init_and_add(&tunables->attr_set.kobj, &pxgov_tunables_ktype,
+				get_governor_parent_kobj(policy), "%s",
+				pissarrox_gov.name);
+	if (ret)
+		goto fail;
+
+out:
+	mutex_unlock(&global_tunables_lock);
+	return 0;
+
+fail:
+	kobject_put(&tunables->attr_set.kobj);
+	policy->governor_data = NULL;
+	pxgov_clear_global_tunables();
+stop_kthread:
+	pxgov_kthread_stop(px_policy);
+	mutex_unlock(&global_tunables_lock);
+free_px_policy:
+	pxgov_policy_free(px_policy);
+disable_fast_switch:
+	cpufreq_disable_fast_switch(policy);
+	pr_err("initialization failed (error %d)\n", ret);
+	return ret;
+}
+
+static void pxgov_exit(struct cpufreq_policy *policy)
+{
+	struct pxgov_policy *px_policy = policy->governor_data;
+	struct pxgov_tunables *tunables = px_policy->tunables;
+	unsigned int count;
+
+	mutex_lock(&global_tunables_lock);
+	count = gov_attr_set_put(&tunables->attr_set, &px_policy->tunables_hook);
+	policy->governor_data = NULL;
+	if (!count)
+		pxgov_clear_global_tunables();
+	mutex_unlock(&global_tunables_lock);
+
+	pxgov_kthread_stop(px_policy);
+	pxgov_policy_free(px_policy);
+	cpufreq_disable_fast_switch(policy);
+}
+
+static int pxgov_start(struct cpufreq_policy *policy)
+{
+	struct pxgov_policy *px_policy = policy->governor_data;
+	unsigned int cpu;
+
+	px_policy->up_rate_delay_ns =
+		px_policy->tunables->up_rate_limit_us * NSEC_PER_USEC;
+	px_policy->down_rate_delay_ns =
+		px_policy->tunables->down_rate_limit_us * NSEC_PER_USEC;
+	px_policy->frame_hold_ns =
+		px_policy->tunables->frame_hold_us * NSEC_PER_USEC;
+	pxgov_update_min_rate_limit_ns(px_policy);
+
+	px_policy->last_freq_update_time = 0;
+	px_policy->next_freq = UINT_MAX;
+	px_policy->work_in_progress = false;
+	px_policy->need_freq_update = false;
+	px_policy->cached_raw_freq = 0;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct pxgov_cpu *px_cpu = &per_cpu(pxgov_cpu, cpu);
+
+		memset(px_cpu, 0, sizeof(*px_cpu));
+		px_cpu->cpu = cpu;
+		px_cpu->px_policy = px_policy;
+		px_cpu->flags = SCHED_CPUFREQ_DL;
+		px_cpu->iowait_boost_max = capacity_orig_of(cpu);
+		px_cpu->min_boost =
+			(SCHED_CAPACITY_SCALE * policy->cpuinfo.min_freq) /
+			policy->cpuinfo.max_freq;
+
+		if (!px_cpu->min_boost)
+			px_cpu->min_boost = PX_IOWAIT_BOOST_MIN;
+	}
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct pxgov_cpu *px_cpu = &per_cpu(pxgov_cpu, cpu);
+
+		cpufreq_add_update_util_hook(cpu, &px_cpu->update_util,
+			policy_is_shared(policy) ? pxgov_update_shared :
+			pxgov_update_single);
+	}
+
+	return 0;
+}
+
+static void pxgov_stop(struct cpufreq_policy *policy)
+{
+	struct pxgov_policy *px_policy = policy->governor_data;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, policy->cpus)
+		cpufreq_remove_update_util_hook(cpu);
+
+	synchronize_sched();
+
+	if (!policy->fast_switch_enabled) {
+		irq_work_sync(&px_policy->irq_work);
+		kthread_cancel_work_sync(&px_policy->work);
+	}
+}
+
+static void pxgov_limits(struct cpufreq_policy *policy)
+{
+	struct pxgov_policy *px_policy = policy->governor_data;
+
+	if (!policy->fast_switch_enabled) {
+		mutex_lock(&px_policy->work_lock);
+		cpufreq_policy_apply_limits(policy);
+		mutex_unlock(&px_policy->work_lock);
+	}
+
+	px_policy->need_freq_update = true;
+}
+
+static struct cpufreq_governor pissarrox_gov = {
+	.name = "pissarrox",
+	.owner = THIS_MODULE,
+	.dynamic_switching = true,
+	.init = pxgov_init,
+	.exit = pxgov_exit,
+	.start = pxgov_start,
+	.stop = pxgov_stop,
+	.limits = pxgov_limits,
+};
+
+#ifdef CONFIG_CPU_FREQ_DEFAULT_GOV_PISSARROX
+struct cpufreq_governor *cpufreq_default_governor(void)
+{
+	return &pissarrox_gov;
+}
+#endif
+
+static int __init pxgov_register(void)
+{
+	return cpufreq_register_governor(&pissarrox_gov);
+}
+core_initcall(pxgov_register);
