From 3cfe7a4a31f544fd09f4e7c6a05b2b8a5f4e72b9 Mon Sep 17 00:00:00 2001
From: ChatGPT <chatgpt@example.com>
Date: Sat, 25 Apr 2026 12:00:00 -0700
Subject: [PATCH] cpufreq: add pissarrox scheduler governor for MT6877

Add a scheduler-driven governor tuned for Xiaomi pissarro / MT6877.

Compared with plain schedutil, pissarrox keeps the scheduler fast path but
adds:
  * EWMA + positive-trend prediction instead of purely instantaneous util.
  * frame-hold hysteresis to avoid visible frequency drops between frames.
  * configurable target-load and high-load hispeed floor.
  * asymmetric rate limits and bounded down-steps for smoother frame pacing.
  * iowait boost compatible with scheduler utilization updates.
  * MTK SSPM fast path mirroring the existing schedutil integration.

The governor is selectable as "pissarrox" and is made the default for
pissarro_defconfig.
---
 arch/arm64/configs/pissarro_defconfig |   3 +-
 drivers/cpufreq/Kconfig               |  45 ++
 kernel/sched/Makefile                 |   1 +
 kernel/sched/cpufreq_pissarrox.c      | 1011 +++++++++++++++++++++++++
 4 files changed, 1059 insertions(+), 1 deletion(-)
 create mode 100644 kernel/sched/cpufreq_pissarrox.c

diff --git a/arch/arm64/configs/pissarro_defconfig b/arch/arm64/configs/pissarro_defconfig
index 000000000000..000000000000 100644
--- a/arch/arm64/configs/pissarro_defconfig
+++ b/arch/arm64/configs/pissarro_defconfig
@@ -420,12 +420,13 @@ CONFIG_BLK_WBT_MQ is not set
 # cpufreq / mtk_cpufreq
 CONFIG_CPU_FREQ=y
 CONFIG_CPU_FREQ_TIMES=y
 CONFIG_CPU_FREQ_STAT=y
-CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+CONFIG_CPU_FREQ_DEFAULT_GOV_PISSARROX=y
 CONFIG_CPU_FREQ_GOV_ATTR_SET=y
 CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
 CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
+CONFIG_CPU_FREQ_GOV_PISSARROX=y
 CONFIG_CPU_FREQ_GOV_BLU_SCHEDUTIL=y
 CONFIG_CPU_FREQ_GOV_ELECTROUTIL=y
 CONFIG_CPU_FREQ_GOV_HELIX=y
 # CONFIG_CPU_FREQ_GOV_ZSCHEDUTIL is not set
diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index 000000000000..000000000000 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -1193,4 +1193,20 @@ config CPU_FREQ_DEFAULT_GOV_SCHEDUTIL
 	  have a look at the help section of that governor. The fallback
 	  governor will be 'performance'.
+
+config CPU_FREQ_DEFAULT_GOV_PISSARROX
+	bool "pissarrox"
+	depends on SMP
+	select CPU_FREQ_GOV_PISSARROX
+	select CPU_FREQ_GOV_PERFORMANCE
+	help
+	  Use the 'pissarrox' CPUFreq governor by default.
+
+	  This governor is scheduler-driven like schedutil, but it adds a
+	  short load predictor, frame-hold hysteresis, bounded down-steps and
+	  asymmetric rate limits.  It is intended for MT6877 / pissarro devices
+	  where avoiding mid-frame frequency drops is more important than
+	  reacting to every single instantaneous utilization dip.
+
+	  The fallback governor will be 'performance'.
 
 endchoice
@@ -1357,3 +1373,32 @@ config CPU_FREQ_GOV_SCHEDUTIL
 	  If in doubt, say N.
+
+config CPU_FREQ_GOV_PISSARROX
+	bool "'pissarrox' cpufreq policy governor"
+	depends on CPU_FREQ && SMP
+	select CPU_FREQ_GOV_ATTR_SET
+	select IRQ_WORK
+	help
+	  'pissarrox' is a scheduler-driven CPUFreq governor designed for
+	  Xiaomi pissarro / MT6877 devices.
+
+	  It keeps the low-latency scheduler callback model of schedutil, but
+	  uses a more advanced control law:
+
+	    - EWMA smoothing with positive-trend prediction for faster ramp-up.
+	    - High-load hispeed floor for touch / render bursts.
+	    - Short frame-hold window to prevent frequency drops inside a frame.
+	    - Bounded down-step and slower decay to reduce FPS jitter.
+	    - Configurable target-load, boost margin and rate limits.
+
+	  Runtime tunables are exposed under:
+
+	    /sys/devices/system/cpu/cpufreq/pissarrox/
+
+	  or per-policy governor directories when the driver uses governor
+	  per policy.  The governor name used in scaling_governor is:
+
+	    pissarrox
+
+	  If in doubt, say N.
 
 comment "CPU frequency scaling drivers"
diff --git a/kernel/sched/Makefile b/kernel/sched/Makefile
index 000000000000..000000000000 100644
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -24,3 +24,4 @@ obj-$(CONFIG_CGROUP_CPUACCT) += cpuacct.o
 obj-$(CONFIG_CPU_FREQ) += cpufreq.o
 obj-$(CONFIG_CPU_FREQ_GOV_SCHEDUTIL) += cpufreq_schedutil.o
+obj-$(CONFIG_CPU_FREQ_GOV_PISSARROX) += cpufreq_pissarrox.o
 obj-$(CONFIG_MEMBARRIER) += membarrier.o
diff --git a/kernel/sched/cpufreq_pissarrox.c b/kernel/sched/cpufreq_pissarrox.c
new file mode 100644
index 000000000000..43f761e90a92
--- /dev/null
+++ b/kernel/sched/cpufreq_pissarrox.c
@@ -0,0 +1,1011 @@
+/*
+ * PissarroX CPUFreq governor for Xiaomi Redmi Note 11 Pro / MT6877.
+ *
+ * Scheduler driven like schedutil, but with predictive ramp-up and
+ * frame-stability hysteresis for steadier FPS at lower average power.
+ *
+ * SPDX-License-Identifier: GPL-2.0
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/irq_work.h>
+#include <linux/kthread.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/sched/cpufreq.h>
+#include <linux/slab.h>
+#include <linux/tick.h>
+#include <trace/events/power.h>
+#include <trace/events/sched.h>
+
+#include "sched.h"
+#include "tune.h"
+
+#define PX_IOWAIT_BOOST_MIN	(SCHED_CAPACITY_SCALE / 8)
+#define PX_KTHREAD_PRIORITY	(MAX_USER_RT_PRIO / 2)
+
+#define PX_DEF_UP_RATE_US	500
+#define PX_DEF_DOWN_RATE_US	9000
+#define PX_DEF_HISPEED_LOAD	82
+#define PX_DEF_HISPEED_FREQ	0
+#define PX_DEF_TARGET_LOAD	74
+#define PX_DEF_BOOST_MARGIN	12
+#define PX_DEF_FRAME_HOLD_US	12000
+#define PX_DEF_DECAY_SHIFT	3
+#define PX_DEF_DOWN_STEP_PCT	12
+#define PX_DEF_IOWAIT_BOOST	1
+
+extern unsigned long boosted_cpu_util(int cpu);
+
+static struct cpufreq_governor pissarrox_gov;
+
+struct pxgov_tunables {
+	struct gov_attr_set attr_set;
+	unsigned int up_rate_limit_us;
+	unsigned int down_rate_limit_us;
+	unsigned int hispeed_load;
+	unsigned int hispeed_freq;
+	unsigned int target_load;
+	unsigned int boost_margin;
+	unsigned int frame_hold_us;
+	unsigned int decay_shift;
+	unsigned int down_step_pct;
+	unsigned int iowait_boost_enable;
+};
+
+struct pxgov_policy {
+	struct cpufreq_policy *policy;
+	struct pxgov_tunables *tunables;
+	struct list_head tunables_hook;
+
+	raw_spinlock_t update_lock;
+	u64 last_freq_update_time;
+	s64 min_rate_limit_ns;
+	s64 up_rate_delay_ns;
+	s64 down_rate_delay_ns;
+	s64 frame_hold_ns;
+
+	unsigned int next_freq;
+	unsigned int cached_raw_freq;
+
+	struct irq_work irq_work;
+	struct kthread_work work;
+	struct mutex work_lock;
+	struct kthread_worker worker;
+	struct task_struct *thread;
+	bool work_in_progress;
+	bool need_freq_update;
+};
+
+struct pxgov_cpu {
+	struct update_util_data update_util;
+	struct pxgov_policy *px_policy;
+	unsigned int cpu;
+
+	bool iowait_boost_pending;
+	unsigned int iowait_boost;
+	unsigned int iowait_boost_max;
+	u64 last_update;
+	u64 frame_boost_until;
+
+	unsigned long util;
+	unsigned long max;
+	unsigned long smooth_util;
+	unsigned long prev_util;
+	unsigned long trend_util;
+	unsigned long min_boost;
+	unsigned int flags;
+
+#ifdef CONFIG_NO_HZ_COMMON
+	unsigned long saved_idle_calls;
+#endif
+};
+
+static DEFINE_PER_CPU(struct pxgov_cpu, pxgov_cpu);
+
+static struct pxgov_tunables *global_tunables;
+static DEFINE_MUTEX(global_tunables_lock);
+
+static inline struct pxgov_tunables *to_pxgov_tunables(struct gov_attr_set *attr_set)
+{
+	return container_of(attr_set, struct pxgov_tunables, attr_set);
+}
+
+static DEFINE_MUTEX(min_rate_lock);
+
+static void pxgov_update_min_rate_limit_ns(struct pxgov_policy *px_policy)
+{
+	mutex_lock(&min_rate_lock);
+	px_policy->min_rate_limit_ns = min(px_policy->up_rate_delay_ns,
+					    px_policy->down_rate_delay_ns);
+	mutex_unlock(&min_rate_lock);
+}
+
+static bool pxgov_should_update_freq(struct pxgov_policy *px_policy, u64 time)
+{
+	s64 delta_ns;
+	struct cpufreq_policy *policy = px_policy->policy;
+
+	if (policy->governor != &pissarrox_gov || !policy->governor_data)
+		return false;
+
+	if (policy->fast_switch_enabled && !cpufreq_can_do_remote_dvfs(policy))
+		return false;
+
+	if (px_policy->work_in_progress)
+		return false;
+
+	if (unlikely(px_policy->need_freq_update)) {
+		px_policy->need_freq_update = false;
+		px_policy->next_freq = UINT_MAX;
+		return true;
+	}
+
+	delta_ns = time - px_policy->last_freq_update_time;
+	return delta_ns >= px_policy->min_rate_limit_ns;
+}
+
+static bool pxgov_up_down_rate_limit(struct pxgov_policy *px_policy,
+				     u64 time, unsigned int next_freq)
+{
+	s64 delta_ns;
+
+	if (px_policy->next_freq == UINT_MAX)
+		return false;
+
+	delta_ns = time - px_policy->last_freq_update_time;
+
+	if (next_freq > px_policy->next_freq &&
+	    delta_ns < px_policy->up_rate_delay_ns)
+		return true;
+
+	if (next_freq < px_policy->next_freq &&
+	    delta_ns < px_policy->down_rate_delay_ns)
+		return true;
+
+	return false;
+}
+
+static unsigned int pxgov_limit_down_step(struct pxgov_policy *px_policy,
+					  unsigned int next_freq)
+{
+	struct cpufreq_policy *policy = px_policy->policy;
+	struct pxgov_tunables *tunables = px_policy->tunables;
+	unsigned int prev = px_policy->next_freq;
+	unsigned int range, max_drop;
+
+	if (prev == UINT_MAX || next_freq >= prev)
+		return next_freq;
+
+	if (!tunables->down_step_pct || tunables->down_step_pct >= 100)
+		return next_freq;
+
+	range = policy->cpuinfo.max_freq - policy->cpuinfo.min_freq;
+	max_drop = max(1U, range * tunables->down_step_pct / 100);
+
+	if (prev - next_freq > max_drop)
+		next_freq = prev - max_drop;
+
+	return clamp_val(next_freq, policy->min, policy->max);
+}
+
+static void pxgov_update_commit(struct pxgov_policy *px_policy,
+				u64 time, unsigned int next_freq)
+{
+	struct cpufreq_policy *policy = px_policy->policy;
+
+	next_freq = pxgov_limit_down_step(px_policy, next_freq);
+
+	if (px_policy->next_freq == next_freq)
+		return;
+
+	if (pxgov_up_down_rate_limit(px_policy, time, next_freq))
+		return;
+
+	px_policy->next_freq = next_freq;
+	px_policy->last_freq_update_time = time;
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	{
+		int cid = arch_get_cluster_id(policy->cpu);
+
+		mt_cpufreq_set_by_wfi_load_cluster(cid, next_freq);
+		policy->cur = next_freq;
+		trace_sched_util(cid, next_freq, time);
+	}
+#else
+	if (policy->fast_switch_enabled) {
+		next_freq = cpufreq_driver_fast_switch(policy, next_freq);
+		if (!next_freq)
+			return;
+
+		policy->cur = next_freq;
+		trace_cpu_frequency(next_freq, smp_processor_id());
+	} else {
+		px_policy->work_in_progress = true;
+		irq_work_queue(&px_policy->irq_work);
+	}
+#endif
+}
+
+static void pxgov_get_util(unsigned long *util, unsigned long *max, int cpu)
+{
+	unsigned long max_cap = arch_scale_cpu_capacity(NULL, cpu);
+
+	*util = boosted_cpu_util(cpu);
+	if (idle_cpu(cpu))
+		*util = 0;
+
+	*util = min(*util, max_cap);
+	*max = max_cap;
+}
+
+static unsigned long pxgov_freq_to_util(struct cpufreq_policy *policy,
+					unsigned int freq, unsigned long max)
+{
+	u64 util;
+
+	if (!freq || !policy->cpuinfo.max_freq)
+		return 0;
+
+	util = (u64)freq * max;
+	util /= policy->cpuinfo.max_freq;
+
+	return min_t(unsigned long, util, max);
+}
+
+static unsigned long pxgov_predict_util(struct pxgov_cpu *px_cpu,
+					unsigned long util, unsigned long max,
+					struct pxgov_tunables *tunables)
+{
+	unsigned long predicted, trend = 0;
+	unsigned int shift = clamp_val(tunables->decay_shift, 1U, 8U);
+
+	if (util > px_cpu->prev_util)
+		trend = util - px_cpu->prev_util;
+
+	if (!px_cpu->smooth_util)
+		px_cpu->smooth_util = util;
+	else if (util >= px_cpu->smooth_util)
+		px_cpu->smooth_util = util;
+	else
+		px_cpu->smooth_util -= (px_cpu->smooth_util - util) >> shift;
+
+	predicted = px_cpu->smooth_util + (trend >> 1);
+	predicted = min(predicted, max);
+
+	px_cpu->prev_util = util;
+	px_cpu->trend_util = trend;
+
+	return predicted;
+}
+
+static void pxgov_set_iowait_boost(struct pxgov_cpu *px_cpu, u64 time,
+				   unsigned int flags)
+{
+	struct pxgov_tunables *tunables = px_cpu->px_policy->tunables;
+	unsigned int max_boost;
+
+	if (!tunables->iowait_boost_enable) {
+		px_cpu->iowait_boost = 0;
+		px_cpu->iowait_boost_pending = false;
+		return;
+	}
+
+	if (flags & SCHED_CPUFREQ_IOWAIT) {
+		if (px_cpu->iowait_boost_pending)
+			return;
+
+		px_cpu->iowait_boost_pending = true;
+		max_boost = uclamp_util(cpu_rq(px_cpu->cpu),
+					 px_cpu->iowait_boost_max);
+
+		if (px_cpu->iowait_boost) {
+			px_cpu->iowait_boost <<= 1;
+			if (px_cpu->iowait_boost > max_boost)
+				px_cpu->iowait_boost = max_boost;
+		} else {
+			px_cpu->iowait_boost = max(px_cpu->min_boost,
+						      (unsigned long)PX_IOWAIT_BOOST_MIN);
+		}
+	} else if (px_cpu->iowait_boost) {
+		s64 delta_ns = time - px_cpu->last_update;
+
+		if (delta_ns > TICK_NSEC) {
+			px_cpu->iowait_boost = 0;
+			px_cpu->iowait_boost_pending = false;
+		}
+	}
+}
+
+static void pxgov_iowait_boost(struct pxgov_cpu *px_cpu,
+			       unsigned long *util, unsigned long *max)
+{
+	unsigned int boost_util, boost_max;
+
+	if (!px_cpu->iowait_boost)
+		return;
+
+	if (px_cpu->iowait_boost_pending) {
+		px_cpu->iowait_boost_pending = false;
+	} else {
+		px_cpu->iowait_boost >>= 1;
+		if (px_cpu->iowait_boost < px_cpu->min_boost) {
+			px_cpu->iowait_boost = 0;
+			return;
+		}
+	}
+
+	boost_util = px_cpu->iowait_boost;
+	boost_max = px_cpu->iowait_boost_max;
+
+	if (*util * boost_max < *max * boost_util) {
+		*util = boost_util;
+		*max = boost_max;
+	}
+}
+
+#ifdef CONFIG_NO_HZ_COMMON
+static bool pxgov_cpu_is_busy(struct pxgov_cpu *px_cpu)
+{
+	unsigned long idle_calls = tick_nohz_get_idle_calls_cpu(px_cpu->cpu);
+	bool ret = idle_calls == px_cpu->saved_idle_calls;
+
+	px_cpu->saved_idle_calls = idle_calls;
+	return ret;
+}
+#else
+static inline bool pxgov_cpu_is_busy(struct pxgov_cpu *px_cpu)
+{
+	return false;
+}
+#endif
+
+static unsigned int pxgov_resolve_freq(struct pxgov_policy *px_policy,
+				       unsigned int freq)
+{
+	struct cpufreq_policy *policy = px_policy->policy;
+
+	freq = clamp_val(freq, policy->min, policy->max);
+	px_policy->cached_raw_freq = freq;
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	{
+		int cid = arch_get_cluster_id(policy->cpu);
+
+		return mt_cpufreq_find_close_freq(cid, freq);
+	}
+#else
+	return cpufreq_driver_resolve_freq(policy, freq);
+#endif
+}
+
+static unsigned int pxgov_choose_freq(struct pxgov_policy *px_policy,
+				      unsigned long util, unsigned long max,
+				      bool hold, u64 time)
+{
+	struct cpufreq_policy *policy = px_policy->policy;
+	struct pxgov_tunables *tunables = px_policy->tunables;
+	unsigned int target_load = clamp_val(tunables->target_load, 1U, 100U);
+	unsigned int load, ref_freq, freq, hispeed_freq;
+	u64 raw;
+
+	if (!max)
+		return policy->min;
+
+	load = min_t(unsigned int, 100, util * 100 / max);
+	ref_freq = arch_scale_freq_invariant() ? policy->cpuinfo.max_freq : policy->cur;
+	if (!ref_freq)
+		ref_freq = policy->cpuinfo.max_freq;
+
+	raw = (u64)ref_freq * util * 100;
+	raw /= max * target_load;
+
+	if (load >= tunables->hispeed_load) {
+		hispeed_freq = tunables->hispeed_freq;
+		if (!hispeed_freq)
+			hispeed_freq = policy->cpuinfo.max_freq * 78 / 100;
+		raw = max_t(u64, raw, hispeed_freq);
+	}
+
+	if (load >= 55)
+		raw += raw * tunables->boost_margin / 100;
+	else if (tunables->boost_margin)
+		raw -= raw * (tunables->boost_margin / 2) / 100;
+
+	freq = clamp_val((unsigned int)raw, policy->min, policy->max);
+
+	if (hold && px_policy->next_freq != UINT_MAX && freq < px_policy->next_freq)
+		freq = px_policy->next_freq;
+
+	return pxgov_resolve_freq(px_policy, freq);
+}
+
+static void pxgov_note_frame_hold(struct pxgov_policy *px_policy,
+				  struct pxgov_cpu *px_cpu,
+				  unsigned long util, unsigned long max,
+				  u64 time)
+{
+	struct pxgov_tunables *tunables = px_policy->tunables;
+	unsigned int load;
+
+	if (!max || !px_policy->frame_hold_ns)
+		return;
+
+	load = min_t(unsigned int, 100, util * 100 / max);
+
+	if (load >= tunables->hispeed_load ||
+	    px_cpu->trend_util * 100 / max >= tunables->boost_margin)
+		px_cpu->frame_boost_until = time + px_policy->frame_hold_ns;
+}
+
+static void pxgov_update_single(struct update_util_data *hook,
+				u64 time, unsigned int flags)
+{
+	struct pxgov_cpu *px_cpu = container_of(hook, struct pxgov_cpu, update_util);
+	struct pxgov_policy *px_policy = px_cpu->px_policy;
+	struct cpufreq_policy *policy = px_policy->policy;
+	unsigned long util, max;
+	unsigned int next_f;
+	bool busy, hold;
+
+	pxgov_set_iowait_boost(px_cpu, time, flags);
+	px_cpu->last_update = time;
+
+	if (!pxgov_should_update_freq(px_policy, time))
+		return;
+
+	busy = pxgov_cpu_is_busy(px_cpu);
+
+	if (flags & SCHED_CPUFREQ_DL) {
+		next_f = policy->cpuinfo.max_freq;
+	} else {
+		pxgov_get_util(&util, &max, px_cpu->cpu);
+		util = uclamp_util(cpu_rq(px_cpu->cpu), util);
+		util = pxgov_predict_util(px_cpu, util, max, px_policy->tunables);
+		pxgov_iowait_boost(px_cpu, &util, &max);
+		pxgov_note_frame_hold(px_policy, px_cpu, util, max, time);
+
+		hold = time < px_cpu->frame_boost_until;
+		next_f = pxgov_choose_freq(px_policy, util, max, hold, time);
+
+		if (busy && next_f < px_policy->next_freq &&
+		    px_policy->next_freq != UINT_MAX) {
+			next_f = px_policy->next_freq;
+			px_policy->cached_raw_freq = 0;
+		}
+	}
+
+	pxgov_update_commit(px_policy, time, next_f);
+}
+
+static unsigned int pxgov_next_freq_shared(struct pxgov_cpu *px_cpu, u64 time)
+{
+	struct pxgov_policy *px_policy = px_cpu->px_policy;
+	struct cpufreq_policy *policy = px_policy->policy;
+	unsigned long util = 0, max = 1;
+	unsigned int j;
+	bool hold = false;
+
+	for_each_cpu(j, policy->cpus) {
+		struct pxgov_cpu *j_px_cpu = &per_cpu(pxgov_cpu, j);
+		unsigned long j_util, j_max;
+		s64 delta_ns;
+
+		delta_ns = time - j_px_cpu->last_update;
+		if (delta_ns > TICK_NSEC) {
+			j_px_cpu->iowait_boost = 0;
+			j_px_cpu->iowait_boost_pending = false;
+			if (idle_cpu(j))
+				continue;
+		}
+
+		if (j_px_cpu->flags & SCHED_CPUFREQ_DL)
+			return policy->cpuinfo.max_freq;
+
+		j_util = j_px_cpu->util;
+		j_max = j_px_cpu->max;
+		j_util = uclamp_util(cpu_rq(j), j_util);
+		j_util = pxgov_predict_util(j_px_cpu, j_util, j_max,
+					       px_policy->tunables);
+		pxgov_iowait_boost(j_px_cpu, &j_util, &j_max);
+		pxgov_note_frame_hold(px_policy, j_px_cpu, j_util, j_max, time);
+
+		if (time < j_px_cpu->frame_boost_until)
+			hold = true;
+
+		if (j_util * max > j_max * util) {
+			util = j_util;
+			max = j_max;
+		}
+	}
+
+	return pxgov_choose_freq(px_policy, util, max, hold, time);
+}
+
+static void pxgov_update_shared(struct update_util_data *hook,
+				u64 time, unsigned int flags)
+{
+	struct pxgov_cpu *px_cpu = container_of(hook, struct pxgov_cpu, update_util);
+	struct pxgov_policy *px_policy = px_cpu->px_policy;
+	unsigned long util, max;
+	unsigned int next_f;
+
+	pxgov_get_util(&util, &max, px_cpu->cpu);
+
+	raw_spin_lock(&px_policy->update_lock);
+
+	px_cpu->util = util;
+	px_cpu->max = max;
+	px_cpu->flags = flags;
+	pxgov_set_iowait_boost(px_cpu, time, flags);
+	px_cpu->last_update = time;
+
+	if (pxgov_should_update_freq(px_policy, time)) {
+		if (flags & SCHED_CPUFREQ_DL)
+			next_f = px_policy->policy->cpuinfo.max_freq;
+		else
+			next_f = pxgov_next_freq_shared(px_cpu, time);
+
+		pxgov_update_commit(px_policy, time, next_f);
+	}
+
+	raw_spin_unlock(&px_policy->update_lock);
+}
+
+static void pxgov_work(struct kthread_work *work)
+{
+	struct pxgov_policy *px_policy = container_of(work, struct pxgov_policy, work);
+
+	mutex_lock(&px_policy->work_lock);
+	__cpufreq_driver_target(px_policy->policy, px_policy->next_freq,
+				CPUFREQ_RELATION_L);
+	mutex_unlock(&px_policy->work_lock);
+
+	px_policy->work_in_progress = false;
+}
+
+static void pxgov_irq_work(struct irq_work *irq_work)
+{
+	struct pxgov_policy *px_policy;
+
+	px_policy = container_of(irq_work, struct pxgov_policy, irq_work);
+	kthread_queue_work(&px_policy->worker, &px_policy->work);
+}
