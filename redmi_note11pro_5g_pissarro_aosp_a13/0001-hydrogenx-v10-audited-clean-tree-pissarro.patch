diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index 000000000000..000000000000 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -77,6 +77,19 @@ config CPU_FREQ_DEFAULT_GOV_SCHEDUTIL
 
 	  Use the 'schedutil' CPUFreq governor by default. If unsure,
 	  have a look at the help section of that governor. The fallback
 	  governor will be 'performance'.
+
+config CPU_FREQ_DEFAULT_GOV_HYDROGENX
+	bool "hydrogenx"
+	depends on SMP
+	select CPU_FREQ_GOV_HYDROGENX
+	select CPU_FREQ_GOV_PERFORMANCE
+	help
+	  Use the 'hydrogenx' CPUFreq governor by default.
+
+	  This governor is tuned for Android phones that need fast response
+	  under UI/game bursts, but also need slower ramp-down and optional
+	  powersave bias to reduce frequency bouncing and heat.
+	  The fallback governor will be 'performance'.
 
 endchoice
@@ -148,4 +161,28 @@ config CPU_FREQ_GOV_SCHEDUTIL
 
 	  If in doubt, say N.
+
+config CPU_FREQ_GOV_HYDROGENX
+	bool "'hydrogenx' cpufreq policy governor"
+	depends on CPU_FREQ && SMP
+	select CPU_FREQ_GOV_COMMON
+	default y
+	help
+	  'hydrogenx' is a third-party Android-oriented dynamic cpufreq
+	  governor.  It uses the common dbs governor framework, and v10 can
+	  read the global HydrogenX boost scene controller for input, frame,
+	  GPU, DDR and IO boost floors.
+
+	  The policy prefers:
+	  - fast ramp-up when CPU load crosses up_threshold;
+	  - schedutil-like fast reaction via boost floors;
+	  - a configurable hispeed floor for frame-sensitive loads;
+	  - delayed ramp-down through min_sample_time to reduce FPS jitter;
+	  - optional powersave_bias for lower heat and power at light load;
+	  - userspace boostpulse support for game/touch/performance daemons.
+
+	  Tunables are exported below the governor sysfs directory and global
+	  boost scene knobs are under /sys/kernel/hydrogenx/.
+
+	  If in doubt, say N.
 
 comment "CPU frequency scaling drivers"

diff --git a/drivers/cpufreq/Makefile b/drivers/cpufreq/Makefile
index 000000000000..000000000000 100644
--- a/drivers/cpufreq/Makefile
+++ b/drivers/cpufreq/Makefile
@@ -13,7 +13,12 @@ obj-$(CONFIG_CPU_FREQ_GOV_USERSPACE)      += cpufreq_userspace.o
 obj-$(CONFIG_CPU_FREQ_GOV_ONDEMAND)       += cpufreq_ondemand.o
 obj-$(CONFIG_CPU_FREQ_GOV_CONSERVATIVE)   += cpufreq_conservative.o
 obj-$(CONFIG_CPU_FREQ_GOV_INTERACTIVE)    += cpufreq_interactive.o
+# HydrogenX depends on the dbs governor common code.  Do not force-build it
+# with CONFIG_CPU_FREQ alone, otherwise custom configs that do not select
+# CPU_FREQ_GOV_COMMON can fail at link time.  Clean pissarro defconfigs below
+# select CPU_FREQ_GOV_HYDROGENX, which in turn selects the common governor core.
+obj-$(CONFIG_CPU_FREQ_GOV_HYDROGENX)      += cpufreq_hydrogenx.o
 obj-$(CONFIG_CPU_FREQ_GOV_COMMON)         += cpufreq_governor.o
 obj-$(CONFIG_CPU_FREQ_GOV_ATTR_SET)       += cpufreq_governor_attr_set.o
 
 obj-$(CONFIG_CPUFREQ_DT)                  += cpufreq-dt.o

diff --git a/drivers/cpufreq/cpufreq_hydrogenx.c b/drivers/cpufreq/cpufreq_hydrogenx.c
new file mode 100644
index 000000000000..000000000000
--- /dev/null
+++ b/drivers/cpufreq/cpufreq_hydrogenx.c
@@ -0,0 +1,1045 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * drivers/cpufreq/cpufreq_hydrogenx.c
+ *
+ * HydrogenX cpufreq governor for Android 4.14 kernels.
+ *
+ * v10 fuses the v2 game governor with a global boost/input scene engine
+ * and schedtune/MTK weak bridges. It keeps direct cpufreq decisions local
+ * while allowing input, frame, GPU, DDR and IO scenes to raise frequency
+ * floors without userspace touching each policy directory.
+ *
+ * v10 is intentionally more aggressive than the safe baseline:
+ * - shorter effective sampling under boosts;
+ * - game/profile floors;
+ * - separate input, frame and generic boost pulses;
+ * - smoothed load to reduce FPS jitter;
+ * - delayed downscale and optional powersave bias for lower heat.
+ *
+ * It still uses the stock dbs governor framework, and private MTK hooks are
+ * wired through weak bridge symbols so missing vendor exports do not break
+ * the build.
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/jiffies.h>
+#include <linux/hydrogenx_boost.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+#include "cpufreq_governor.h"
+
+#define HYDROGENX_PROFILE_BALANCED        0
+#define HYDROGENX_PROFILE_GAME            1
+#define HYDROGENX_PROFILE_BATTERY         2
+
+#define HYDROGENX_DEF_UP_THRESHOLD        82
+#define HYDROGENX_DEF_DOWN_THRESHOLD      32
+#define HYDROGENX_DEF_HISPEED_LOAD        58
+#define HYDROGENX_DEF_MAX_PERF_LOAD       88
+#define HYDROGENX_DEF_LOW_POWER_LOAD      18
+#define HYDROGENX_DEF_MIN_SAMPLE_TIME_MS  72
+#define HYDROGENX_DEF_POWERSAVE_BIAS      80
+#define HYDROGENX_DEF_BOOST_DURATION_MS   180
+#define HYDROGENX_DEF_INPUT_BOOST_MS      80
+#define HYDROGENX_DEF_FRAME_BOOST_MS      260
+#define HYDROGENX_DEF_LOAD_SMOOTHING      35
+
+#define HYDROGENX_MAX_POWERSAVE_BIAS      1000
+#define HYDROGENX_MAX_MIN_SAMPLE_TIME_MS  2000
+#define HYDROGENX_MAX_BOOST_DURATION_MS   10000
+#define HYDROGENX_MAX_LOAD_SMOOTHING      95
+
+struct hyd_dbs_tuners {
+	unsigned int profile;
+	unsigned int game_mode;
+	unsigned int down_threshold;
+	unsigned int hispeed_load;
+	unsigned int hispeed_freq;
+	unsigned int max_perf_load;
+	unsigned int low_power_load;
+	unsigned int min_sample_time;
+	unsigned int powersave_bias;
+	unsigned int load_smoothing;
+	unsigned int fast_ramp_down;
+	unsigned int boost_duration_ms;
+	unsigned int boost_freq;
+	unsigned int input_boost_ms;
+	unsigned int input_boost_freq;
+	unsigned int frame_boost_ms;
+	unsigned int frame_min_freq;
+	unsigned int game_min_freq;
+};
+
+enum hyd_pulse_type {
+	HYD_PULSE_GENERIC,
+	HYD_PULSE_INPUT,
+	HYD_PULSE_FRAME,
+};
+
+struct hyd_policy_dbs_info {
+	struct policy_dbs_info policy_dbs;
+	unsigned long last_freq_update_jiffies;
+	unsigned long boost_until;
+	unsigned long input_boost_until;
+	unsigned long frame_boost_until;
+	unsigned int smoothed_load;
+	unsigned int last_target_freq;
+};
+
+static inline struct hyd_policy_dbs_info *to_hyd_policy_dbs_info(struct policy_dbs_info *policy_dbs)
+{
+	return container_of(policy_dbs, struct hyd_policy_dbs_info, policy_dbs);
+}
+
+static int hyd_parse_uint(const char *buf, unsigned int *input)
+{
+	int ret;
+
+	ret = sscanf(buf, "%u", input);
+	return ret == 1 ? 0 : -EINVAL;
+}
+
+static unsigned int hyd_clamp_freq(struct cpufreq_policy *policy, unsigned int freq)
+{
+	return clamp_t(unsigned int, freq, policy->min, policy->max);
+}
+
+static bool hyd_time_active(unsigned long until)
+{
+	return until && time_before(jiffies, until);
+}
+
+static unsigned int hyd_pick_hispeed(struct cpufreq_policy *policy,
+				     struct hyd_dbs_tuners *tuners)
+{
+	unsigned int hispeed;
+
+	if (tuners->hispeed_freq)
+		hispeed = tuners->hispeed_freq;
+	else
+		hispeed = policy->min + (policy->max - policy->min) * 72 / 100;
+
+	return hyd_clamp_freq(policy, hispeed);
+}
+
+static unsigned int hyd_pick_floor(struct cpufreq_policy *policy,
+				   struct hyd_dbs_tuners *tuners,
+				   struct hyd_policy_dbs_info *hyd_info)
+{
+	unsigned int floor = policy->min;
+	unsigned int hispeed = hyd_pick_hispeed(policy, tuners);
+	struct hydrogenx_boost_state hx_state;
+
+	hydrogenx_boost_get_state(&hx_state);
+
+	if (hx_state.boost)
+		floor = max_t(unsigned int, floor, policy->max);
+
+	if (hx_state.input)
+		floor = max_t(unsigned int, floor, hispeed);
+
+	if (hx_state.frame || hx_state.gpu || hx_state.ddr || hx_state.io)
+		floor = max_t(unsigned int, floor, hispeed);
+
+	if (hx_state.floor_freq)
+		floor = max_t(unsigned int, floor, hx_state.floor_freq);
+
+	if (hx_state.floor_pct)
+		floor = max_t(unsigned int, floor,
+			policy->min + (policy->max - policy->min) *
+			min_t(unsigned int, hx_state.floor_pct, 100) / 100);
+
+	if (hx_state.game_mode ||
+	    hx_state.profile == HYDROGENX_BOOST_PROFILE_GAME)
+		floor = max_t(unsigned int, floor,
+			tuners->game_min_freq ? tuners->game_min_freq : hispeed);
+
+	if (hyd_time_active(hyd_info->boost_until))
+		floor = max_t(unsigned int, floor,
+				  tuners->boost_freq ? tuners->boost_freq : policy->max);
+
+	if (hyd_time_active(hyd_info->input_boost_until))
+		floor = max_t(unsigned int, floor,
+				  tuners->input_boost_freq ? tuners->input_boost_freq : hispeed);
+
+	if (hyd_time_active(hyd_info->frame_boost_until))
+		floor = max_t(unsigned int, floor,
+				  tuners->frame_min_freq ? tuners->frame_min_freq : hispeed);
+
+	if (tuners->game_mode || tuners->profile == HYDROGENX_PROFILE_GAME)
+		floor = max_t(unsigned int, floor,
+				  tuners->game_min_freq ? tuners->game_min_freq : hispeed);
+
+	return hyd_clamp_freq(policy, floor);
+}
+
+static unsigned int hyd_effective_up_threshold(struct hyd_dbs_tuners *tuners,
+					       unsigned int up_threshold)
+{
+	if (tuners->game_mode || tuners->profile == HYDROGENX_PROFILE_GAME)
+		return min_t(unsigned int, up_threshold, 72);
+
+	if (tuners->profile == HYDROGENX_PROFILE_BATTERY)
+		return max_t(unsigned int, up_threshold, 90);
+
+	return up_threshold;
+}
+
+static unsigned int hyd_effective_hispeed_load(struct hyd_dbs_tuners *tuners)
+{
+	if (tuners->game_mode || tuners->profile == HYDROGENX_PROFILE_GAME)
+		return min_t(unsigned int, tuners->hispeed_load, 45);
+
+	if (tuners->profile == HYDROGENX_PROFILE_BATTERY)
+		return max_t(unsigned int, tuners->hispeed_load, 72);
+
+	return tuners->hispeed_load;
+}
+
+static unsigned int hyd_effective_powersave_bias(struct hyd_dbs_tuners *tuners,
+						 bool protected_boost)
+{
+	if (protected_boost || tuners->game_mode ||
+	    tuners->profile == HYDROGENX_PROFILE_GAME)
+		return 0;
+
+	if (tuners->profile == HYDROGENX_PROFILE_BATTERY)
+		return min_t(unsigned int, tuners->powersave_bias + 180,
+			     HYDROGENX_MAX_POWERSAVE_BIAS);
+
+	return tuners->powersave_bias;
+}
+
+static unsigned int hyd_effective_down_hold(struct hyd_dbs_tuners *tuners,
+					    bool frame_boost)
+{
+	unsigned int hold = tuners->min_sample_time;
+
+	if (tuners->game_mode || tuners->profile == HYDROGENX_PROFILE_GAME)
+		hold = max_t(unsigned int, hold, 90);
+
+	if (frame_boost)
+		hold = max_t(unsigned int, hold, tuners->frame_boost_ms);
+
+	if (tuners->profile == HYDROGENX_PROFILE_BATTERY)
+		hold = min_t(unsigned int, hold, 48);
+
+	return hold;
+}
+
+static unsigned int hyd_smooth_load(struct hyd_policy_dbs_info *hyd_info,
+				    struct hyd_dbs_tuners *tuners,
+				    unsigned int load)
+{
+	unsigned int smooth = tuners->load_smoothing;
+
+	if (!smooth || !hyd_info->smoothed_load) {
+		hyd_info->smoothed_load = load;
+		return load;
+	}
+
+	hyd_info->smoothed_load = (hyd_info->smoothed_load * smooth +
+				 load * (100 - smooth)) / 100;
+
+	if (load > hyd_info->smoothed_load)
+		hyd_info->smoothed_load = max_t(unsigned int,
+					       hyd_info->smoothed_load, load - 5);
+
+	return min_t(unsigned int, hyd_info->smoothed_load, 100);
+}
+
+static unsigned int hyd_target_freq(struct cpufreq_policy *policy,
+				    unsigned int load)
+{
+	unsigned int min_f = policy->cpuinfo.min_freq;
+	unsigned int max_f = policy->cpuinfo.max_freq;
+
+	min_f = max(min_f, policy->min);
+	max_f = min(max_f, policy->max);
+
+	if (unlikely(max_f <= min_f))
+		return policy->min;
+
+	return min_f + load * (max_f - min_f) / 100;
+}
+
+static unsigned int hyd_apply_powersave_bias(struct cpufreq_policy *policy,
+					    unsigned int target,
+					    unsigned int bias)
+{
+	if (!bias || target <= policy->min)
+		return target;
+
+	if (bias > HYDROGENX_MAX_POWERSAVE_BIAS)
+		bias = HYDROGENX_MAX_POWERSAVE_BIAS;
+
+	target = policy->min +
+		(target - policy->min) * (HYDROGENX_MAX_POWERSAVE_BIAS - bias) /
+		HYDROGENX_MAX_POWERSAVE_BIAS;
+
+	return hyd_clamp_freq(policy, target);
+}
+
+static void hyd_set_target(struct cpufreq_policy *policy,
+			   unsigned int target,
+			   unsigned int relation,
+			   unsigned int down_hold_ms)
+{
+	struct policy_dbs_info *policy_dbs = policy->governor_data;
+	struct dbs_data *dbs_data = policy_dbs->dbs_data;
+	struct hyd_dbs_tuners *tuners = dbs_data->tuners;
+	struct hyd_policy_dbs_info *hyd_info;
+	unsigned long hold_time;
+
+	target = hyd_clamp_freq(policy, target);
+	hyd_info = to_hyd_policy_dbs_info(policy_dbs);
+
+	if (target < policy->cur && !tuners->fast_ramp_down && down_hold_ms) {
+		hold_time = msecs_to_jiffies(down_hold_ms);
+		if (time_before(jiffies,
+				hyd_info->last_freq_update_jiffies + hold_time))
+			return;
+	}
+
+	if (policy->cur == target)
+		return;
+
+	__cpufreq_driver_target(policy, target, relation);
+	hyd_info->last_freq_update_jiffies = jiffies;
+	hyd_info->last_target_freq = target;
+}
+
+static unsigned int hyd_next_delay(struct dbs_data *dbs_data, bool urgent)
+{
+	unsigned int rate = dbs_data->sampling_rate;
+
+	if (!rate)
+		return 10000;
+
+	if (urgent && rate > 4000)
+		return max_t(unsigned int, rate / 2, 4000);
+
+	return rate;
+}
+
+static unsigned int hyd_dbs_update(struct cpufreq_policy *policy)
+{
+	struct policy_dbs_info *policy_dbs = policy->governor_data;
+	struct hyd_policy_dbs_info *hyd_info = to_hyd_policy_dbs_info(policy_dbs);
+	struct dbs_data *dbs_data = policy_dbs->dbs_data;
+	struct hyd_dbs_tuners *tuners = dbs_data->tuners;
+	unsigned int load, raw_load, target, hispeed, floor;
+	unsigned int up_threshold, hispeed_load, bias, down_hold;
+	bool generic_boost, input_boost, frame_boost, protected_boost;
+	struct hydrogenx_boost_state hx_state;
+
+	hydrogenx_boost_get_state(&hx_state);
+
+	raw_load = dbs_update(policy);
+	load = hyd_smooth_load(hyd_info, tuners, raw_load);
+
+	generic_boost = hyd_time_active(hyd_info->boost_until) || hx_state.boost;
+	input_boost = hyd_time_active(hyd_info->input_boost_until) || hx_state.input;
+	frame_boost = hyd_time_active(hyd_info->frame_boost_until) ||
+		hx_state.frame || hx_state.gpu || hx_state.ddr || hx_state.io;
+	protected_boost = generic_boost || input_boost || frame_boost ||
+		hx_state.game_mode ||
+		hx_state.profile == HYDROGENX_BOOST_PROFILE_GAME;
+
+	floor = hyd_pick_floor(policy, tuners, hyd_info);
+	hispeed = hyd_pick_hispeed(policy, tuners);
+	up_threshold = hyd_effective_up_threshold(tuners, dbs_data->up_threshold);
+	hispeed_load = hyd_effective_hispeed_load(tuners);
+	bias = hyd_effective_powersave_bias(tuners, protected_boost);
+	down_hold = hyd_effective_down_hold(tuners, frame_boost);
+
+	if (hx_state.game_mode ||
+	    hx_state.profile == HYDROGENX_BOOST_PROFILE_GAME) {
+		up_threshold = min_t(unsigned int, up_threshold, 68);
+		hispeed_load = min_t(unsigned int, hispeed_load, 40);
+		bias = 0;
+		down_hold = max_t(unsigned int, down_hold, 120);
+	} else if (hx_state.profile == HYDROGENX_BOOST_PROFILE_BATTERY) {
+		up_threshold = max_t(unsigned int, up_threshold, 90);
+		hispeed_load = max_t(unsigned int, hispeed_load, 72);
+	}
+
+	if (hx_state.io)
+		dbs_data->io_is_busy = 1;
+
+	if (generic_boost) {
+		hyd_set_target(policy, floor, CPUFREQ_RELATION_L, down_hold);
+		return hyd_next_delay(dbs_data, true);
+	}
+
+	if (raw_load >= tuners->max_perf_load || load >= tuners->max_perf_load) {
+		policy_dbs->rate_mult = 1;
+		hyd_set_target(policy, policy->max, CPUFREQ_RELATION_H, down_hold);
+		return hyd_next_delay(dbs_data, true);
+	}
+
+	if (raw_load >= up_threshold || load >= up_threshold) {
+		policy_dbs->rate_mult = 1;
+		target = max_t(unsigned int, hyd_target_freq(policy, max(raw_load, load)), hispeed);
+		target = max(target, floor);
+		hyd_set_target(policy, target, CPUFREQ_RELATION_L, down_hold);
+		return hyd_next_delay(dbs_data, input_boost || frame_boost);
+	}
+
+	target = hyd_target_freq(policy, load);
+
+	if (raw_load >= hispeed_load || load >= hispeed_load)
+		target = max(target, hispeed);
+
+	if (load <= tuners->down_threshold || raw_load <= tuners->low_power_load)
+		target = hyd_apply_powersave_bias(policy, target, bias);
+
+	target = max(target, floor);
+
+	if (target > policy->cur)
+		hyd_set_target(policy, target, CPUFREQ_RELATION_L, down_hold);
+	else if (target < policy->cur)
+		hyd_set_target(policy, target, CPUFREQ_RELATION_H, down_hold);
+	else
+		hyd_set_target(policy, target, CPUFREQ_RELATION_C, down_hold);
+
+	return hyd_next_delay(dbs_data, input_boost || frame_boost);
+}
