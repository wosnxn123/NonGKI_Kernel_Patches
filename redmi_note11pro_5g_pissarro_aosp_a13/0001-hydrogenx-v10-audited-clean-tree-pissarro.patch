diff --git a/scripts/hydrogenx/verify-hydrogenx.sh b/scripts/hydrogenx/verify-hydrogenx.sh
new file mode 100755
index 000000000000..000000000000
--- /dev/null
+++ b/scripts/hydrogenx/verify-hydrogenx.sh
@@ -0,0 +1,68 @@
+#!/system/bin/sh
+# HydrogenX v10 runtime verifier for Android shells.
+# This script is optional. The kernel patch does not require it to boot.
+
+HX=/sys/kernel/hydrogenx
+CPUFREQ=/sys/devices/system/cpu/cpufreq
+fail=0
+
+say() { echo "[hydrogenx-verify] $*"; }
+err() { echo "[hydrogenx-verify][FAIL] $*"; fail=1; }
+warn() { echo "[hydrogenx-verify][WARN] $*"; }
+
+say "checking global controller"
+if [ ! -d "$HX" ]; then
+    err "$HX is missing; CONFIG_HYDROGENX_BOOST did not initialize"
+else
+    [ -f "$HX/version" ] && say "version=$(cat $HX/version)" || err "version node missing"
+    [ -f "$HX/builtins" ] && say "builtins=$(cat $HX/builtins)" || warn "builtins node missing"
+    [ -f "$HX/status" ] && cat "$HX/status" || warn "status node missing"
+fi
+
+say "checking cpufreq policies"
+for p in "$CPUFREQ"/policy*; do
+    [ -d "$p" ] || continue
+    govs="$p/scaling_available_governors"
+    cur="$p/scaling_governor"
+    if [ ! -f "$govs" ]; then
+        err "$p has no scaling_available_governors"
+        continue
+    fi
+    list=$(cat "$govs")
+    say "$p governors=$list"
+    echo "$list" | grep -qw hydrogenx || err "$p missing hydrogenx governor"
+    if echo "$list" | grep -qw hydrogenx; then
+        old=$(cat "$cur" 2>/dev/null)
+        echo hydrogenx > "$cur" 2>/dev/null || err "$p cannot switch to hydrogenx"
+        new=$(cat "$cur" 2>/dev/null)
+        say "$p active=$new old=$old"
+        [ -d "$p/hydrogenx" ] || warn "$p/hydrogenx tunable dir missing; global governor mode may be used"
+    fi
+ done
+
+say "checking scene pulses"
+if [ -d "$HX" ]; then
+    for n in boostpulse input_boostpulse frame_boost gpu_boost ddr_boost io_boost; do
+        if [ -f "$HX/$n" ]; then
+            echo 1 > "$HX/$n" 2>/dev/null || warn "cannot write $n"
+            say "wrote $n"
+        else
+            warn "$n node missing"
+        fi
+    done
+    [ -f "$HX/status" ] && cat "$HX/status"
+fi
+
+say "checking f2fs/erofs/zram configs from /proc/config.gz if present"
+if [ -f /proc/config.gz ]; then
+    zcat /proc/config.gz | grep -E "CONFIG_(CPU_FREQ_GOV_HYDROGENX|HYDROGENX_BOOST|F2FS_FS_COMPRESSION|EROFS_FS_ZIP|ZRAM_WRITEBACK|LZ4|ZSTD|TCP_CONG_BBR)" || warn "no matching config lines found"
+else
+    warn "/proc/config.gz unavailable"
+fi
+
+if [ "$fail" -eq 0 ]; then
+    say "PASS"
+else
+    say "FAIL"
+fi
+exit "$fail"
diff --git a/scripts/hydrogenx/apply-gaming-profile.sh b/scripts/hydrogenx/apply-gaming-profile.sh
new file mode 100755
index 000000000000..000000000000
--- /dev/null
+++ b/scripts/hydrogenx/apply-gaming-profile.sh
@@ -0,0 +1,40 @@
+#!/system/bin/sh
+# Optional HydrogenX v10 gaming profile helper.
+# It writes every policy that exists; missing nodes are skipped safely.
+
+HX=/sys/kernel/hydrogenx
+CPUFREQ=/sys/devices/system/cpu/cpufreq
+write_if() { [ -f "$1" ] && echo "$2" > "$1" 2>/dev/null; }
+
+write_if "$HX/profile" 1
+write_if "$HX/game_mode" 1
+write_if "$HX/sched_boost" 18
+write_if "$HX/uclamp_min" 18
+write_if "$HX/floor_pct" 45
+write_if "$HX/boost_floor_pct" 82
+write_if "$HX/input_hook" 1
+write_if "$HX/boostpulse" 1
+write_if "$HX/frame_boost" 1
+write_if "$HX/gpu_boost" 1
+write_if "$HX/ddr_boost" 1
+
+for p in "$CPUFREQ"/policy*; do
+    [ -d "$p" ] || continue
+    write_if "$p/scaling_governor" hydrogenx
+    H="$p/hydrogenx"
+    [ -d "$H" ] || continue
+    write_if "$H/profile" 1
+    write_if "$H/game_mode" 1
+    write_if "$H/sampling_rate" 6000
+    write_if "$H/up_threshold" 72
+    write_if "$H/down_threshold" 24
+    write_if "$H/hispeed_load" 45
+    write_if "$H/max_perf_load" 88
+    write_if "$H/low_power_load" 14
+    write_if "$H/min_sample_time" 90
+    write_if "$H/powersave_bias" 0
+    write_if "$H/load_smoothing" 35
+    write_if "$H/boost_duration_ms" 220
+    write_if "$H/input_boost_ms" 96
+    write_if "$H/frame_boost_ms" 300
+ done
diff --git a/scripts/hydrogenx/boot-health-report.sh b/scripts/hydrogenx/boot-health-report.sh
new file mode 100755
index 000000000000..000000000000
--- /dev/null
+++ b/scripts/hydrogenx/boot-health-report.sh
@@ -0,0 +1,28 @@
+#!/system/bin/sh
+# Compact HydrogenX v10 boot health report.
+
+HX=/sys/kernel/hydrogenx
+CPUFREQ=/sys/devices/system/cpu/cpufreq
+
+echo "== HydrogenX =="
+[ -d "$HX" ] && { cat "$HX/version" 2>/dev/null; cat "$HX/status" 2>/dev/null; } || echo "missing $HX"
+
+echo "== CPUFreq =="
+for p in "$CPUFREQ"/policy*; do
+    [ -d "$p" ] || continue
+    echo "-- $p --"
+    cat "$p/scaling_available_governors" 2>/dev/null
+    cat "$p/scaling_governor" 2>/dev/null
+    cat "$p/scaling_min_freq" "$p/scaling_cur_freq" "$p/scaling_max_freq" 2>/dev/null
+ done
+
+echo "== ZRAM =="
+for z in /sys/block/zram*; do
+    [ -d "$z" ] || continue
+    echo "-- $z --"
+    cat "$z/comp_algorithm" 2>/dev/null
+    cat "$z/mm_stat" 2>/dev/null
+ done
+
+echo "== Config =="
+[ -f /proc/config.gz ] && zcat /proc/config.gz | grep -E "HYDROGENX|F2FS_FS_COMPRESSION|EROFS_FS_ZIP|ZRAM_WRITEBACK|TCP_CONG_BBR" || true
