index 000000000000..000000000000 100644
--- a/kernel/sched/tune_plus.c
+++ b/kernel/sched/tune_plus.c
@@ -160,6 +160,40 @@ int group_boost_read(int group_idx)
 	return boost;
 }
 EXPORT_SYMBOL(group_boost_read);
+
+void schedtune_hydrogenx_set_boost(int boost_value)
+{
+	if (boost_value > 100)
+		boost_value = 100;
+
+	/* root, foreground and top-app are the groups that matter most on Android. */
+	boost_write_for_perf_idx(0, boost_value);
+	boost_write_for_perf_idx(1, boost_value);
+	boost_write_for_perf_idx(3, boost_value);
+	prefer_idle_for_perf_idx(3, !!boost_value);
+}
+EXPORT_SYMBOL_GPL(schedtune_hydrogenx_set_boost);
+
+void schedtune_hydrogenx_set_uclamp_min(unsigned int min_pct)
+{
+	if (min_pct > 100)
+		min_pct = 100;
+
+#if defined(CONFIG_UCLAMP_TASK_GROUP) && defined(CONFIG_SCHED_TUNE)
+	uclamp_min_pct_for_perf_idx(0, min_pct);
+	uclamp_min_pct_for_perf_idx(1, min_pct);
+	uclamp_min_pct_for_perf_idx(3, min_pct);
+#endif
+}
+EXPORT_SYMBOL_GPL(schedtune_hydrogenx_set_uclamp_min);
+
+void schedtune_hydrogenx_set_prefer_idle(unsigned int prefer_idle)
+{
+	prefer_idle_for_perf_idx(1, !!prefer_idle);
+	prefer_idle_for_perf_idx(3, !!prefer_idle);
+}
