@@ -0,0 +1,40 @@
+#!/system/bin/sh
+# Optional HydrogenX v11 gaming profile helper.
+# It writes every policy that exists; missing nodes are skipped safely.
+
+HX=/sys/kernel/hydrogenx
+CPUFREQ=/sys/devices/system/cpu/cpufreq
+write_if() { [ -f "$1" ] && echo "$2" > "$1" 2>/dev/null; }
+
+write_if "$HX/profile" 1
+write_if "$HX/game_mode" 1
+write_if "$HX/sched_boost" 18
+write_if "$HX/uclamp_min" 18
+write_if "$HX/floor_pct" 45
+write_if "$HX/boost_floor_pct" 82
+write_if "$HX/input_hook" 1
+write_if "$HX/boostpulse" 1
+write_if "$HX/frame_boost" 1
+write_if "$HX/gpu_boost" 1
+write_if "$HX/ddr_boost" 1
+
+for p in "$CPUFREQ"/policy*; do
+    [ -d "$p" ] || continue
+    write_if "$p/scaling_governor" hydrogenx
+    H="$p/hydrogenx"
+    [ -d "$H" ] || continue
+    write_if "$H/profile" 1
+    write_if "$H/game_mode" 1
+    write_if "$H/sampling_rate" 6000
+    write_if "$H/up_threshold" 72
+    write_if "$H/down_threshold" 24
+    write_if "$H/hispeed_load" 45
+    write_if "$H/max_perf_load" 88
+    write_if "$H/low_power_load" 14
+    write_if "$H/min_sample_time" 90
+    write_if "$H/powersave_bias" 0
+    write_if "$H/load_smoothing" 35
+    write_if "$H/boost_duration_ms" 220
+    write_if "$H/input_boost_ms" 96
+    write_if "$H/frame_boost_ms" 300
+ done
