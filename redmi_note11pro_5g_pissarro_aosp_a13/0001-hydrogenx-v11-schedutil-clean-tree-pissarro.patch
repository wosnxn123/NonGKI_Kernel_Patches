@@ -0,0 +1,28 @@
+#!/system/bin/sh
+# Compact HydrogenX v11 boot health report.
+
+HX=/sys/kernel/hydrogenx
+CPUFREQ=/sys/devices/system/cpu/cpufreq
+
+echo "== HydrogenX =="
+[ -d "$HX" ] && { cat "$HX/version" 2>/dev/null; cat "$HX/status" 2>/dev/null; } || echo "missing $HX"
+
+echo "== CPUFreq =="
+for p in "$CPUFREQ"/policy*; do
+    [ -d "$p" ] || continue
+    echo "-- $p --"
+    cat "$p/scaling_available_governors" 2>/dev/null
+    cat "$p/scaling_governor" 2>/dev/null
+    cat "$p/scaling_min_freq" "$p/scaling_cur_freq" "$p/scaling_max_freq" 2>/dev/null
+ done
+
+echo "== ZRAM =="
+for z in /sys/block/zram*; do
+    [ -d "$z" ] || continue
+    echo "-- $z --"
+    cat "$z/comp_algorithm" 2>/dev/null
+    cat "$z/mm_stat" 2>/dev/null
+ done
+
+echo "== Config =="
+[ -f /proc/config.gz ] && zcat /proc/config.gz | grep -E "HYDROGENX|F2FS_FS_COMPRESSION|EROFS_FS_ZIP|ZRAM_WRITEBACK|TCP_CONG_BBR" || true
