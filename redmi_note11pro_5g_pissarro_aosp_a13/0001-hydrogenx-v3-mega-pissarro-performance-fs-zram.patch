diff --git a/drivers/misc/hydrogenx_boost.c b/drivers/misc/hydrogenx_boost.c
new file mode 100644
index 000000000000..000000000000
--- /dev/null
+++ b/drivers/misc/hydrogenx_boost.c
@@ -0,0 +1,372 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * HydrogenX boost scene controller.
+ *
+ * This file is intentionally self contained.  It provides:
+ * - a global /sys/kernel/hydrogenx scene interface;
+ * - an input handler that automatically triggers touch/input boosts;
+ * - weak SchedTune/UCLAMP and MTK GPU/DDR bridge calls.  If the vendor tree
+ *   exports matching strong symbols they are used, otherwise these become
+ *   harmless no-ops so the kernel still builds.
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/bitops.h>
+#include <linux/compiler.h>
+#include <linux/hydrogenx_boost.h>
+#include <linux/input.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/kobject.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <linux/sysfs.h>
+
+#define HX_DEF_BOOST_MS          180
+#define HX_DEF_INPUT_MS          96
+#define HX_DEF_FRAME_MS          280
+#define HX_DEF_GPU_MS            220
+#define HX_DEF_DDR_MS            220
+#define HX_DEF_IO_MS             180
+#define HX_DEF_GAME_FLOOR_PCT    62
+#define HX_DEF_BOOST_FLOOR_PCT   72
+#define HX_DEF_SCHED_BOOST       12
+#define HX_DEF_UCLAMP_MIN        20
+#define HX_MAX_MS                10000
+#define HX_MAX_BOOST             100
+
+struct hx_ctrl {
+	struct mutex lock;
+	struct kobject *kobj;
+	unsigned long until[HYDROGENX_BOOST_MAX];
+	unsigned int duration_ms[HYDROGENX_BOOST_MAX];
+	unsigned int profile;
+	unsigned int game_mode;
+	unsigned int floor_freq;
+	unsigned int floor_pct;
+	unsigned int boost_floor_pct;
+	unsigned int sched_boost;
+	unsigned int uclamp_min;
+	unsigned int input_hook;
+};
+
+static struct hx_ctrl hx = {
+	.lock = __MUTEX_INITIALIZER(hx.lock),
+	.duration_ms = {
+		[HYDROGENX_BOOST_GENERIC] = HX_DEF_BOOST_MS,
+		[HYDROGENX_BOOST_INPUT] = HX_DEF_INPUT_MS,
+		[HYDROGENX_BOOST_FRAME] = HX_DEF_FRAME_MS,
+		[HYDROGENX_BOOST_GPU] = HX_DEF_GPU_MS,
+		[HYDROGENX_BOOST_DDR] = HX_DEF_DDR_MS,
+		[HYDROGENX_BOOST_IO] = HX_DEF_IO_MS,
+	},
+	.profile = HYDROGENX_BOOST_PROFILE_BALANCED,
+	.game_mode = 0,
+	.floor_freq = 0,
+	.floor_pct = 0,
+	.boost_floor_pct = HX_DEF_BOOST_FLOOR_PCT,
+	.sched_boost = HX_DEF_SCHED_BOOST,
+	.uclamp_min = HX_DEF_UCLAMP_MIN,
+	.input_hook = 1,
+};
+
+void __weak schedtune_hydrogenx_set_boost(int boost) { }
+void __weak schedtune_hydrogenx_set_uclamp_min(unsigned int min_pct) { }
+void __weak mtk_hydrogenx_gpu_boost(unsigned int level) { }
+void __weak mtk_hydrogenx_ddr_boost(unsigned int level) { }
+void __weak mtk_hydrogenx_io_boost(unsigned int level) { }
+
+static bool hx_active_locked(enum hydrogenx_boost_reason reason)
+{
+	return hx.until[reason] && time_before(jiffies, hx.until[reason]);
+}
+
+static bool hx_any_perf_scene_locked(void)
+{
+	return hx.profile == HYDROGENX_BOOST_PROFILE_GAME || hx.game_mode ||
+	       hx_active_locked(HYDROGENX_BOOST_GENERIC) ||
+	       hx_active_locked(HYDROGENX_BOOST_INPUT) ||
+	       hx_active_locked(HYDROGENX_BOOST_FRAME) ||
+	       hx_active_locked(HYDROGENX_BOOST_GPU) ||
+	       hx_active_locked(HYDROGENX_BOOST_DDR) ||
+	       hx_active_locked(HYDROGENX_BOOST_IO);
+}
+
+static void hx_apply_scene_locked(void)
+{
+	bool perf = hx_any_perf_scene_locked();
+	unsigned int sched_boost = perf ? hx.sched_boost : 0;
+	unsigned int uclamp_min = perf ? hx.uclamp_min : 0;
+
+	schedtune_hydrogenx_set_boost(min_t(unsigned int, sched_boost, HX_MAX_BOOST));
+	schedtune_hydrogenx_set_uclamp_min(min_t(unsigned int, uclamp_min, HX_MAX_BOOST));
+
+	mtk_hydrogenx_gpu_boost(hx_active_locked(HYDROGENX_BOOST_GPU) || hx.game_mode);
+	mtk_hydrogenx_ddr_boost(hx_active_locked(HYDROGENX_BOOST_DDR) || hx.game_mode);
+	mtk_hydrogenx_io_boost(hx_active_locked(HYDROGENX_BOOST_IO) || hx.game_mode);
+}
+
+void hydrogenx_boost_pulse(enum hydrogenx_boost_reason reason, unsigned int duration_ms)
+{
+	if (reason >= HYDROGENX_BOOST_MAX)
+		return;
+
+	mutex_lock(&hx.lock);
+	if (!duration_ms)
+		duration_ms = hx.duration_ms[reason];
+	if (duration_ms > HX_MAX_MS)
+		duration_ms = HX_MAX_MS;
+	hx.until[reason] = jiffies + msecs_to_jiffies(duration_ms);
+	hx_apply_scene_locked();
+	mutex_unlock(&hx.lock);
+}
+EXPORT_SYMBOL_GPL(hydrogenx_boost_pulse);
+
+void hydrogenx_boost_get_state(struct hydrogenx_boost_state *state)
+{
+	memset(state, 0, sizeof(*state));
+
+	mutex_lock(&hx.lock);
+	state->boost = hx_active_locked(HYDROGENX_BOOST_GENERIC);
+	state->input = hx_active_locked(HYDROGENX_BOOST_INPUT);
+	state->frame = hx_active_locked(HYDROGENX_BOOST_FRAME);
+	state->gpu = hx_active_locked(HYDROGENX_BOOST_GPU);
+	state->ddr = hx_active_locked(HYDROGENX_BOOST_DDR);
+	state->io = hx_active_locked(HYDROGENX_BOOST_IO);
+	state->profile = hx.profile;
+	state->game_mode = hx.game_mode;
+	state->sched_boost = hx.sched_boost;
+	state->uclamp_min = hx.uclamp_min;
+	state->floor_freq = hx.floor_freq;
+	state->floor_pct = hx.floor_pct;
+
+	if (state->profile == HYDROGENX_BOOST_PROFILE_GAME || state->game_mode)
+		state->floor_pct = max_t(unsigned int, state->floor_pct, HX_DEF_GAME_FLOOR_PCT);
+	if (state->boost || state->input || state->frame || state->gpu || state->ddr || state->io)
+		state->floor_pct = max_t(unsigned int, state->floor_pct, hx.boost_floor_pct);
+	if (state->profile == HYDROGENX_BOOST_PROFILE_BATTERY && !state->boost &&
+	    !state->input && !state->frame)
+		state->floor_pct = 0;
+
+	mutex_unlock(&hx.lock);
+}
+EXPORT_SYMBOL_GPL(hydrogenx_boost_get_state);
+
+static int hx_parse_uint(const char *buf, unsigned int *val)
+{
+	return kstrtouint(buf, 0, val);
+}
+
+#define HX_RW_ATTR(_name, _field, _max)                                      \
+static ssize_t _name##_show(struct kobject *kobj, struct kobj_attribute *a,  \
+				    char *buf)                                      \
+{                                                                            \
+	ssize_t ret;                                                           \
+	mutex_lock(&hx.lock);                                                  \
+	ret = scnprintf(buf, PAGE_SIZE, "%u\n", hx._field);                 \
+	mutex_unlock(&hx.lock);                                                \
+	return ret;                                                            \
+}                                                                            \
+static ssize_t _name##_store(struct kobject *kobj, struct kobj_attribute *a, \
+				     const char *buf, size_t count)                    \
+{                                                                            \
+	unsigned int val;                                                       \
+	if (hx_parse_uint(buf, &val))                                           \
+		return -EINVAL;                                                  \
+	if (val > (_max))                                                       \
+		val = (_max);                                                    \
+	mutex_lock(&hx.lock);                                                  \
+	hx._field = val;                                                        \
+	hx_apply_scene_locked();                                                \
+	mutex_unlock(&hx.lock);                                                \
+	return count;                                                          \
+}                                                                            \
+static struct kobj_attribute _name##_attr = __ATTR(_name, 0644,             \
+						  _name##_show, _name##_store)
+
+HX_RW_ATTR(profile, profile, HYDROGENX_BOOST_PROFILE_BATTERY);
+HX_RW_ATTR(game_mode, game_mode, 1);
+HX_RW_ATTR(floor_freq, floor_freq, UINT_MAX);
+HX_RW_ATTR(floor_pct, floor_pct, 100);
+HX_RW_ATTR(boost_floor_pct, boost_floor_pct, 100);
+HX_RW_ATTR(sched_boost, sched_boost, HX_MAX_BOOST);
+HX_RW_ATTR(uclamp_min, uclamp_min, HX_MAX_BOOST);
+HX_RW_ATTR(input_hook, input_hook, 1);
+HX_RW_ATTR(boost_ms, duration_ms[HYDROGENX_BOOST_GENERIC], HX_MAX_MS);
+HX_RW_ATTR(input_boost_ms, duration_ms[HYDROGENX_BOOST_INPUT], HX_MAX_MS);
+HX_RW_ATTR(frame_boost_ms, duration_ms[HYDROGENX_BOOST_FRAME], HX_MAX_MS);
+HX_RW_ATTR(gpu_boost_ms, duration_ms[HYDROGENX_BOOST_GPU], HX_MAX_MS);
+HX_RW_ATTR(ddr_boost_ms, duration_ms[HYDROGENX_BOOST_DDR], HX_MAX_MS);
+HX_RW_ATTR(io_boost_ms, duration_ms[HYDROGENX_BOOST_IO], HX_MAX_MS);
+
+static ssize_t status_show(struct kobject *kobj, struct kobj_attribute *a, char *buf)
+{
+	struct hydrogenx_boost_state st;
+
+	hydrogenx_boost_get_state(&st);
+	return scnprintf(buf, PAGE_SIZE,
+		"profile=%u game_mode=%u boost=%u input=%u frame=%u gpu=%u ddr=%u io=%u floor_freq=%u floor_pct=%u sched_boost=%u uclamp_min=%u\n",
+		st.profile, st.game_mode, st.boost, st.input, st.frame, st.gpu,
+		st.ddr, st.io, st.floor_freq, st.floor_pct, st.sched_boost,
+		st.uclamp_min);
+}
+static struct kobj_attribute status_attr = __ATTR_RO(status);
+
+#define HX_PULSE_ATTR(_name, _reason)                                      \
+static ssize_t _name##_store(struct kobject *kobj, struct kobj_attribute *a,\
+				     const char *buf, size_t count)                  \
+{                                                                          \
+	unsigned int val;                                                     \
+	if (hx_parse_uint(buf, &val))                                         \
+		return -EINVAL;                                                \
+	if (val)                                                             \
+		hydrogenx_boost_pulse(_reason, 0);                            \
+	return count;                                                        \
+}                                                                          \
+static struct kobj_attribute _name##_attr = __ATTR(_name, 0200, NULL,      \
+						  _name##_store)
+
+HX_PULSE_ATTR(boostpulse, HYDROGENX_BOOST_GENERIC);
+HX_PULSE_ATTR(input_boostpulse, HYDROGENX_BOOST_INPUT);
+HX_PULSE_ATTR(frame_boost, HYDROGENX_BOOST_FRAME);
+HX_PULSE_ATTR(gpu_boost, HYDROGENX_BOOST_GPU);
+HX_PULSE_ATTR(ddr_boost, HYDROGENX_BOOST_DDR);
+HX_PULSE_ATTR(io_boost, HYDROGENX_BOOST_IO);
+
+static struct attribute *hx_attrs[] = {
+	&profile_attr.attr,
+	&game_mode_attr.attr,
+	&floor_freq_attr.attr,
+	&floor_pct_attr.attr,
+	&boost_floor_pct_attr.attr,
+	&sched_boost_attr.attr,
+	&uclamp_min_attr.attr,
+	&input_hook_attr.attr,
+	&boost_ms_attr.attr,
+	&input_boost_ms_attr.attr,
+	&frame_boost_ms_attr.attr,
+	&gpu_boost_ms_attr.attr,
+	&ddr_boost_ms_attr.attr,
+	&io_boost_ms_attr.attr,
+	&boostpulse_attr.attr,
+	&input_boostpulse_attr.attr,
+	&frame_boost_attr.attr,
+	&gpu_boost_attr.attr,
+	&ddr_boost_attr.attr,
+	&io_boost_attr.attr,
+	&status_attr.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(hx);
+
+static void hx_input_event(struct input_handle *handle, unsigned int type,
+			   unsigned int code, int value)
+{
+	if (!READ_ONCE(hx.input_hook) || !value)
+		return;
+
+	if (type == EV_ABS || type == EV_REL || type == EV_KEY) {
+		hydrogenx_boost_pulse(HYDROGENX_BOOST_INPUT, 0);
+		if (READ_ONCE(hx.game_mode))
+			hydrogenx_boost_pulse(HYDROGENX_BOOST_FRAME, 0);
+	}
+}
+
+static int hx_input_connect(struct input_handler *handler,
+			    struct input_dev *dev,
+			    const struct input_device_id *id)
+{
+	struct input_handle *handle;
+	int ret;
+
+	if (!test_bit(EV_ABS, dev->evbit) && !test_bit(EV_REL, dev->evbit) &&
+	    !test_bit(EV_KEY, dev->evbit))
+		return -ENODEV;
+
+	handle = kzalloc(sizeof(*handle), GFP_KERNEL);
+	if (!handle)
+		return -ENOMEM;
+
+	handle->dev = dev;
+	handle->handler = handler;
+	handle->name = "hydrogenx_boost";
+
+	ret = input_register_handle(handle);
+	if (ret)
+		goto err_free;
+
+	ret = input_open_device(handle);
+	if (ret)
+		goto err_unregister;
+
+	return 0;
+
+err_unregister:
+	input_unregister_handle(handle);
+err_free:
+	kfree(handle);
+	return ret;
+}
+
+static void hx_input_disconnect(struct input_handle *handle)
+{
+	input_close_device(handle);
+	input_unregister_handle(handle);
+	kfree(handle);
+}
+
+static const struct input_device_id hx_input_ids[] = {
+	{ .driver_info = 1 },
+	{ },
+};
+MODULE_DEVICE_TABLE(input, hx_input_ids);
+
+static struct input_handler hx_input_handler = {
+	.event = hx_input_event,
+	.connect = hx_input_connect,
+	.disconnect = hx_input_disconnect,
+	.name = "hydrogenx_boost",
+	.id_table = hx_input_ids,
+};
+
+static int __init hydrogenx_boost_init(void)
+{
+	int ret;
+
+	hx.kobj = kobject_create_and_add("hydrogenx", kernel_kobj);
+	if (!hx.kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_groups(hx.kobj, hx_groups);
+	if (ret)
+		goto err_kobj;
+
+	ret = input_register_handler(&hx_input_handler);
+	if (ret)
+		goto err_sysfs;
+
+	pr_info("boost scene controller loaded\n");
+	return 0;
+
+err_sysfs:
+	sysfs_remove_groups(hx.kobj, hx_groups);
+err_kobj:
+	kobject_put(hx.kobj);
+	return ret;
+}
+
+static void __exit hydrogenx_boost_exit(void)
+{
+	input_unregister_handler(&hx_input_handler);
+	sysfs_remove_groups(hx.kobj, hx_groups);
+	kobject_put(hx.kobj);
+}
+
+module_init(hydrogenx_boost_init);
+module_exit(hydrogenx_boost_exit);
+
+MODULE_AUTHOR("ChatGPT");
+MODULE_DESCRIPTION("HydrogenX global boost/input scene controller");
+MODULE_LICENSE("GPL");

