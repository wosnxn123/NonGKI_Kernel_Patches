+	unsigned int input;
+
+	if (hyd_parse_uint(buf, &input))
+		return -EINVAL;
+
+	if (input)
+		hyd_pulse_all(attr_set, tuners->boost_duration_ms,
+			      HYD_PULSE_GENERIC);
+
+	return count;
+}
+
