+static void hyd_pulse_all(struct gov_attr_set *attr_set,
+			  unsigned int duration_ms,
+			  enum hyd_pulse_type type)
+{
+	struct dbs_data *dbs_data = to_dbs_data(attr_set);
+	struct hyd_dbs_tuners *tuners = dbs_data->tuners;
+	struct policy_dbs_info *policy_dbs;
+	unsigned long until;
+
+	if (!duration_ms)
+		return;
+
+	until = jiffies + msecs_to_jiffies(duration_ms);
+
+	list_for_each_entry(policy_dbs, &attr_set->policy_list, list) {
+		struct hyd_policy_dbs_info *hyd_info;
+		struct cpufreq_policy *policy = policy_dbs->policy;
+		unsigned int floor;
+
+		if (!policy)
+			continue;
+
+		hyd_info = to_hyd_policy_dbs_info(policy_dbs);
+
+		switch (type) {
+		case HYD_PULSE_GENERIC:
+			hyd_info->boost_until = until;
+			break;
+		case HYD_PULSE_INPUT:
+			hyd_info->input_boost_until = until;
+			break;
+		case HYD_PULSE_FRAME:
+			hyd_info->frame_boost_until = until;
+			break;
+		}
+
+		floor = hyd_pick_floor(policy, tuners, hyd_info);
+
+		mutex_lock(&policy_dbs->update_mutex);
+		hyd_set_target(policy, max(floor, policy->cur), CPUFREQ_RELATION_L, 0);
+		gov_update_sample_delay(policy_dbs, 0);
+		mutex_unlock(&policy_dbs->update_mutex);
+	}
+}
+
