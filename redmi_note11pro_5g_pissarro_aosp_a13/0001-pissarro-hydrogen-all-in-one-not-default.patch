+/********************** cpufreq governor interface *********************/
+
+static struct hx_policy *hx_policy_alloc(struct cpufreq_policy *policy)
+{
+	struct hx_policy *hx_policy;
+
+	hx_policy = kzalloc(sizeof(*hx_policy), GFP_KERNEL);
+	if (!hx_policy)
+		return NULL;
+
+	hx_policy->policy = policy;
+	raw_spin_lock_init(&hx_policy->update_lock);
+	return hx_policy;
+}
+
+static void hx_policy_free(struct hx_policy *hx_policy)
+{
+	kfree(hx_policy);
+}
+
+static int hx_kthread_create(struct hx_policy *hx_policy)
+{
+	struct task_struct *thread;
+	struct sched_param param = { .sched_priority = MAX_USER_RT_PRIO / 2 };
+	struct cpufreq_policy *policy = hx_policy->policy;
+	int ret;
+
+	if (policy->fast_switch_enabled)
+		return 0;
+
+	kthread_init_work(&hx_policy->work, hx_work);
+	kthread_init_worker(&hx_policy->worker);
+	thread = kthread_create(kthread_worker_fn, &hx_policy->worker,
+				"hydgov:%d", cpumask_first(policy->related_cpus));
+	if (IS_ERR(thread)) {
+		pr_err("failed to create hydrogen thread: %ld\n", PTR_ERR(thread));
+		return PTR_ERR(thread);
+	}
+
+	ret = sched_setscheduler_nocheck(thread, SCHED_FIFO, &param);
+	if (ret) {
+		kthread_stop(thread);
+		pr_warn("%s: failed to set SCHED_FIFO\n", __func__);
+		return ret;
+	}
+
+	hx_policy->thread = thread;
+	if (!policy->dvfs_possible_from_any_cpu)
+		kthread_bind_mask(thread, policy->related_cpus);
+
+	init_irq_work(&hx_policy->irq_work, hx_irq_work);
+	mutex_init(&hx_policy->work_lock);
+	wake_up_process(thread);
+	return 0;
+}
+
+static void hx_kthread_stop(struct hx_policy *hx_policy)
+{
+	if (hx_policy->policy->fast_switch_enabled)
+		return;
+
+	kthread_flush_worker(&hx_policy->worker);
+	kthread_stop(hx_policy->thread);
+	mutex_destroy(&hx_policy->work_lock);
+}
+
+static void hx_tunables_set_defaults(struct hx_tunables *tunables,
+				     struct cpufreq_policy *policy)
+{
+	unsigned int delay_us = cpufreq_policy_transition_delay_us(policy);
+
+	tunables->up_rate_limit_us = min(delay_us, 1000U);
+	tunables->down_rate_limit_us = max(delay_us * 2U,
+					    HYDROGEN_DEFAULT_DOWN_RATE_LIMIT_US);
+	tunables->min_sample_time_us = HYDROGEN_DEFAULT_MIN_SAMPLE_TIME_US;
+	tunables->target_load = HYDROGEN_DEFAULT_TARGET_LOAD;
+	tunables->hispeed_load = HYDROGEN_DEFAULT_HISPEED_LOAD;
+	tunables->hispeed_freq = 0;
+	tunables->util_boost = HYDROGEN_DEFAULT_UTIL_BOOST;
+	tunables->powersave_bias = 0;
+	tunables->iowait_boost_enable = 1;
+	tunables->rt_boost = 1;
+	tunables->boost = 0;
+	tunables->boostpulse_duration_us = HYDROGEN_DEFAULT_BOOSTPULSE_US;
+	tunables->boostpulse_endtime = 0;
+}
+
+static struct hx_tunables *hx_tunables_alloc(struct hx_policy *hx_policy)
+{
+	struct hx_tunables *tunables;
+
+	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+	if (tunables) {
+		gov_attr_set_init(&tunables->attr_set, &hx_policy->tunables_hook);
+		if (!have_governor_per_policy())
+			global_tunables = tunables;
+	}
+
+	return tunables;
+}
+
+static void hx_clear_global_tunables(void)
+{
+	if (!have_governor_per_policy())
+		global_tunables = NULL;
+}
+
+static int hx_init(struct cpufreq_policy *policy)
+{
+	struct hx_policy *hx_policy;
+	struct hx_tunables *tunables;
+	int ret = 0;
+
+	if (policy->governor_data)
+		return -EBUSY;
+
+	cpufreq_enable_fast_switch(policy);
+
+	hx_policy = hx_policy_alloc(policy);
+	if (!hx_policy) {
+		ret = -ENOMEM;
+		goto disable_fast_switch;
+	}
+
+	ret = hx_kthread_create(hx_policy);
+	if (ret)
+		goto free_hx_policy;
+
+	mutex_lock(&global_tunables_lock);
+	if (global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+		policy->governor_data = hx_policy;
+		hx_policy->tunables = global_tunables;
+		gov_attr_set_get(&global_tunables->attr_set,
+				 &hx_policy->tunables_hook);
+		goto out;
+	}
+
+	tunables = hx_tunables_alloc(hx_policy);
+	if (!tunables) {
+		ret = -ENOMEM;
+		goto stop_kthread;
+	}
+
+	hx_tunables_set_defaults(tunables, policy);
+	policy->governor_data = hx_policy;
+	hx_policy->tunables = tunables;
+	ret = kobject_init_and_add(&tunables->attr_set.kobj,
+				     &hx_tunables_ktype,
+				     get_governor_parent_kobj(policy), "%s",
+				     hydrogen_gov.name);
+	if (ret)
+		goto fail;
+
+out:
+	mutex_unlock(&global_tunables_lock);
+	return 0;
+
+fail:
+	kobject_put(&tunables->attr_set.kobj);
+	policy->governor_data = NULL;
+	hx_clear_global_tunables();
+stop_kthread:
+	hx_kthread_stop(hx_policy);
+	mutex_unlock(&global_tunables_lock);
+free_hx_policy:
+	hx_policy_free(hx_policy);
+disable_fast_switch:
+	cpufreq_disable_fast_switch(policy);
+	pr_err("initialization failed (error %d)\n", ret);
+	return ret;
+}
+
+static void hx_exit(struct cpufreq_policy *policy)
+{
+	struct hx_policy *hx_policy = policy->governor_data;
+	struct hx_tunables *tunables = hx_policy->tunables;
+	unsigned int count;
+
+	mutex_lock(&global_tunables_lock);
+	count = gov_attr_set_put(&tunables->attr_set, &hx_policy->tunables_hook);
+	policy->governor_data = NULL;
+	if (!count)
+		hx_clear_global_tunables();
+	mutex_unlock(&global_tunables_lock);
+
+	hx_kthread_stop(hx_policy);
+	hx_policy_free(hx_policy);
+	cpufreq_disable_fast_switch(policy);
+}
+
+static int hx_start(struct cpufreq_policy *policy)
+{
+	struct hx_policy *hx_policy = policy->governor_data;
+	unsigned int cpu;
+
+	hx_policy->up_rate_delay_ns =
+		(s64)hx_policy->tunables->up_rate_limit_us * NSEC_PER_USEC;
+	hx_policy->down_rate_delay_ns =
+		(s64)hx_policy->tunables->down_rate_limit_us * NSEC_PER_USEC;
+	hx_policy->min_sample_time_ns =
+		(s64)hx_policy->tunables->min_sample_time_us * NSEC_PER_USEC;
+	hx_update_min_rate_limit_ns(hx_policy);
+	hx_policy->last_freq_update_time = 0;
+	hx_policy->last_freq_increase_time = 0;
+	hx_policy->next_freq = UINT_MAX;
+	hx_policy->work_in_progress = false;
+	hx_policy->need_freq_update = false;
+	hx_policy->cached_raw_freq = 0;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct hx_cpu *hx_cpu = &per_cpu(hydrogen_cpu, cpu);
+
+		memset(hx_cpu, 0, sizeof(*hx_cpu));
+		hx_cpu->cpu = cpu;
+		hx_cpu->hx_policy = hx_policy;
+		hx_cpu->flags = SCHED_CPUFREQ_DL;
+		hx_cpu->iowait_boost_max = capacity_orig_of(cpu);
+		if (policy->cpuinfo.max_freq)
+			hx_cpu->min_boost =
+				(SCHED_CAPACITY_SCALE * policy->cpuinfo.min_freq) /
+				policy->cpuinfo.max_freq;
+		if (!hx_cpu->min_boost)
+			hx_cpu->min_boost = HYDROGEN_IOWAIT_BOOST_MIN;
+	}
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct hx_cpu *hx_cpu = &per_cpu(hydrogen_cpu, cpu);
+
+		cpufreq_add_update_util_hook(cpu, &hx_cpu->update_util,
+			policy_is_shared(policy) ? hx_update_shared : hx_update_single);
+	}
+
+	return 0;
+}
+
+static void hx_stop(struct cpufreq_policy *policy)
+{
+	struct hx_policy *hx_policy = policy->governor_data;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, policy->cpus)
+		cpufreq_remove_update_util_hook(cpu);
+
+	synchronize_sched();
+
+	if (!policy->fast_switch_enabled) {
+		irq_work_sync(&hx_policy->irq_work);
+		kthread_cancel_work_sync(&hx_policy->work);
+	}
+}
+
+static void hx_limits(struct cpufreq_policy *policy)
+{
+	struct hx_policy *hx_policy = policy->governor_data;
+
+	if (!policy->fast_switch_enabled) {
+		mutex_lock(&hx_policy->work_lock);
+		cpufreq_policy_apply_limits(policy);
+		mutex_unlock(&hx_policy->work_lock);
+	}
+
+	hx_policy->need_freq_update = true;
+}
+
+static struct cpufreq_governor hydrogen_gov = {
+	.name = "hydrogen",
+	.owner = THIS_MODULE,
+	.dynamic_switching = true,
+	.init = hx_init,
+	.exit = hx_exit,
+	.start = hx_start,
+	.stop = hx_stop,
+	.limits = hx_limits,
+};
+
+static int __init hx_register(void)
+{
+	return cpufreq_register_governor(&hydrogen_gov);
+}
+core_initcall(hx_register);
