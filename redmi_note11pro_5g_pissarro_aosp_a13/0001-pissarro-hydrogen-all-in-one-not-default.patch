diff --git a/block/hydrogen-iosched.c b/block/hydrogen-iosched.c
new file mode 100644
index 0000000..0000000
--- /dev/null
+++ b/block/hydrogen-iosched.c
@@ -0,0 +1,264 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hydrogen low-latency single-queue I/O scheduler.
+ *
+ * Inspired by the small mobile schedulers commonly used in Android kernels:
+ * keep the code path close to noop, prefer reads for UI latency, but prevent
+ * write starvation with a tunable read/write budget.
+ */
+
+#include <linux/blkdev.h>
+#include <linux/elevator.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/slab.h>
+
+struct hydrogen_data {
+	struct list_head fifo_list[2];
+	unsigned int starved;
+	unsigned int batching;
+	int last_dir;
+	int writes_starved;
+	int fifo_batch;
+	int read_bias;
+};
+
+static void hydrogen_merged_requests(struct request_queue *q,
+				     struct request *rq, struct request *next)
+{
+	list_del_init(&next->queuelist);
+}
+
+static int hydrogen_choose_dir(struct hydrogen_data *hd)
+{
+	const bool reads = !list_empty(&hd->fifo_list[READ]);
+	const bool writes = !list_empty(&hd->fifo_list[WRITE]);
+
+	if (!reads && !writes)
+		return -1;
+	if (reads && !writes)
+		return READ;
+	if (writes && !reads)
+		return WRITE;
+
+	/* Keep small batches for throughput, but never violate starvation guard. */
+	if (hd->last_dir == WRITE && hd->batching < hd->fifo_batch)
+		return WRITE;
+	if (hd->last_dir == READ && hd->batching < hd->fifo_batch &&
+	    hd->starved < hd->writes_starved)
+		return READ;
+
+	if (hd->read_bias && hd->starved < hd->writes_starved)
+		return READ;
+
+	return WRITE;
+}
+
+static int hydrogen_dispatch(struct request_queue *q, int force)
+{
+	struct hydrogen_data *hd = q->elevator->elevator_data;
+	struct request *rq;
+	int dir = hydrogen_choose_dir(hd);
+
+	if (dir < 0)
+		return 0;
+
+	rq = list_first_entry_or_null(&hd->fifo_list[dir], struct request,
+					     queuelist);
+	if (!rq)
+		return 0;
+
+	list_del_init(&rq->queuelist);
+	elv_dispatch_sort(q, rq);
+
+	if (hd->last_dir == dir)
+		hd->batching++;
+	else {
+		hd->last_dir = dir;
+		hd->batching = 1;
+	}
+
+	if (dir == READ && !list_empty(&hd->fifo_list[WRITE]))
+		hd->starved++;
+	else if (dir == WRITE)
+		hd->starved = 0;
+
+	return 1;
+}
+
+static void hydrogen_add_request(struct request_queue *q, struct request *rq)
+{
+	struct hydrogen_data *hd = q->elevator->elevator_data;
+
+	list_add_tail(&rq->queuelist, &hd->fifo_list[rq_data_dir(rq)]);
+}
+
+static struct request *hydrogen_former_request(struct request_queue *q,
+					       struct request *rq)
+{
+	struct hydrogen_data *hd = q->elevator->elevator_data;
+	const int dir = rq_data_dir(rq);
+
+	if (rq->queuelist.prev == &hd->fifo_list[dir])
+		return NULL;
+	return list_prev_entry(rq, queuelist);
+}
+
+static struct request *hydrogen_latter_request(struct request_queue *q,
+					       struct request *rq)
+{
+	struct hydrogen_data *hd = q->elevator->elevator_data;
+	const int dir = rq_data_dir(rq);
+
+	if (rq->queuelist.next == &hd->fifo_list[dir])
+		return NULL;
+	return list_next_entry(rq, queuelist);
+}
+
+static int hydrogen_init_queue(struct request_queue *q, struct elevator_type *e)
+{
+	struct hydrogen_data *hd;
+	struct elevator_queue *eq;
+
+	eq = elevator_alloc(q, e);
+	if (!eq)
+		return -ENOMEM;
+
+	hd = kmalloc_node(sizeof(*hd), GFP_KERNEL, q->node);
+	if (!hd) {
+		kobject_put(&eq->kobj);
+		return -ENOMEM;
+	}
+
+	INIT_LIST_HEAD(&hd->fifo_list[READ]);
+	INIT_LIST_HEAD(&hd->fifo_list[WRITE]);
+	hd->starved = 0;
+	hd->batching = 0;
+	hd->last_dir = -1;
+	hd->writes_starved = 3;
+	hd->fifo_batch = 4;
+	hd->read_bias = 1;
+
+	eq->elevator_data = hd;
+
+	spin_lock_irq(q->queue_lock);
+	q->elevator = eq;
+	spin_unlock_irq(q->queue_lock);
+	return 0;
+}
+
+static void hydrogen_exit_queue(struct elevator_queue *e)
+{
+	struct hydrogen_data *hd = e->elevator_data;
+
+	BUG_ON(!list_empty(&hd->fifo_list[READ]));
+	BUG_ON(!list_empty(&hd->fifo_list[WRITE]));
+	kfree(hd);
+}
+
+static ssize_t hydrogen_var_show(int var, char *page)
+{
+	return sprintf(page, "%d\n", var);
+}
+
+static ssize_t hydrogen_writes_starved_show(struct elevator_queue *e,
+						    char *page)
+{
+	struct hydrogen_data *hd = e->elevator_data;
+
+	return hydrogen_var_show(hd->writes_starved, page);
+}
+
+static ssize_t hydrogen_writes_starved_store(struct elevator_queue *e,
+						     const char *page, size_t count)
+{
+	struct hydrogen_data *hd = e->elevator_data;
+	int val;
+
+	if (kstrtoint(page, 0, &val))
+		return -EINVAL;
+	hd->writes_starved = clamp(val, 1, 64);
+	return count;
+}
+
+static ssize_t hydrogen_fifo_batch_show(struct elevator_queue *e, char *page)
+{
+	struct hydrogen_data *hd = e->elevator_data;
+
+	return hydrogen_var_show(hd->fifo_batch, page);
+}
+
+static ssize_t hydrogen_fifo_batch_store(struct elevator_queue *e,
+						 const char *page, size_t count)
+{
+	struct hydrogen_data *hd = e->elevator_data;
+	int val;
+
+	if (kstrtoint(page, 0, &val))
+		return -EINVAL;
+	hd->fifo_batch = clamp(val, 1, 128);
+	return count;
+}
+
+static ssize_t hydrogen_read_bias_show(struct elevator_queue *e, char *page)
+{
+	struct hydrogen_data *hd = e->elevator_data;
+
+	return hydrogen_var_show(hd->read_bias, page);
+}
+
+static ssize_t hydrogen_read_bias_store(struct elevator_queue *e,
+						const char *page, size_t count)
+{
+	struct hydrogen_data *hd = e->elevator_data;
+	int val;
+
+	if (kstrtoint(page, 0, &val))
+		return -EINVAL;
+	hd->read_bias = clamp(val, 0, 1);
+	return count;
+}
+
+#define HYDROGEN_ATTR(name) \
+	__ATTR(name, S_IRUGO | S_IWUSR, hydrogen_##name##_show, \
+	       hydrogen_##name##_store)
+
+static struct elv_fs_entry hydrogen_attrs[] = {
+	HYDROGEN_ATTR(writes_starved),
+	HYDROGEN_ATTR(fifo_batch),
+	HYDROGEN_ATTR(read_bias),
+	__ATTR_NULL,
+};
+
+static struct elevator_type iosched_hydrogen = {
+	.ops.sq = {
+		.elevator_merge_req_fn = hydrogen_merged_requests,
+		.elevator_dispatch_fn = hydrogen_dispatch,
+		.elevator_add_req_fn = hydrogen_add_request,
+		.elevator_former_req_fn = hydrogen_former_request,
+		.elevator_latter_req_fn = hydrogen_latter_request,
+		.elevator_init_fn = hydrogen_init_queue,
+		.elevator_exit_fn = hydrogen_exit_queue,
+	},
+	.elevator_attrs = hydrogen_attrs,
+	.elevator_name = "hydrogen",
+	.elevator_owner = THIS_MODULE,
+};
+
+static int __init hydrogen_iosched_init(void)
+{
+	return elv_register(&iosched_hydrogen);
+}
+
+static void __exit hydrogen_iosched_exit(void)
+{
+	elv_unregister(&iosched_hydrogen);
+}
+
+module_init(hydrogen_iosched_init);
+module_exit(hydrogen_iosched_exit);
+
+MODULE_AUTHOR("Hydrogen Kernel contributors");
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Hydrogen low-latency mobile IO scheduler");
