diff --git a/init/hydrogen_tweaks.c b/init/hydrogen_tweaks.c
new file mode 100644
index 0000000..6beb666
--- /dev/null
+++ b/init/hydrogen_tweaks.c
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hydrogen kernel tuning pack for MT6877/Android kernels.
+ *
+ * This is intentionally small and conservative: it applies the same kind of
+ * VM/writeback/zram-friendly defaults that are normally pushed from init.d or
+ * kernel manager apps, but keeps them visible and tunable from sysfs.
+ */
+
+#define pr_fmt(fmt) "hydrogen_tweaks: " fmt
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/kobject.h>
+#include <linux/string.h>
+#include <linux/sysfs.h>
+
+/* VM/sysctl globals exported by mm/fs. */
+extern int vm_swappiness;
+extern int page_cluster;
+extern int sysctl_vfs_cache_pressure;
+extern int dirty_background_ratio;
+extern int vm_dirty_ratio;
+extern unsigned long dirty_background_bytes;
+extern unsigned long vm_dirty_bytes;
+extern unsigned int dirty_writeback_interval;
+extern unsigned int dirty_expire_interval;
+
+struct hydrogen_profile {
+	const char *name;
+	int swappiness;
+	int page_cluster;
+	int vfs_cache_pressure;
+	int dirty_background_ratio;
+	int dirty_ratio;
+	unsigned int dirty_writeback_cs;
+	unsigned int dirty_expire_cs;
+};
+
+static const struct hydrogen_profile hydrogen_profiles[] = {
+	{
+		.name = "balanced",
+		.swappiness = 100,
+		.page_cluster = 0,
+		.vfs_cache_pressure = 90,
+		.dirty_background_ratio = 5,
+		.dirty_ratio = 20,
+		.dirty_writeback_cs = 500,
+		.dirty_expire_cs = 3000,
+	},
+	{
+		.name = "performance",
+		.swappiness = 100,
+		.page_cluster = 0,
+		.vfs_cache_pressure = 70,
+		.dirty_background_ratio = 10,
+		.dirty_ratio = 30,
+		.dirty_writeback_cs = 1000,
+		.dirty_expire_cs = 3000,
+	},
+	{
+		.name = "powersave",
+		.swappiness = 80,
+		.page_cluster = 0,
+		.vfs_cache_pressure = 120,
+		.dirty_background_ratio = 5,
+		.dirty_ratio = 15,
+		.dirty_writeback_cs = 1500,
+		.dirty_expire_cs = 6000,
+	},
+};
+
+static struct kobject *hydrogen_kobj;
+static char requested_profile[16] = "balanced";
+static char current_profile[16] = "balanced";
+static int hydrogen_enabled = 1;
+
+static void hydrogen_apply_profile(const struct hydrogen_profile *profile)
+{
+	vm_swappiness = profile->swappiness;
+	page_cluster = profile->page_cluster;
+	sysctl_vfs_cache_pressure = profile->vfs_cache_pressure;
+
+	/* Force ratio mode so previous userspace byte limits cannot override us. */
+	dirty_background_bytes = 0;
+	vm_dirty_bytes = 0;
+	dirty_background_ratio = profile->dirty_background_ratio;
+	vm_dirty_ratio = profile->dirty_ratio;
+	dirty_writeback_interval = profile->dirty_writeback_cs;
+	dirty_expire_interval = profile->dirty_expire_cs;
+
+	strlcpy(current_profile, profile->name, sizeof(current_profile));
+	pr_info("profile=%s swappiness=%d vfs_cache_pressure=%d dirty=%d/%d writeback=%u expire=%u page_cluster=%d\n",
+		profile->name, vm_swappiness, sysctl_vfs_cache_pressure,
+		dirty_background_ratio, vm_dirty_ratio, dirty_writeback_interval,
+		dirty_expire_interval, page_cluster);
+}
+
+static const struct hydrogen_profile *hydrogen_find_profile(const char *name)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(hydrogen_profiles); i++) {
+		if (sysfs_streq(name, hydrogen_profiles[i].name))
+			return &hydrogen_profiles[i];
+	}
+
+	if (sysfs_streq(name, "game") || sysfs_streq(name, "gaming"))
+		return &hydrogen_profiles[1];
+	if (sysfs_streq(name, "battery"))
+		return &hydrogen_profiles[2];
+
+	return NULL;
+}
+
+static int hydrogen_parse_int(const char *buf, int min, int max, int *out)
+{
+	int ret, val;
+
+	ret = kstrtoint(buf, 0, &val);
+	if (ret)
+		return ret;
+
+	*out = clamp(val, min, max);
+	return 0;
+}
+
+static ssize_t profile_show(struct kobject *kobj, struct kobj_attribute *attr,
+				    char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE,
+		"%s\navailable: balanced performance powersave\n",
+		current_profile);
+}
+
+static ssize_t profile_store(struct kobject *kobj, struct kobj_attribute *attr,
+				     const char *buf, size_t count)
+{
+	const struct hydrogen_profile *profile = hydrogen_find_profile(buf);
+	int index;
+
+	if (!profile && !kstrtoint(buf, 0, &index)) {
+		if (index >= 0 && index < ARRAY_SIZE(hydrogen_profiles))
+			profile = &hydrogen_profiles[index];
+	}
+
+	if (!profile)
+		return -EINVAL;
+
+	hydrogen_apply_profile(profile);
+	return count;
+}
+
+static ssize_t swappiness_show(struct kobject *kobj,
+				       struct kobj_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%d\n", vm_swappiness);
+}
+
+static ssize_t swappiness_store(struct kobject *kobj,
+					struct kobj_attribute *attr,
+					const char *buf, size_t count)
+{
+	int val, ret = hydrogen_parse_int(buf, 0, 100, &val);
+
+	if (ret)
+		return ret;
+	vm_swappiness = val;
+	strlcpy(current_profile, "custom", sizeof(current_profile));
+	return count;
+}
+
+static ssize_t page_cluster_show(struct kobject *kobj,
+					struct kobj_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%d\n", page_cluster);
+}
+
+static ssize_t page_cluster_store(struct kobject *kobj,
+					 struct kobj_attribute *attr,
+					 const char *buf, size_t count)
+{
+	int val, ret = hydrogen_parse_int(buf, 0, 3, &val);
+
+	if (ret)
+		return ret;
+	page_cluster = val;
+	strlcpy(current_profile, "custom", sizeof(current_profile));
+	return count;
+}
+
+static ssize_t vfs_cache_pressure_show(struct kobject *kobj,
+					       struct kobj_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%d\n", sysctl_vfs_cache_pressure);
+}
+
+static ssize_t vfs_cache_pressure_store(struct kobject *kobj,
+						struct kobj_attribute *attr,
+						const char *buf, size_t count)
+{
+	int val, ret = hydrogen_parse_int(buf, 10, 1000, &val);
+
+	if (ret)
+		return ret;
+	sysctl_vfs_cache_pressure = val;
+	strlcpy(current_profile, "custom", sizeof(current_profile));
+	return count;
+}
+
+static ssize_t dirty_background_ratio_show(struct kobject *kobj,
+						   struct kobj_attribute *attr,
+						   char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%d\n", dirty_background_ratio);
+}
+
+static ssize_t dirty_background_ratio_store(struct kobject *kobj,
+						    struct kobj_attribute *attr,
+						    const char *buf, size_t count)
+{
+	int val, ret = hydrogen_parse_int(buf, 1, 40, &val);
+
+	if (ret)
+		return ret;
+	dirty_background_bytes = 0;
+	dirty_background_ratio = val;
+	if (dirty_background_ratio >= vm_dirty_ratio)
+		vm_dirty_ratio = dirty_background_ratio + 1;
+	strlcpy(current_profile, "custom", sizeof(current_profile));
+	return count;
+}
+
+static ssize_t dirty_ratio_show(struct kobject *kobj,
+					struct kobj_attribute *attr, char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%d\n", vm_dirty_ratio);
+}
+
+static ssize_t dirty_ratio_store(struct kobject *kobj,
+					 struct kobj_attribute *attr,
+					 const char *buf, size_t count)
+{
+	int val, ret = hydrogen_parse_int(buf, 2, 60, &val);
+
+	if (ret)
+		return ret;
+	vm_dirty_bytes = 0;
+	vm_dirty_ratio = val;
+	if (dirty_background_ratio >= vm_dirty_ratio)
+		dirty_background_ratio = vm_dirty_ratio - 1;
+	strlcpy(current_profile, "custom", sizeof(current_profile));
+	return count;
+}
+
+static ssize_t dirty_writeback_centisecs_show(struct kobject *kobj,
+						      struct kobj_attribute *attr,
+						      char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%u\n", dirty_writeback_interval);
+}
+
+static ssize_t dirty_writeback_centisecs_store(struct kobject *kobj,
+						       struct kobj_attribute *attr,
+						       const char *buf, size_t count)
+{
+	int val, ret = hydrogen_parse_int(buf, 100, 6000, &val);
+
+	if (ret)
+		return ret;
+	dirty_writeback_interval = val;
+	strlcpy(current_profile, "custom", sizeof(current_profile));
+	return count;
+}
+
+static ssize_t dirty_expire_centisecs_show(struct kobject *kobj,
+						   struct kobj_attribute *attr,
+						   char *buf)
+{
+	return scnprintf(buf, PAGE_SIZE, "%u\n", dirty_expire_interval);
+}
+
+static ssize_t dirty_expire_centisecs_store(struct kobject *kobj,
+						    struct kobj_attribute *attr,
+						    const char *buf, size_t count)
+{
+	int val, ret = hydrogen_parse_int(buf, 500, 12000, &val);
+
+	if (ret)
+		return ret;
+	dirty_expire_interval = val;
+	strlcpy(current_profile, "custom", sizeof(current_profile));
+	return count;
+}
+
+static struct kobj_attribute profile_attr =
+	__ATTR(profile, 0644, profile_show, profile_store);
+static struct kobj_attribute swappiness_attr =
+	__ATTR(swappiness, 0644, swappiness_show, swappiness_store);
+static struct kobj_attribute page_cluster_attr =
+	__ATTR(page_cluster, 0644, page_cluster_show, page_cluster_store);
+static struct kobj_attribute vfs_cache_pressure_attr =
+	__ATTR(vfs_cache_pressure, 0644, vfs_cache_pressure_show,
+	       vfs_cache_pressure_store);
+static struct kobj_attribute dirty_background_ratio_attr =
+	__ATTR(dirty_background_ratio, 0644, dirty_background_ratio_show,
+	       dirty_background_ratio_store);
+static struct kobj_attribute dirty_ratio_attr =
+	__ATTR(dirty_ratio, 0644, dirty_ratio_show, dirty_ratio_store);
+static struct kobj_attribute dirty_writeback_centisecs_attr =
+	__ATTR(dirty_writeback_centisecs, 0644,
+	       dirty_writeback_centisecs_show,
+	       dirty_writeback_centisecs_store);
+static struct kobj_attribute dirty_expire_centisecs_attr =
+	__ATTR(dirty_expire_centisecs, 0644, dirty_expire_centisecs_show,
+	       dirty_expire_centisecs_store);
+
+static struct attribute *hydrogen_attrs[] = {
+	&profile_attr.attr,
+	&swappiness_attr.attr,
+	&page_cluster_attr.attr,
+	&vfs_cache_pressure_attr.attr,
+	&dirty_background_ratio_attr.attr,
+	&dirty_ratio_attr.attr,
+	&dirty_writeback_centisecs_attr.attr,
+	&dirty_expire_centisecs_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group hydrogen_attr_group = {
+	.attrs = hydrogen_attrs,
+};
+
+static int __init hydrogen_profile_setup(char *str)
+{
+	if (str && *str)
+		strlcpy(requested_profile, str, sizeof(requested_profile));
+	return 1;
+}
+__setup("hydrogen_profile=", hydrogen_profile_setup);
+
+static int __init hydrogen_enabled_setup(char *str)
+{
+	int val;
+
+	if (!str || kstrtoint(str, 0, &val))
+		return 1;
+	hydrogen_enabled = !!val;
+	return 1;
+}
+__setup("hydrogen_tweaks=", hydrogen_enabled_setup);
+
+static int __init hydrogen_tweaks_init(void)
+{
+	const struct hydrogen_profile *profile;
+	int ret;
+
+	if (!hydrogen_enabled) {
+		pr_info("disabled by boot parameter\n");
+		return 0;
+	}
+
+	profile = hydrogen_find_profile(requested_profile);
+	if (!profile)
+		profile = &hydrogen_profiles[0];
+	hydrogen_apply_profile(profile);
+
+	hydrogen_kobj = kobject_create_and_add("hydrogen_tweaks", kernel_kobj);
+	if (!hydrogen_kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_group(hydrogen_kobj, &hydrogen_attr_group);
+	if (ret) {
+		kobject_put(hydrogen_kobj);
+		hydrogen_kobj = NULL;
+	}
+
+	return ret;
+}
+late_initcall(hydrogen_tweaks_init);
diff --git a/scripts/hydrogen/hydrogen-tune.sh b/scripts/hydrogen/hydrogen-tune.sh
new file mode 100755
index 0000000..80e29c5
--- /dev/null
+++ b/scripts/hydrogen/hydrogen-tune.sh
@@ -0,0 +1,85 @@
+#!/system/bin/sh
+# Hydrogen runtime tuning helper for Android/KernelSU/Magisk init.d.
+# Run after zram/cgroups are created. Re-run is safe.
+
+write_if() {
+	[ -e "$1" ] || return 0
+	[ -w "$1" ] || return 0
+	echo "$2" > "$1" 2>/dev/null
+}
+
+contains_word() {
+	grep -qw "$2" "$1" 2>/dev/null
+}
+
+# VM + zram-friendly defaults.
+write_if /proc/sys/vm/swappiness 100
+write_if /proc/sys/vm/page-cluster 0
+write_if /proc/sys/vm/vfs_cache_pressure 90
+write_if /proc/sys/vm/dirty_background_ratio 5
+write_if /proc/sys/vm/dirty_ratio 20
+write_if /proc/sys/vm/dirty_writeback_centisecs 500
+write_if /proc/sys/vm/dirty_expire_centisecs 3000
+
+# Built-in Hydrogen sysfs profile, if the kernel patch is enabled.
+write_if /sys/kernel/hydrogen_tweaks/profile balanced
+
+# CPU governor: prefer hydrogen if you applied the governor patch, otherwise
+# leave schedutil-like governors alone and only set safe rate limits.
+for p in /sys/devices/system/cpu/cpufreq/policy*; do
+	[ -d "$p" ] || continue
+	if contains_word "$p/scaling_available_governors" hydrogen; then
+		write_if "$p/scaling_governor" hydrogen
+	fi
+	for g in hydrogen schedutil blu_schedutil electroutil helix; do
+		d="$p/$g"
+		[ -d "$d" ] || continue
+		write_if "$d/up_rate_limit_us" 0
+		write_if "$d/down_rate_limit_us" 8000
+		write_if "$d/iowait_boost_enable" 1
+		write_if "$d/target_load" 70
+	done
+done
+
+# I/O: select the low-latency scheduler when present and use moderate readahead.
+for q in /sys/block/sd*/queue /sys/block/mmcblk*/queue /sys/block/dm-*/queue; do
+	[ -d "$q" ] || continue
+	if contains_word "$q/scheduler" hydrogen; then
+		write_if "$q/scheduler" hydrogen
+	fi
+	write_if "$q/read_ahead_kb" 128
+	write_if "$q/iostats" 0
+	write_if "$q/add_random" 0
+	write_if "$q/rq_affinity" 2
+	done
+
+# zram: comp_algorithm can only be changed before disksize/mkswap on most builds.
+if [ -e /sys/block/zram0/comp_algorithm ] && contains_word /sys/block/zram0/comp_algorithm lz4; then
+	state="$(cat /sys/block/zram0/initstate 2>/dev/null)"
+	[ "$state" = "0" ] && write_if /sys/block/zram0/comp_algorithm lz4
+fi
+write_if /sys/block/zram0/writeback_limit_enable 1
+
+# KSM is only useful for apps/processes that mark pages mergeable; this keeps it
+# gentle so it does not become a battery hog.
+write_if /sys/kernel/mm/ksm/run 1
+write_if /sys/kernel/mm/ksm/pages_to_scan 64
+write_if /sys/kernel/mm/ksm/sleep_millisecs 500
+
+# Android schedtune groups: small foreground/top-app latency bias.
+for base in /dev/stune /dev/cpuctl; do
+	[ -d "$base" ] || continue
+	write_if "$base/top-app/schedtune.boost" 5
+	write_if "$base/top-app/schedtune.prefer_idle" 1
+	write_if "$base/foreground/schedtune.boost" 1
+	write_if "$base/background/schedtune.boost" 0
+done
+
+# F2FS/EROFS debug knobs vary by tree; keep GC non-aggressive by default.
+for d in /sys/fs/f2fs/*; do
+	[ -d "$d" ] || continue
+	write_if "$d/iostat_enable" 1
+	write_if "$d/gc_urgent" 0
+done
+
+exit 0
