From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ChatGPT <chatgpt@example.com>
Date: Sat, 25 Apr 2026 00:00:00 -0700
Subject: [PATCH] cpufreq: hydrogen: auto-enable governor configs

Make the Hydrogen CPUFreq governor appear without requiring a manual
menuconfig/defconfig edit.

This keeps schedutil compiled as a fallback, but changes the main MT6877 /
pissarro defconfigs to select hydrogen as the boot governor.  The governor
Kconfig symbol also defaults to y so non-pissarro defconfigs can still expose
hydrogen in scaling_available_governors after olddefconfig.

Signed-off-by: ChatGPT <chatgpt@example.com>
---
 arch/arm64/configs/k6877v1_64_debug_defconfig | 3 ++-
 arch/arm64/configs/k6877v1_64_defconfig       | 3 ++-
 arch/arm64/configs/pissarro_debug_defconfig   | 3 ++-
 arch/arm64/configs/pissarro_defconfig         | 3 ++-
 arch/arm64/configs/pissarro_stability_defconfig | 3 ++-
 drivers/cpufreq/Kconfig                       | 1 +
 6 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -244,5 +244,6 @@ config CPU_FREQ_GOV_HYDROGEN
 	bool "'hydrogen' cpufreq policy governor"
 	depends on CPU_FREQ && SMP
+	default y
 	select CPU_FREQ_GOV_ATTR_SET
 	select IRQ_WORK
 	help
diff --git a/arch/arm64/configs/pissarro_defconfig b/arch/arm64/configs/pissarro_defconfig
--- a/arch/arm64/configs/pissarro_defconfig
+++ b/arch/arm64/configs/pissarro_defconfig
@@ -467,6 +467,7 @@ CONFIG_CPU_FREQ=y
 CONFIG_CPU_FREQ_TIMES=y
 CONFIG_CPU_FREQ_STAT=y
-CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
+CONFIG_CPU_FREQ_DEFAULT_GOV_HYDROGEN=y
 CONFIG_CPU_FREQ_GOV_ATTR_SET=y
 CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
 CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
diff --git a/arch/arm64/configs/pissarro_debug_defconfig b/arch/arm64/configs/pissarro_debug_defconfig
--- a/arch/arm64/configs/pissarro_debug_defconfig
+++ b/arch/arm64/configs/pissarro_debug_defconfig
@@ -196,6 +196,7 @@ CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
 CONFIG_CPU_FREQ=y
 CONFIG_CPU_FREQ_STAT=y
-CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
+CONFIG_CPU_FREQ_DEFAULT_GOV_HYDROGEN=y
 CONFIG_CPU_FREQ_GOV_POWERSAVE=y
 CONFIG_CPU_FREQ_GOV_USERSPACE=y
 CONFIG_CPU_FREQ_GOV_ONDEMAND=y
diff --git a/arch/arm64/configs/pissarro_stability_defconfig b/arch/arm64/configs/pissarro_stability_defconfig
--- a/arch/arm64/configs/pissarro_stability_defconfig
+++ b/arch/arm64/configs/pissarro_stability_defconfig
@@ -199,6 +199,7 @@ CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
 CONFIG_CPU_FREQ=y
 CONFIG_CPU_FREQ_STAT=y
-CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
+CONFIG_CPU_FREQ_DEFAULT_GOV_HYDROGEN=y
 CONFIG_CPU_FREQ_GOV_POWERSAVE=y
 CONFIG_CPU_FREQ_GOV_USERSPACE=y
 CONFIG_CPU_FREQ_GOV_ONDEMAND=y
diff --git a/arch/arm64/configs/k6877v1_64_defconfig b/arch/arm64/configs/k6877v1_64_defconfig
--- a/arch/arm64/configs/k6877v1_64_defconfig
+++ b/arch/arm64/configs/k6877v1_64_defconfig
@@ -180,6 +180,7 @@ CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
 CONFIG_CPU_FREQ=y
 CONFIG_CPU_FREQ_STAT=y
-CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
+CONFIG_CPU_FREQ_DEFAULT_GOV_HYDROGEN=y
 CONFIG_CPU_FREQ_GOV_POWERSAVE=y
 CONFIG_CPU_FREQ_GOV_USERSPACE=y
 CONFIG_CPU_FREQ_GOV_ONDEMAND=y
diff --git a/arch/arm64/configs/k6877v1_64_debug_defconfig b/arch/arm64/configs/k6877v1_64_debug_defconfig
--- a/arch/arm64/configs/k6877v1_64_debug_defconfig
+++ b/arch/arm64/configs/k6877v1_64_debug_defconfig
@@ -186,6 +186,7 @@ CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
 CONFIG_CPU_FREQ=y
 CONFIG_CPU_FREQ_STAT=y
-CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
+# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
+CONFIG_CPU_FREQ_DEFAULT_GOV_HYDROGEN=y
 CONFIG_CPU_FREQ_GOV_POWERSAVE=y
 CONFIG_CPU_FREQ_GOV_USERSPACE=y
 CONFIG_CPU_FREQ_GOV_ONDEMAND=y
