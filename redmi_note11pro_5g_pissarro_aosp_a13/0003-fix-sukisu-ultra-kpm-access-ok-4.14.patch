From a89445d317d2e00c91a9f3a0c1cf3d0ba5c2d07b Mon Sep 17 00:00:00 2001
From: OpenAI <patch@example.com>
Date: Sat, 25 Apr 2026 11:36:25 +0000
Subject: [PATCH] fix: compat SukiSU KPM access_ok on 4.14

---
 drivers/kernelsu/kpm/kpm.c | 89 ++++++++++++++++++++++++++------------
 1 file changed, 61 insertions(+), 28 deletions(-)

diff --git a/drivers/kernelsu/kpm/kpm.c b/drivers/kernelsu/kpm/kpm.c
index c96106b..401fecb 100644
--- a/drivers/kernelsu/kpm/kpm.c
+++ b/drivers/kernelsu/kpm/kpm.c
@@ -39,6 +39,24 @@
 #define KPM_NAME_LEN 32
 #define KPM_ARGS_LEN 1024
 
+#ifndef VERIFY_READ
+#define VERIFY_READ 0
+#endif
+
+#ifndef VERIFY_WRITE
+#define VERIFY_WRITE 1
+#endif
+
+static inline int sukisu_kpm_access_ok(int type, const void __user *addr,
+                                       unsigned long size)
+{
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 0, 0)
+    return access_ok(type, addr, size);
+#else
+    return access_ok(addr, size);
+#endif
+}
+
 #ifndef NO_OPTIMIZE
 #if defined(__GNUC__) && !defined(__clang__)
 #define NO_OPTIMIZE __attribute__((optimize("O0")))
@@ -124,61 +142,62 @@ noinline int sukisu_handle_kpm(unsigned long control_code, unsigned long arg1,
 {
     int res = -1;
     if (control_code == SUKISU_KPM_LOAD) {
-        char kernel_load_path[256];
-        char kernel_args_buffer[256];
+        char kernel_load_path[256] = { 0 };
+        char kernel_args_buffer[256] = { 0 };
 
         if (arg1 == 0) {
             res = -EINVAL;
             goto exit;
         }
 
-        if (!access_ok(arg1, 255)) {
+        if (!sukisu_kpm_access_ok(VERIFY_READ, (const void __user *)arg1, 255)) {
             goto invalid_arg;
         }
 
-        strncpy_from_user((char *)&kernel_load_path, (const char *)arg1, 255);
+        strncpy_from_user((char *)&kernel_load_path, (const char __user *)arg1, 255);
 
         if (arg2 != 0) {
-            if (!access_ok(arg2, 255)) {
+            if (!sukisu_kpm_access_ok(VERIFY_READ, (const void __user *)arg2, 255)) {
                 goto invalid_arg;
             }
 
-            strncpy_from_user((char *)&kernel_args_buffer, (const char *)arg2,
-                              255);
+            strncpy_from_user((char *)&kernel_args_buffer,
+                              (const char __user *)arg2, 255);
         }
 
         sukisu_kpm_load_module_path((const char *)&kernel_load_path,
                                     (const char *)&kernel_args_buffer, NULL,
                                     &res);
     } else if (control_code == SUKISU_KPM_UNLOAD) {
-        char kernel_name_buffer[256];
+        char kernel_name_buffer[256] = { 0 };
 
         if (arg1 == 0) {
             res = -EINVAL;
             goto exit;
         }
 
-        if (!access_ok(arg1, sizeof(kernel_name_buffer))) {
+        if (!sukisu_kpm_access_ok(VERIFY_READ, (const void __user *)arg1, sizeof(kernel_name_buffer))) {
             goto invalid_arg;
         }
 
-        strncpy_from_user((char *)&kernel_name_buffer, (const char *)arg1,
+        strncpy_from_user((char *)&kernel_name_buffer,
+                          (const char __user *)arg1,
                           sizeof(kernel_name_buffer));
 
         sukisu_kpm_unload_module((const char *)&kernel_name_buffer, NULL, &res);
     } else if (control_code == SUKISU_KPM_NUM) {
         sukisu_kpm_num(&res);
     } else if (control_code == SUKISU_KPM_INFO) {
-        char kernel_name_buffer[256];
-        char buf[256];
-        int size;
+        char kernel_name_buffer[256] = { 0 };
+        char buf[256] = { 0 };
+        int size = 0;
 
         if (arg1 == 0 || arg2 == 0) {
             res = -EINVAL;
             goto exit;
         }
 
-        if (!access_ok(arg1, sizeof(kernel_name_buffer))) {
+        if (!sukisu_kpm_access_ok(VERIFY_READ, (const void __user *)arg1, sizeof(kernel_name_buffer))) {
             goto invalid_arg;
         }
 
@@ -189,14 +208,14 @@ noinline int sukisu_handle_kpm(unsigned long control_code, unsigned long arg1,
         sukisu_kpm_info((const char *)&kernel_name_buffer, (char *)&buf,
                         sizeof(buf), &size);
 
-        if (!access_ok(arg2, size)) {
+        if (!sukisu_kpm_access_ok(VERIFY_WRITE, (void __user *)arg2, size)) {
             goto invalid_arg;
         }
 
-        res = copy_to_user(arg2, &buf, size);
+        res = copy_to_user((void __user *)arg2, &buf, size);
 
     } else if (control_code == SUKISU_KPM_LIST) {
-        char buf[1024];
+        char buf[1024] = { 0 };
         int len = (int)arg2;
 
         if (len <= 0) {
@@ -204,7 +223,7 @@ noinline int sukisu_handle_kpm(unsigned long control_code, unsigned long arg1,
             goto exit;
         }
 
-        if (!access_ok(arg2, len)) {
+        if (!sukisu_kpm_access_ok(VERIFY_WRITE, (void __user *)arg1, len)) {
             goto invalid_arg;
         }
 
@@ -215,18 +234,18 @@ noinline int sukisu_handle_kpm(unsigned long control_code, unsigned long arg1,
             goto exit;
         }
 
-        if (copy_to_user(arg1, &buf, len) != 0)
+        if (copy_to_user((void __user *)arg1, &buf, len) != 0)
             pr_info("kpm: Copy to user failed.");
 
     } else if (control_code == SUKISU_KPM_CONTROL) {
         char kpm_name[KPM_NAME_LEN] = { 0 };
         char kpm_args[KPM_ARGS_LEN] = { 0 };
 
-        if (!access_ok(arg1, sizeof(kpm_name))) {
+        if (!sukisu_kpm_access_ok(VERIFY_READ, (const void __user *)arg1, sizeof(kpm_name))) {
             goto invalid_arg;
         }
 
-        if (!access_ok(arg2, sizeof(kpm_args))) {
+        if (!sukisu_kpm_access_ok(VERIFY_READ, (const void __user *)arg2, sizeof(kpm_args))) {
             goto invalid_arg;
         }
 
@@ -250,14 +269,26 @@ noinline int sukisu_handle_kpm(unsigned long control_code, unsigned long arg1,
 
         unsigned int outlen = (unsigned int)arg2;
         int len = strlen(buffer);
+
+        if (arg1 == 0 || outlen == 0) {
+            res = -EINVAL;
+            goto exit;
+        }
+
         if (len >= outlen)
             len = outlen - 1;
 
-        res = copy_to_user(arg1, &buffer, len + 1);
+        if (!sukisu_kpm_access_ok(VERIFY_WRITE, (void __user *)arg1,
+                                  len + 1)) {
+            goto invalid_arg;
+        }
+
+        res = copy_to_user((void __user *)arg1, &buffer, len + 1);
     }
 
 exit:
-    if (copy_to_user(result_code, &res, sizeof(res)) != 0)
+    if (!sukisu_kpm_access_ok(VERIFY_WRITE, (void __user *)result_code, sizeof(res)) ||
+        copy_to_user((void __user *)result_code, &res, sizeof(res)) != 0)
         pr_info("kpm: Copy to user failed.");
 
     return 0;
@@ -286,13 +317,15 @@ int do_kpm(void __user *arg)
         return -EFAULT;
     }
 
-    if (!access_ok(cmd.control_code, sizeof(int))) {
-        pr_err("kpm: invalid control_code pointer %px\n",
-               (void *)cmd.control_code);
-        return -EFAULT;
+    if (cmd.control_code < SUKISU_KPM_LOAD ||
+        cmd.control_code > SUKISU_KPM_VERSION) {
+        pr_err("kpm: invalid control_code 0x%llx\n",
+               (unsigned long long)cmd.control_code);
+        return -EINVAL;
     }
 
-    if (!access_ok(cmd.result_code, sizeof(int))) {
+    if (!sukisu_kpm_access_ok(VERIFY_WRITE, (void __user *)cmd.result_code,
+                              sizeof(int))) {
         pr_err("kpm: invalid result_code pointer %px\n",
                (void *)cmd.result_code);
         return -EFAULT;
-- 
2.39.2

