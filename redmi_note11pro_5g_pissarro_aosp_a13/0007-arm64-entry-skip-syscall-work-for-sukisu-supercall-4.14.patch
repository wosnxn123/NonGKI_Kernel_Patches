From 1efb4fe0f1e55ae646fb0f0dc7bc96f4abf00007 Mon Sep 17 00:00:00 2001
From: ChatGPT <noreply@example.com>
Date: Sat, 25 Apr 2026 23:05:00 +0800
Subject: [PATCH] arm64: skip syscall-work path for SukiSU reboot supercall

The previous ptrace.c/seccomp bypass may still miss some Android 13 arm64
entry paths, because the seccomp kill happens while handling
_TIF_SYSCALL_WORK.  SukiSU Ultra userspace uses the reboot syscall number
142 with magic arguments 0xDEADBEEF and 0xCAFEBABE to reach the kernel
reboot kprobe supercall path.

Bypass the syscall-work slow path before syscall_trace_enter() only for the
exact SukiSU reboot supercall.  This lets the syscall reach the sys_call_table
entry so the SukiSU reboot kprobe can run.  Normal reboot calls and all other
syscalls keep the original tracing/seccomp behavior.

Signed-off-by: ChatGPT <noreply@example.com>
---
 arch/arm64/kernel/entry.S | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm64/kernel/entry.S b/arch/arm64/kernel/entry.S
index 000000000000..777777777777 100644
--- a/arch/arm64/kernel/entry.S
+++ b/arch/arm64/kernel/entry.S
@@ -739,9 +739,32 @@ el0_svc:
 	stp	x0, xscno, [sp, #S_ORIG_X0]	// save the original x0 and syscall number
 	enable_dbg_and_irq
 	ct_user_exit 1
+
+	/*
+	 * SukiSU Ultra userspace triggers its kernel supercall through
+	 * reboot(0xDEADBEEF, 0xCAFEBABE, ...).  On Android 13, app seccomp
+	 * can kill that syscall in syscall_trace_enter() before the reboot
+	 * kprobe sees it.  Skip the syscall-work path only for this exact
+	 * magic call so it can reach the sys_call_table entry and the kprobe.
+	 */
+	cmp	wscno, #142			// __NR_reboot on arm64
+	b.ne	1f
+	ldp	x16, x17, [sp]			// original x0/x1 syscall args
+	mov	x19, #0xbeef
+	movk	x19, #0xdead, lsl #16
+	cmp	x16, x19
+	b.ne	1f
+	mov	x19, #0xbabe
+	movk	x19, #0xcafe, lsl #16
+	cmp	x17, x19
+	b.ne	1f
+	b	2f
+
+1:
 	ldr	x16, [tsk, #TSK_TI_FLAGS]	// check for syscall hooks
 	tst	x16, #_TIF_SYSCALL_WORK
 	b.ne	__sys_trace
+2:
 	cmp     wscno, wsc_nr			// check upper syscall limit
 	b.hs	ni_sys
 	mask_nospec64 xscno, xsc_nr, x19	// enforce bounds for syscall number
-- 
2.43.0
