+static ssize_t boost_show(struct gov_attr_set *attr_set, char *buf)
+{
+	struct hygov_tunables *tunables = to_hygov_tunables(attr_set);
+
+	return sprintf(buf, "%u\n", tunables->boost ? 1 : 0);
+}
