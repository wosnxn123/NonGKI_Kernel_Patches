+static struct hygov_policy *hygov_policy_alloc(struct cpufreq_policy *policy)
+{
+	struct hygov_policy *sg_policy;
+
+	sg_policy = kzalloc(sizeof(*sg_policy), GFP_KERNEL);
+	if (!sg_policy)
+		return NULL;
+
+	sg_policy->policy = policy;
+	raw_spin_lock_init(&sg_policy->update_lock);
+	return sg_policy;
+}
+
+static void hygov_policy_free(struct hygov_policy *sg_policy)
+{
+	kfree(sg_policy);
+}
+
+static int hygov_kthread_create(struct hygov_policy *sg_policy)
+{
+	struct task_struct *thread;
+	struct sched_param param = { .sched_priority = MAX_USER_RT_PRIO / 2 };
+	struct cpufreq_policy *policy = sg_policy->policy;
+	int ret;
+
+	if (policy->fast_switch_enabled)
+		return 0;
+
+	kthread_init_work(&sg_policy->work, hygov_work);
+	kthread_init_worker(&sg_policy->worker);
+	thread = kthread_create(kthread_worker_fn, &sg_policy->worker,
+				"hygov:%d", cpumask_first(policy->related_cpus));
+	if (IS_ERR(thread))
+		return PTR_ERR(thread);
+
+	ret = sched_setscheduler_nocheck(thread, SCHED_FIFO, &param);
+	if (ret) {
+		kthread_stop(thread);
+		return ret;
+	}
+
+	sg_policy->thread = thread;
+	if (!policy->dvfs_possible_from_any_cpu)
+		kthread_bind_mask(thread, policy->related_cpus);
+	init_irq_work(&sg_policy->irq_work, hygov_irq_work);
+	mutex_init(&sg_policy->work_lock);
+	wake_up_process(thread);
+	return 0;
+}
+
+static void hygov_kthread_stop(struct hygov_policy *sg_policy)
+{
+	if (sg_policy->policy->fast_switch_enabled)
+		return;
+
+	kthread_flush_worker(&sg_policy->worker);
+	kthread_stop(sg_policy->thread);
+	mutex_destroy(&sg_policy->work_lock);
+}
+
+static struct hygov_tunables *hygov_tunables_alloc(struct hygov_policy *sg_policy)
+{
+	struct hygov_tunables *tunables;
+
+	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+	if (tunables) {
+		gov_attr_set_init(&tunables->attr_set, &sg_policy->tunables_hook);
+		hygov_apply_profile(tunables, HYDROGEN_DEF_PROFILE);
+		if (!have_governor_per_policy())
+			global_tunables = tunables;
+	}
+	return tunables;
+}
+
+static void hygov_clear_global_tunables(void)
+{
+	if (!have_governor_per_policy())
+		global_tunables = NULL;
+}
+
+static int hygov_init(struct cpufreq_policy *policy)
+{
+	struct hygov_policy *sg_policy;
+	struct hygov_tunables *tunables;
+	int ret = 0;
+
+	if (policy->governor_data)
+		return -EBUSY;
+
+	cpufreq_enable_fast_switch(policy);
+
+	sg_policy = hygov_policy_alloc(policy);
+	if (!sg_policy) {
+		ret = -ENOMEM;
+		goto disable_fast_switch;
+	}
+
+	ret = hygov_kthread_create(sg_policy);
+	if (ret)
+		goto free_sg_policy;
+
+	mutex_lock(&global_tunables_lock);
+	if (global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+		policy->governor_data = sg_policy;
+		sg_policy->tunables = global_tunables;
+		gov_attr_set_get(&global_tunables->attr_set,
+				 &sg_policy->tunables_hook);
+		goto out;
+	}
+
+	tunables = hygov_tunables_alloc(sg_policy);
+	if (!tunables) {
+		ret = -ENOMEM;
+		goto stop_kthread;
+	}
+
+	policy->governor_data = sg_policy;
+	sg_policy->tunables = tunables;
+	ret = kobject_init_and_add(&tunables->attr_set.kobj,
+				   &hygov_tunables_ktype,
+				   get_governor_parent_kobj(policy),
+				   "%s", hydrogen_gov.name);
+	if (ret)
+		goto fail;
+out:
+	mutex_unlock(&global_tunables_lock);
+	return 0;
+
+fail:
+	kobject_put(&tunables->attr_set.kobj);
+	policy->governor_data = NULL;
+	hygov_clear_global_tunables();
+stop_kthread:
+	hygov_kthread_stop(sg_policy);
+	mutex_unlock(&global_tunables_lock);
+free_sg_policy:
+	hygov_policy_free(sg_policy);
+disable_fast_switch:
+	cpufreq_disable_fast_switch(policy);
+	pr_err("initialization failed: %d\n", ret);
+	return ret;
+}
+
+static void hygov_exit(struct cpufreq_policy *policy)
+{
+	struct hygov_policy *sg_policy = policy->governor_data;
+	struct hygov_tunables *tunables = sg_policy->tunables;
+	unsigned int count;
+
+	mutex_lock(&global_tunables_lock);
+	count = gov_attr_set_put(&tunables->attr_set, &sg_policy->tunables_hook);
+	policy->governor_data = NULL;
+	if (!count)
+		hygov_clear_global_tunables();
+	mutex_unlock(&global_tunables_lock);
+
+	hygov_kthread_stop(sg_policy);
+	hygov_policy_free(sg_policy);
+	cpufreq_disable_fast_switch(policy);
+}
+
+static int hygov_start(struct cpufreq_policy *policy)
+{
+	struct hygov_policy *sg_policy = policy->governor_data;
+	unsigned int cpu;
+
+	hygov_update_policy_delays(sg_policy);
+	sg_policy->last_freq_update_time = 0;
+	sg_policy->floor_validate_time = 0;
+	sg_policy->spike_until_ns = 0;
+	sg_policy->frame_until_ns = 0;
+	sg_policy->sustain_until_ns = 0;
+	sg_policy->next_freq = UINT_MAX;
+	sg_policy->work_in_progress = false;
+	sg_policy->need_freq_update = false;
+	sg_policy->cached_raw_freq = 0;
+	sg_policy->last_util = 0;
+	sg_policy->last_max = 0;
+	sg_policy->last_active_cpus = 0;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct hygov_cpu *sg_cpu = &per_cpu(hygov_cpu, cpu);
+
+		memset(sg_cpu, 0, sizeof(*sg_cpu));
+		sg_cpu->cpu = cpu;
+		sg_cpu->sg_policy = sg_policy;
+		sg_cpu->flags = SCHED_CPUFREQ_DL;
+		sg_cpu->iowait_boost_max = capacity_orig_of(cpu);
+		sg_cpu->min_boost = max_t(unsigned long, HYDROGEN_MIN_IOWAIT,
+			(SCHED_CAPACITY_SCALE * policy->cpuinfo.min_freq) /
+			 max(policy->cpuinfo.max_freq, 1U));
+	}
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct hygov_cpu *sg_cpu = &per_cpu(hygov_cpu, cpu);
+
+		cpufreq_add_update_util_hook(cpu, &sg_cpu->update_util,
+				policy_is_shared(policy) ? hygov_update_shared :
+				hygov_update_single);
+	}
+
+	return 0;
+}
+
+static void hygov_stop(struct cpufreq_policy *policy)
+{
+	struct hygov_policy *sg_policy = policy->governor_data;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, policy->cpus)
+		cpufreq_remove_update_util_hook(cpu);
+
+	synchronize_sched();
+	if (!policy->fast_switch_enabled) {
+		irq_work_sync(&sg_policy->irq_work);
+		kthread_cancel_work_sync(&sg_policy->work);
+	}
+}
+
+static void hygov_limits(struct cpufreq_policy *policy)
+{
+	struct hygov_policy *sg_policy = policy->governor_data;
+
+	if (!policy->fast_switch_enabled) {
+		mutex_lock(&sg_policy->work_lock);
+		cpufreq_policy_apply_limits(policy);
+		mutex_unlock(&sg_policy->work_lock);
+	}
+
+	sg_policy->need_freq_update = true;
+}
