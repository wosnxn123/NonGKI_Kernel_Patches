+		tunables->soft_min_freq_percent = 0;
+		tunables->soft_max_freq_percent = 100;
+		break;
+	}
+
+	tunables->hispeed_freq = 0;
+	tunables->game_floor_freq = 0;
+	tunables->io_boost = 1;
+	tunables->rt_boost = 1;
+	tunables->busy_hold = 1;
+	if (!tunables->boostpulse_duration_ms)
+		tunables->boostpulse_duration_ms = 120;
+}
+
+static void hygov_mark_transient(struct hygov_policy *sg_policy, u64 time,
+					 unsigned long util, unsigned long max,
+					 unsigned int flags)
+{
+	struct hygov_tunables *tunables = sg_policy->tunables;
+	unsigned int load = hygov_pct(util, max);
+	unsigned int delta = 0;
+
+	if (sg_policy->last_max && max) {
+		unsigned int old_load = hygov_pct(sg_policy->last_util,
+						       sg_policy->last_max);
+		if (load > old_load)
+			delta = load - old_load;
+	}
+
+	if (flags & SCHED_CPUFREQ_IOWAIT)
+		sg_policy->spike_until_ns = max(sg_policy->spike_until_ns,
+			time + (u64)tunables->spike_hold_ms * NSEC_PER_MSEC);
+
+#ifdef SCHED_CPUFREQ_RT
+	if (flags & SCHED_CPUFREQ_RT)
+		sg_policy->frame_until_ns = max(sg_policy->frame_until_ns,
+			time + (u64)tunables->frame_guard_ms * NSEC_PER_MSEC);
+#endif
+	if (flags & SCHED_CPUFREQ_DL)
+		sg_policy->frame_until_ns = max(sg_policy->frame_until_ns,
+			time + (u64)tunables->frame_guard_ms * NSEC_PER_MSEC);
+
+	if (tunables->spike_boost_load && delta >= tunables->spike_boost_load)
+		sg_policy->spike_until_ns = max(sg_policy->spike_until_ns,
+			time + (u64)tunables->spike_hold_ms * NSEC_PER_MSEC);
+
+	if (tunables->frame_boost_load && load >= tunables->frame_boost_load)
+		sg_policy->frame_until_ns = max(sg_policy->frame_until_ns,
+			time + (u64)tunables->frame_guard_ms * NSEC_PER_MSEC);
+
+	if (tunables->sustain_load && load >= tunables->sustain_load)
+		sg_policy->sustain_until_ns = max(sg_policy->sustain_until_ns,
+			time + (u64)tunables->sustain_hold_ms * NSEC_PER_MSEC);
+
+	sg_policy->last_util = util;
+	sg_policy->last_max = max;
+}
+
+static bool hygov_should_update_freq(struct hygov_policy *sg_policy, u64 time)
+{
+	s64 delta_ns;
+	struct cpufreq_policy *policy = sg_policy->policy;
+
+	if (policy->governor != &hydrogen_gov || !policy->governor_data)
+		return false;
+
+	if (policy->fast_switch_enabled && !cpufreq_can_do_remote_dvfs(policy))
+		return false;
+
+	if (sg_policy->work_in_progress)
+		return false;
+
+	if (unlikely(sg_policy->need_freq_update)) {
+		sg_policy->need_freq_update = false;
+		sg_policy->next_freq = UINT_MAX;
+		return true;
+	}
+
+	if (hygov_fast_path_active(sg_policy, time))
+		return true;
+
+	delta_ns = time - sg_policy->last_freq_update_time;
+	return delta_ns >= sg_policy->min_rate_limit_ns;
+}
+
+static bool hygov_rate_limited(struct hygov_policy *sg_policy, u64 time,
+			       unsigned int next_freq)
+{
+	s64 delta_ns;
+	struct hygov_tunables *tunables = sg_policy->tunables;
+
+	if (sg_policy->next_freq == UINT_MAX)
+		return false;
+
+	delta_ns = time - sg_policy->last_freq_update_time;
+
+	if (next_freq > sg_policy->next_freq) {
+		if (hygov_fast_path_active(sg_policy, time))
+			return false;
+		return delta_ns < sg_policy->up_rate_delay_ns;
+	}
+
+	if (next_freq < sg_policy->next_freq) {
+		if (delta_ns < sg_policy->down_rate_delay_ns)
+			return true;
+		if (time < sg_policy->frame_until_ns)
+			return true;
+		if (time - sg_policy->floor_validate_time <
+		    tunables->min_sample_time_us * NSEC_PER_USEC)
+			return true;
+	}
+
+	return false;
+}
+
+static void hygov_update_commit(struct hygov_policy *sg_policy, u64 time,
+				unsigned int next_freq)
+{
+	struct cpufreq_policy *policy = sg_policy->policy;
+
+	if (sg_policy->next_freq == next_freq)
+		return;
+
+	if (hygov_rate_limited(sg_policy, time, next_freq))
+		return;
+
+	if (sg_policy->next_freq == UINT_MAX || next_freq >= sg_policy->next_freq)
+		sg_policy->floor_validate_time = time;
+
+	sg_policy->next_freq = next_freq;
+	sg_policy->last_freq_update_time = time;
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	mt_cpufreq_set_by_wfi_load_cluster(arch_get_cluster_id(policy->cpu),
+					  next_freq);
+	policy->cur = next_freq;
+#else
+	if (policy->fast_switch_enabled) {
+		next_freq = cpufreq_driver_fast_switch(policy, next_freq);
+		if (!next_freq)
+			return;
+		policy->cur = next_freq;
+	} else {
+		sg_policy->work_in_progress = true;
+		irq_work_queue(&sg_policy->irq_work);
+	}
+#endif
+}
+
+static unsigned int hygov_percent_freq(struct cpufreq_policy *policy,
+					       unsigned int pct)
+{
+	unsigned int span;
+
+	pct = min(pct, 100U);
+	span = policy->cpuinfo.max_freq - policy->cpuinfo.min_freq;
+	return policy->cpuinfo.min_freq + div_u64((u64)span * pct, 100);
+}
+
+static unsigned int hygov_auto_hispeed_freq(struct cpufreq_policy *policy)
+{
+	return hygov_percent_freq(policy, 68);
+}
+
+static unsigned int hygov_auto_game_floor_freq(struct cpufreq_policy *policy,
+					       struct hygov_tunables *tunables)
+{
+	return hygov_percent_freq(policy, tunables->game_floor_percent);
+}
+
+static unsigned int hygov_apply_steps(struct hygov_policy *sg_policy,
+				      unsigned int freq)
+{
+	struct cpufreq_policy *policy = sg_policy->policy;
+	struct hygov_tunables *tunables = sg_policy->tunables;
+	unsigned int span = policy->max - policy->min;
+	unsigned int max_step;
+
+	if (sg_policy->next_freq == UINT_MAX || !span)
+		return freq;
+
+	if (freq > sg_policy->next_freq && tunables->up_step_percent < 100) {
+		max_step = max_t(unsigned int, 1,
+			div_u64((u64)span * tunables->up_step_percent, 100));
+		if (freq > sg_policy->next_freq + max_step)
+			freq = sg_policy->next_freq + max_step;
+	} else if (freq < sg_policy->next_freq && tunables->down_step_percent < 100) {
+		max_step = max_t(unsigned int, 1,
+			div_u64((u64)span * tunables->down_step_percent, 100));
+		if (sg_policy->next_freq > freq + max_step)
+			freq = sg_policy->next_freq - max_step;
+	}
+
+	return freq;
+}
+
+static unsigned int hygov_resolve_freq(struct hygov_policy *sg_policy,
+				       unsigned long util, unsigned long max,
+				       unsigned int flags, u64 time)
+{
+	struct cpufreq_policy *policy = sg_policy->policy;
+	struct hygov_tunables *tunables = sg_policy->tunables;
+	unsigned int base_freq, freq, load, hispeed_freq, floor_freq;
+	bool forced, transient, touch_active, sustained;
+
+	if (!max)
+		max = 1;
+
+	util = min(util, max);
+	load = hygov_pct(util, max);
+	forced = hygov_boost_active_time(tunables, time);
+	transient = hygov_transient_active(sg_policy, time);
+	touch_active = time < tunables->touch_until_ns;
+	sustained = time < sg_policy->sustain_until_ns;
+
+	if (tunables->powersave_bias && !forced && !transient &&
+	    load < tunables->hispeed_load)
+		util = div_u64((u64)util *
+			(1000 - min(tunables->powersave_bias, 900U)), 1000);
+
+	if (tunables->boost_util && !idle_cpu(policy->cpu))
+		util = max_t(unsigned long, util,
+			div_u64((u64)max * tunables->boost_util,
+				HYDROGEN_CAPACITY));
+
+	if (transient)
+		util = max_t(unsigned long, util,
+			div_u64((u64)max * tunables->spike_boost_util,
+				HYDROGEN_CAPACITY));
+
+	if (touch_active && tunables->touch_boost_util)
+		util = max_t(unsigned long, util,
+			div_u64((u64)max * tunables->touch_boost_util,
+				HYDROGEN_CAPACITY));
+
+	if (sustained && tunables->sustain_boost_util)
+		util = max_t(unsigned long, util,
+			div_u64((u64)max * tunables->sustain_boost_util,
+				HYDROGEN_CAPACITY));
+
+	if (sg_policy->last_active_cpus >= tunables->multi_cpu_boost_cpus &&
+	    tunables->multi_cpu_boost_cpus && tunables->multi_cpu_boost_util)
+		util = max_t(unsigned long, util,
+			div_u64((u64)max * tunables->multi_cpu_boost_util,
+				HYDROGEN_CAPACITY));
+
+	if (time < sg_policy->frame_until_ns && tunables->frame_boost_util)
+		util = max_t(unsigned long, util,
+			div_u64((u64)max * tunables->frame_boost_util,
+				HYDROGEN_CAPACITY));
+
+	if (forced)
+		util = max;
+
+#ifdef SCHED_CPUFREQ_RT
+	if (tunables->rt_boost && (flags & SCHED_CPUFREQ_RT))
+		util = max;
+#endif
+	if (tunables->rt_boost && (flags & SCHED_CPUFREQ_DL))
+		util = max;
+
+	base_freq = arch_scale_freq_invariant() ? policy->cpuinfo.max_freq :
+		max(policy->cur, policy->min);
+	if (!base_freq)
+		base_freq = policy->cpuinfo.max_freq;
+
+	freq = div_u64((u64)base_freq * util, max);
+	freq = div_u64((u64)freq * 100, max(tunables->target_load, 1U));
+	freq = div_u64((u64)freq * tunables->capacity_margin,
+			HYDROGEN_CAPACITY);
+
+	hispeed_freq = tunables->hispeed_freq ? tunables->hispeed_freq :
+		hygov_auto_hispeed_freq(policy);
+	if (load >= tunables->hispeed_load && freq < hispeed_freq)
+		freq = hispeed_freq;
+
+	floor_freq = tunables->game_floor_freq ? tunables->game_floor_freq :
+		hygov_auto_game_floor_freq(policy, tunables);
+	if (tunables->game_floor_load && load >= tunables->game_floor_load &&
+	    freq < floor_freq)
+		freq = floor_freq;
+
+	if (tunables->heavy_load && load >= tunables->heavy_load)
+		freq = max(freq, hygov_percent_freq(policy,
+			tunables->heavy_floor_percent));
+
+	if (sg_policy->last_active_cpus >= tunables->multi_cpu_boost_cpus &&
+	    tunables->multi_cpu_boost_cpus)
+		freq = max(freq, hygov_percent_freq(policy,
+			tunables->multi_cpu_floor_percent));
+
+	if (tunables->soft_min_freq_percent)
+		freq = max(freq, hygov_percent_freq(policy,
+			tunables->soft_min_freq_percent));
+
+	if (!forced && !transient && !touch_active &&
+	    tunables->soft_max_freq_percent &&
+	    tunables->soft_max_freq_percent < 100)
+		freq = min(freq, hygov_percent_freq(policy,
+			tunables->soft_max_freq_percent));
+
+	if (!forced && !transient && !touch_active &&
+	    sg_policy->next_freq != UINT_MAX && freq < sg_policy->next_freq &&
+	    tunables->down_differential &&
+	    load + tunables->down_differential >= tunables->target_load)
+		freq = sg_policy->next_freq;
+
+	if (!forced && !transient && tunables->power_ceiling_load &&
+	    load < tunables->power_ceiling_load) {
+		unsigned int ceiling = hygov_percent_freq(policy,
+			tunables->power_ceiling_percent);
+		freq = min(freq, ceiling);
+	}
+
+	if (!forced && !transient && tunables->low_load_saver_load &&
+	    load < tunables->low_load_saver_load)
+		freq = div_u64((u64)freq *
+			min(tunables->low_load_saver_percent, 100U), 100);
+
+	freq = hygov_apply_steps(sg_policy, freq);
+	freq = clamp_t(unsigned int, freq, policy->min, policy->max);
+	sg_policy->cached_raw_freq = freq;
+
+#ifdef CONFIG_MTK_TINYSYS_SSPM_SUPPORT
+	return mt_cpufreq_find_close_freq(arch_get_cluster_id(policy->cpu), freq);
+#else
+	return cpufreq_driver_resolve_freq(policy, freq);
+#endif
+}
+
+static void hygov_get_util(unsigned long *util, unsigned long *max, int cpu)
+{
+	unsigned long max_cap = arch_scale_cpu_capacity(NULL, cpu);
+
+	*util = boosted_cpu_util(cpu);
+	if (idle_cpu(cpu))
+		*util = 0;
+	*util = min(*util, max_cap);
+	*max = max_cap;
+}
+
+static void hygov_set_iowait_boost(struct hygov_cpu *sg_cpu, u64 time,
+				   unsigned int flags)
+{
+	unsigned int max_boost;
+	struct hygov_tunables *tunables = sg_cpu->sg_policy->tunables;
+
+	if (!tunables->io_boost)
+		return;
+
+	if (flags & SCHED_CPUFREQ_IOWAIT) {
+		if (sg_cpu->iowait_boost_pending)
+			return;
+
+		sg_cpu->iowait_boost_pending = true;
+		max_boost = uclamp_util(cpu_rq(sg_cpu->cpu), sg_cpu->iowait_boost_max);
+
+		if (sg_cpu->iowait_boost) {
+			sg_cpu->iowait_boost <<= 1;
+			if (sg_cpu->iowait_boost > max_boost)
+				sg_cpu->iowait_boost = max_boost;
+		} else {
+			sg_cpu->iowait_boost = sg_cpu->min_boost;
+		}
+	} else if (sg_cpu->iowait_boost) {
+		s64 delta_ns = time - sg_cpu->last_update;
+
+		if (delta_ns > TICK_NSEC) {
+			sg_cpu->iowait_boost = 0;
+			sg_cpu->iowait_boost_pending = false;
+		}
+	}
+}
+
+static void hygov_iowait_apply(struct hygov_cpu *sg_cpu,
+			       unsigned long *util, unsigned long *max)
+{
+	unsigned int boost_util, boost_max;
+
+	if (!sg_cpu->sg_policy->tunables->io_boost || !sg_cpu->iowait_boost)
+		return;
+
+	if (sg_cpu->iowait_boost_pending) {
+		sg_cpu->iowait_boost_pending = false;
+	} else {
+		sg_cpu->iowait_boost >>= 1;
+		if (sg_cpu->iowait_boost < sg_cpu->min_boost) {
+			sg_cpu->iowait_boost = 0;
+			return;
+		}
+	}
+
+	boost_util = sg_cpu->iowait_boost;
+	boost_max = sg_cpu->iowait_boost_max;
+	if (*util * boost_max < *max * boost_util) {
+		*util = boost_util;
+		*max = boost_max;
+	}
+}
+
+#ifdef CONFIG_NO_HZ_COMMON
+static bool hygov_cpu_is_busy(struct hygov_cpu *sg_cpu)
+{
+	unsigned long idle_calls = tick_nohz_get_idle_calls_cpu(sg_cpu->cpu);
+	bool busy = idle_calls == sg_cpu->saved_idle_calls;
+
+	sg_cpu->saved_idle_calls = idle_calls;
+	return busy;
+}
+#else
+static inline bool hygov_cpu_is_busy(struct hygov_cpu *sg_cpu)
+{
+	return false;
+}
+#endif
+
+static void hygov_update_single(struct update_util_data *hook, u64 time,
+				unsigned int flags)
+{
+	struct hygov_cpu *sg_cpu = container_of(hook, struct hygov_cpu,
+					      update_util);
+	struct hygov_policy *sg_policy = sg_cpu->sg_policy;
+	unsigned long util, max;
+	unsigned int next_f;
+	bool busy;
+
+	hygov_set_iowait_boost(sg_cpu, time, flags);
+	sg_cpu->last_update = time;
+
+	hygov_get_util(&util, &max, sg_cpu->cpu);
+	util = uclamp_util(cpu_rq(sg_cpu->cpu), util);
+	hygov_iowait_apply(sg_cpu, &util, &max);
+	hygov_mark_transient(sg_policy, time, util, max, flags);
+	sg_policy->last_active_cpus =
+		(sg_policy->tunables->active_cpu_load &&
+		 hygov_pct(util, max) >= sg_policy->tunables->active_cpu_load) ? 1 : 0;
+
+	if (!hygov_should_update_freq(sg_policy, time))
+		return;
+
+	busy = hygov_cpu_is_busy(sg_cpu);
+	next_f = hygov_resolve_freq(sg_policy, util, max, flags, time);
+
+	if (sg_policy->tunables->busy_hold && busy &&
+	    next_f < sg_policy->next_freq && sg_policy->next_freq != UINT_MAX) {
+		next_f = sg_policy->next_freq;
+		sg_policy->cached_raw_freq = 0;
+	}
+
+	hygov_update_commit(sg_policy, time, next_f);
+}
+
+static unsigned int hygov_next_freq_shared(struct hygov_cpu *sg_cpu, u64 time)
+{
+	struct hygov_policy *sg_policy = sg_cpu->sg_policy;
+	struct cpufreq_policy *policy = sg_policy->policy;
+	unsigned long util = 0, max = 1;
+	unsigned int flags = 0;
+	unsigned int active_cpus = 0;
+	unsigned int j;
+
+	for_each_cpu(j, policy->cpus) {
+		struct hygov_cpu *j_sg_cpu = &per_cpu(hygov_cpu, j);
+		unsigned long j_util, j_max;
+		s64 delta_ns = time - j_sg_cpu->last_update;
+
+		if (delta_ns > TICK_NSEC) {
+			j_sg_cpu->iowait_boost = 0;
+			j_sg_cpu->iowait_boost_pending = false;
+			if (idle_cpu(j))
+				continue;
+		}
+
+		j_util = uclamp_util(cpu_rq(j), j_sg_cpu->util);
+		j_max = j_sg_cpu->max;
+		flags |= j_sg_cpu->flags;
+
+		hygov_iowait_apply(j_sg_cpu, &j_util, &j_max);
+		if (sg_policy->tunables->active_cpu_load &&
+		    hygov_pct(j_util, j_max) >= sg_policy->tunables->active_cpu_load)
+			active_cpus++;
+
+		if (j_util * max > j_max * util) {
+			util = j_util;
+			max = j_max;
+		}
+	}
+
+	sg_policy->last_active_cpus = active_cpus;
+	hygov_mark_transient(sg_policy, time, util, max, flags);
+	return hygov_resolve_freq(sg_policy, util, max, flags, time);
+}
+
+static void hygov_update_shared(struct update_util_data *hook, u64 time,
+				unsigned int flags)
+{
+	struct hygov_cpu *sg_cpu = container_of(hook, struct hygov_cpu,
+					      update_util);
+	struct hygov_policy *sg_policy = sg_cpu->sg_policy;
+	unsigned long util, max;
+	unsigned int next_f;
+
+	hygov_get_util(&util, &max, sg_cpu->cpu);
+
+	raw_spin_lock(&sg_policy->update_lock);
+	sg_cpu->util = util;
+	sg_cpu->max = max;
+	sg_cpu->flags = flags;
+	hygov_set_iowait_boost(sg_cpu, time, flags);
+	hygov_iowait_apply(sg_cpu, &util, &max);
+	hygov_mark_transient(sg_policy, time, util, max, flags);
+	sg_cpu->last_update = time;
+
+	if (hygov_should_update_freq(sg_policy, time)) {
+		next_f = hygov_next_freq_shared(sg_cpu, time);
+		hygov_update_commit(sg_policy, time, next_f);
+	}
+	raw_spin_unlock(&sg_policy->update_lock);
+}
+
+static void hygov_work(struct kthread_work *work)
+{
+	struct hygov_policy *sg_policy = container_of(work, struct hygov_policy,
+					       work);
+
+	mutex_lock(&sg_policy->work_lock);
+	__cpufreq_driver_target(sg_policy->policy, sg_policy->next_freq,
+			      CPUFREQ_RELATION_L);
+	mutex_unlock(&sg_policy->work_lock);
+	sg_policy->work_in_progress = false;
+}
+
+static void hygov_irq_work(struct irq_work *irq_work)
+{
+	struct hygov_policy *sg_policy = container_of(irq_work,
+					       struct hygov_policy, irq_work);
+
+	kthread_queue_work(&sg_policy->worker, &sg_policy->work);
+}
