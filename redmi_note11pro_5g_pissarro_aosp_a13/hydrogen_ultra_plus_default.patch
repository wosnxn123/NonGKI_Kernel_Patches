+static ssize_t profile_store(struct gov_attr_set *attr_set,
+			     const char *buf, size_t count)
+{
+	struct hygov_tunables *tunables = to_hygov_tunables(attr_set);
+	struct hygov_policy *sg_policy;
+	unsigned int val;
+
+	if (kstrtouint(buf, 10, &val))
+		return -EINVAL;
+	if (val > HYDROGEN_PROFILE_BENCH)
+		return -EINVAL;
+
+	hygov_apply_profile(tunables, val);
+	list_for_each_entry(sg_policy, &attr_set->policy_list, tunables_hook)
+		hygov_update_policy_delays(sg_policy);
+	hygov_force_update(tunables);
+	return count;
+}
