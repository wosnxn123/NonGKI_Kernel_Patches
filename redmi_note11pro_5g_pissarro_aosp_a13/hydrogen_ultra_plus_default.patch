diff -ruaN a/kernel/sched/cpufreq_hydrogen.c b/kernel/sched/cpufreq_hydrogen.c
--- a/kernel/sched/cpufreq_hydrogen.c	1970-01-01 00:00:00.000000000 +0000
+++ b/kernel/sched/cpufreq_hydrogen.c	2026-04-25 04:20:21.610329916 +0000
@@ -0,0 +1,1583 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Hydrogen Ultra CPUFreq governor for Android/MTK kernels.
+ *
+ * Design goals:
+ * - scheduler-linked like schedutil, not a timer-only sampling governor;
+ * - react fast to frame/game bursts, IO wakeups and RT/DL work;
+ * - avoid wasteful max-frequency residency when utilization is not high;
+ * - expose simple profiles for Scene/PowerHAL/user scripts.
+ *
+ * Hydrogen Ultra Plus adds manual touch boost, sustained-load hold,
+ * multi-active-CPU floor, heavy-load floor, soft min/max clamps and a
+ * benchmark profile. These are original policy layers on top of the
+ * scheduler-linked DVFS path, intended for smoother Android gaming without
+ * simply pinning every cluster at max frequency.
+ *
+ * This file is written for the cpufreq/scheduler framework already used by
+ * this kernel tree. It intentionally does not copy third-party kernel code.
+ */
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/cpufreq.h>
+#include <linux/irq_work.h>
+#include <linux/kernel.h>
+#include <linux/kthread.h>
+#include <linux/ktime.h>
+#include <linux/limits.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/sched/cpufreq.h>
+#include <linux/sched/rt.h>
+#include <linux/slab.h>
+#include <linux/tick.h>
+
+#include "sched.h"
+#include "tune.h"
+#include "cpufreq_schedutil.h"
+
+#define HYDROGEN_NAME                    "hydrogen"
+#define HYDROGEN_CAPACITY                SCHED_CAPACITY_SCALE
+#define HYDROGEN_MIN_IOWAIT              (SCHED_CAPACITY_SCALE / 8)
+
+#define HYDROGEN_PROFILE_SAVE            0
+#define HYDROGEN_PROFILE_DAILY           1
+#define HYDROGEN_PROFILE_BALANCE         2
+#define HYDROGEN_PROFILE_GAME            3
+#define HYDROGEN_PROFILE_ESPORTS         4
+#define HYDROGEN_PROFILE_BENCH           5
+
+#define HYDROGEN_DEF_PROFILE             HYDROGEN_PROFILE_GAME
+
+struct hygov_tunables {
+	struct gov_attr_set attr_set;
+
+	/* Main mode and schedutil-style rate limiting. */
+	unsigned int profile;
+	unsigned int up_rate_limit_us;
+	unsigned int down_rate_limit_us;
+	unsigned int min_sample_time_us;
+
+	/* Frequency mapping. */
+	unsigned int target_load;
+	unsigned int capacity_margin;
+	unsigned int hispeed_load;
+	unsigned int hispeed_freq;
+	unsigned int down_differential;
+
+	/* Game/frame stability. */
+	unsigned int touch_boost_util;
+	unsigned int touch_boost_duration_ms;
+	u64 touch_until_ns;
+	unsigned int frame_boost_load;
+	unsigned int frame_boost_util;
+	unsigned int frame_guard_ms;
+	unsigned int game_floor_load;
+	unsigned int game_floor_freq;
+	unsigned int game_floor_percent;
+
+	/* Short burst and sustained-load detection. */
+	unsigned int spike_boost_load;
+	unsigned int spike_boost_util;
+	unsigned int spike_hold_ms;
+	unsigned int sustain_load;
+	unsigned int sustain_boost_util;
+	unsigned int sustain_hold_ms;
+	unsigned int heavy_load;
+	unsigned int heavy_floor_percent;
+	unsigned int active_cpu_load;
+	unsigned int multi_cpu_boost_cpus;
+	unsigned int multi_cpu_boost_util;
+	unsigned int multi_cpu_floor_percent;
+
+	/* Energy control. */
+	unsigned int powersave_bias;
+	unsigned int low_load_saver_load;
+	unsigned int low_load_saver_percent;
+	unsigned int power_ceiling_load;
+	unsigned int power_ceiling_percent;
+	unsigned int up_step_percent;
+	unsigned int down_step_percent;
+	unsigned int soft_min_freq_percent;
+	unsigned int soft_max_freq_percent;
+
+	/* Scheduler/input-like boosts. */
+	unsigned int io_boost;
+	unsigned int rt_boost;
+	unsigned int busy_hold;
+	unsigned int boost_util;
+	unsigned int boostpulse_duration_ms;
+	bool boost;
+	u64 boost_until_ns;
+};
+
+struct hygov_policy {
+	struct cpufreq_policy *policy;
+	struct hygov_tunables *tunables;
+	struct list_head tunables_hook;
+
+	raw_spinlock_t update_lock;
+	u64 last_freq_update_time;
+	u64 floor_validate_time;
+	u64 spike_until_ns;
+	u64 frame_until_ns;
+	u64 sustain_until_ns;
+	s64 min_rate_limit_ns;
+	s64 up_rate_delay_ns;
+	s64 down_rate_delay_ns;
+	unsigned int next_freq;
+	unsigned int cached_raw_freq;
+	unsigned long last_util;
+	unsigned long last_max;
+	unsigned int last_active_cpus;
+
+	struct irq_work irq_work;
+	struct kthread_work work;
+	struct mutex work_lock;
+	struct kthread_worker worker;
+	struct task_struct *thread;
+	bool work_in_progress;
+	bool need_freq_update;
+};
+
+struct hygov_cpu {
+	struct update_util_data update_util;
+	struct hygov_policy *sg_policy;
+	unsigned int cpu;
+
+	bool iowait_boost_pending;
+	unsigned int iowait_boost;
+	unsigned int iowait_boost_max;
+	unsigned long min_boost;
+	u64 last_update;
+
+	unsigned long util;
+	unsigned long max;
+	unsigned int flags;
+
+#ifdef CONFIG_NO_HZ_COMMON
+	unsigned long saved_idle_calls;
+#endif
+};
+
+static struct cpufreq_governor hydrogen_gov;
+static DEFINE_PER_CPU(struct hygov_cpu, hygov_cpu);
+static struct hygov_tunables *global_tunables;
+static DEFINE_MUTEX(global_tunables_lock);
+static DEFINE_MUTEX(min_rate_lock);
+
+unsigned long boosted_cpu_util(int cpu);
+
+static inline struct hygov_tunables *to_hygov_tunables(struct gov_attr_set *attr_set)
+{
+	return container_of(attr_set, struct hygov_tunables, attr_set);
+}
+
+static unsigned int hygov_pct(unsigned long util, unsigned long max)
+{
+	if (!max)
+		return 0;
+	return min_t(unsigned int, div_u64((u64)util * 100, max), 100U);
+}
+
+static bool hygov_boost_active_time(struct hygov_tunables *tunables, u64 time)
+{
+	return tunables->boost || time < tunables->boost_until_ns;
+}
+
+static bool hygov_transient_active(struct hygov_policy *sg_policy, u64 time)
+{
+	return time < sg_policy->spike_until_ns || time < sg_policy->frame_until_ns;
+}
+
+static bool hygov_fast_path_active(struct hygov_policy *sg_policy, u64 time)
+{
+	return hygov_boost_active_time(sg_policy->tunables, time) ||
+	       time < sg_policy->tunables->touch_until_ns ||
+	       hygov_transient_active(sg_policy, time);
+}
+
+static void hygov_force_update(struct hygov_tunables *tunables)
+{
+	struct hygov_policy *sg_policy;
+
+	list_for_each_entry(sg_policy, &tunables->attr_set.policy_list,
+			    tunables_hook) {
+		sg_policy->need_freq_update = true;
+		sg_policy->cached_raw_freq = 0;
+	}
+}
+
+static void hygov_update_min_rate_limit_ns(struct hygov_policy *sg_policy)
+{
+	mutex_lock(&min_rate_lock);
+	sg_policy->min_rate_limit_ns = min(sg_policy->up_rate_delay_ns,
+					   sg_policy->down_rate_delay_ns);
+	mutex_unlock(&min_rate_lock);
+}
+
+static void hygov_update_policy_delays(struct hygov_policy *sg_policy)
+{
+	struct hygov_tunables *tunables = sg_policy->tunables;
+
+	sg_policy->up_rate_delay_ns = tunables->up_rate_limit_us * NSEC_PER_USEC;
+	sg_policy->down_rate_delay_ns = tunables->down_rate_limit_us * NSEC_PER_USEC;
+	hygov_update_min_rate_limit_ns(sg_policy);
+	sg_policy->need_freq_update = true;
+}
