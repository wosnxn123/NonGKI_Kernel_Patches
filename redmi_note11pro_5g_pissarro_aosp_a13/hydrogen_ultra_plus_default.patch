+#define store_uint(file_name, object, minval, maxval, update_delays) \
+static ssize_t file_name##_store(struct gov_attr_set *attr_set, \
+				 const char *buf, size_t count) \
+{ \
+	struct hygov_tunables *tunables = to_hygov_tunables(attr_set); \
+	struct hygov_policy *sg_policy; \
+	unsigned int val; \
+	if (kstrtouint(buf, 10, &val)) \
+		return -EINVAL; \
+	val = clamp_t(unsigned int, val, (unsigned int)(minval), \
+			(unsigned int)(maxval)); \
+	tunables->object = val; \
+	list_for_each_entry(sg_policy, &attr_set->policy_list, tunables_hook) { \
+		if (update_delays) \
+			hygov_update_policy_delays(sg_policy); \
+		else \
+			sg_policy->need_freq_update = true; \
+	} \
+	return count; \
+}
