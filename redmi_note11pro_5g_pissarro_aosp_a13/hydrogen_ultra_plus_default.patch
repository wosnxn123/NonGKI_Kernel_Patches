+static ssize_t boostpulse_store(struct gov_attr_set *attr_set,
+				const char *buf, size_t count)
+{
+	struct hygov_tunables *tunables = to_hygov_tunables(attr_set);
+	unsigned int val;
+
+	if (kstrtouint(buf, 10, &val))
+		return -EINVAL;
+	if (!val)
+		return count;
+
+	tunables->boost_until_ns = ktime_get_ns() +
+		(u64)tunables->boostpulse_duration_ms * NSEC_PER_MSEC;
+	hygov_force_update(tunables);
+	return count;
